---
import { SITE_TITLE, SITE_DESCRIPTION, SOCIAL } from "../consts"

// Above-the-fold fonts, preloaded to shrink the font-swap window (CLS).
// ?url resolves to the same hashed asset the @fontsource CSS references.
import montserratBlack from "@fontsource/montserrat/files/montserrat-latin-900-normal.woff2?url"
import merriweatherRegular from "@fontsource/merriweather/files/merriweather-latin-400-normal.woff2?url"

// Ported from the old react-helmet Seo component (src/components/seo.js).
// `title` omitted/null → homepage variant. `ogType: "article"` adds the
// article:* tags. `jsonLd` is rendered as a JSON-LD structured-data block.
const {
  title = null,
  description = "",
  ogType = "website",
  publishedTime = null,
  tags = [],
  noindex = false,
  jsonLd = null,
} = Astro.props

const metaDescription = description || SITE_DESCRIPTION
const fullTitle = title
  ? `${title} | ${SITE_TITLE}`
  : `${SITE_TITLE} — ${SITE_DESCRIPTION}`
const ogTitle = title || SITE_TITLE

// Self-referencing canonical. The pathname already includes the base path
// ("/blog/..."), so build it from the site ORIGIN to avoid doubling the prefix.
const origin = new URL(import.meta.env.SITE).origin
// Pages are served as directories (/blog/, /blog/<slug>/) — keep the
// trailing slash in the canonical so it matches the served URL + sitemap.
const pathname = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`
const canonical = `${origin}${pathname}`

// Literal: the /blog prefix comes from src/pages/blog/, not Astro's `base`.
const base = "/blog"
const ogImage = `${origin}${base}/og-image.png`

// Microsoft Clarity project id, set per-environment in Cloudflare Pages build
// env vars. PUBLIC_ because the value is inlined into the served HTML anyway.
// Unset (local dev, CI) → the tag is omitted entirely. The snippet is built
// here and injected via set:html — a <script> nested inside a template
// expression can't hold braces (they parse as expressions). The tag itself is
// injected on idle so it stays out of the initial load waterfall; the queue
// stub buffers clarity() calls until then.
// trim(): a stray space pasted into the build env var otherwise 400s the tag URL
const PUBLIC_CLARITY_PROJECT_ID =
  import.meta.env.PUBLIC_CLARITY_PROJECT_ID?.trim()
const claritySnippet = PUBLIC_CLARITY_PROJECT_ID
  ? `(function () {
  window.clarity =
    window.clarity ||
    function () {
      (window.clarity.q = window.clarity.q || []).push(arguments);
    };
  var loadClarity = function () {
    var s = document.createElement("script");
    s.async = true;
    s.src = "https://www.clarity.ms/tag/" + ${JSON.stringify(PUBLIC_CLARITY_PROJECT_ID)};
    document.head.appendChild(s);
  };
  if ("requestIdleCallback" in window) {
    requestIdleCallback(loadClarity, {timeout: 3000});
  } else {
    setTimeout(loadClarity, 2000);
  }
})();`
  : null
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
{noindex && <meta name="robots" content="noindex" />}
<link rel="canonical" href={canonical} />
{
  /* Agent discovery, same relations the portfolio layout emits (see
    ../../layouts/Layout.astro): the site's OpenAPI description and the
    developer portal that documents it. Absolute because the blog is served
    under a base path. */
}
<link
  rel="service-desc"
  type="application/json"
  href="https://murugappan.dev/openapi.json"
  title="murugappan.dev API — OpenAPI 3.1.0"
/>
<link
  rel="service-doc"
  type="text/html"
  href="https://murugappan.dev/developers/"
/>
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="mask-icon" href="/safari-pinned-tab.svg" color="#885bd5" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.json" />
<meta name="theme-color" content="#057b01" />
<meta name="description" content={metaDescription} />
<link
  rel="preload"
  as="font"
  type="font/woff2"
  crossorigin
  href={montserratBlack}
/>
<link
  rel="preload"
  as="font"
  type="font/woff2"
  crossorigin
  href={merriweatherRegular}
/>
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={SITE_TITLE} />
{
  ogType === "article" && publishedTime && (
    <meta
      property="article:published_time"
      content={publishedTime.toISOString()}
    />
  )
}
{
  ogType === "article" &&
    tags.map((tag: string) => <meta property="article:tag" content={tag} />)
}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:creator" content={SOCIAL.twitter} />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={ogImage} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE_TITLE} RSS Feed`}
  href={`${base}/rss.xml`}
/>
{
  jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )
}
{claritySnippet && <script is:inline set:html={claritySnippet} />}

<script>
  // Shared WebMCP tool registration from the portfolio app (same cross-app
  // import pattern as the chat widget).
  import "../../lib/webmcp"
</script>
