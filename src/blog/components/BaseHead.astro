---
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL, SOCIAL } from "../consts";
import { SITE_ORIGIN } from "../../lib/site";

// Declared inline and preloaded so the face is usually in hand by first paint.
import { FIRA_CODE_FACE, FIRA_CODE_URL } from "../../lib/fonts";

export interface Props {
  // Omitted for the blog index, which gets the homepage title.
  title?: string;
  description?: string;
  // "article" adds the article:* tags.
  ogType?: "website" | "article";
  publishedTime?: Date;
  tags?: string[];
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  ogType = "website",
  publishedTime,
  tags = [],
  noindex = false,
  jsonLd
} = Astro.props;

const metaDescription = description || SITE_DESCRIPTION;
const fullTitle = title ? `${title} | ${SITE_TITLE}` : `${SITE_TITLE} — ${SITE_DESCRIPTION}`;
const ogTitle = title || SITE_TITLE;

// Trailing slash to match the served directory URL and the sitemap.
const pathname = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = `${SITE_ORIGIN}${pathname}`;
const ogImage = `${SITE_URL}/og-image.png`;

// See ../../layouts/Layout.astro for why PostHog config goes through meta tags.
const POST_HOG_TOKEN = import.meta.env.POST_HOG_TOKEN?.trim();
const POST_HOG_URL = import.meta.env.POST_HOG_URL?.trim();
const analyticsEnabled = !!POST_HOG_TOKEN && !!POST_HOG_URL;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
{noindex && <meta name="robots" content="noindex" />}
<link rel="canonical" href={canonical} />
{/* Agent discovery, as in ../../layouts/Layout.astro. */}
<link
  rel="service-desc"
  type="application/json"
  href={`${SITE_ORIGIN}/openapi.json`}
  title="murugappan.dev API — OpenAPI 3.1.0"
/>
<link rel="service-doc" type="text/html" href={`${SITE_ORIGIN}/developers/`} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.json" />
<meta name="theme-color" content="#06038d" />
<meta name="description" content={metaDescription} />
<link rel="preload" as="font" type="font/woff2" crossorigin href={FIRA_CODE_URL} />
<style is:inline set:html={FIRA_CODE_FACE}></style>
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={SITE_TITLE} />
{ogType === "article" && publishedTime && (
  <meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{ogType === "article" && tags.map(tag => <meta property="article:tag" content={tag} />)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:creator" content={SOCIAL.twitter} />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={ogImage} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE_TITLE} RSS Feed`}
  href="/blog/rss.xml"
/>
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
{analyticsEnabled && (
  <>
    <meta name="ph-token" content={POST_HOG_TOKEN} />
    <meta name="ph-host" content={POST_HOG_URL} />
  </>
)}

<script>
  import "../../lib/webmcp";
  import { bootAnalytics, initClickTracking, tag } from "../../lib/analytics";
  import { currentTheme, documentThemeSource, setTheme, syncThemeOnRestore } from "../../lib/theme";

  // Must run first: tags or events sent before boot are dropped, not buffered.
  bootAnalytics();

  // The theme is a super property, re-tagged on every switch. This module is
  // deferred, so BaseLayout's theme bootstrap has already run.
  initClickTracking();
  tag("theme", currentTheme());
  window.addEventListener("themechange", () => tag("theme", currentTheme()));

  // The bootstrap doesn't re-run on a bfcache restore.
  syncThemeOnRestore(window, documentThemeSource, setTheme);
</script>
