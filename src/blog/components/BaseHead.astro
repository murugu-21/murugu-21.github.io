---
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL, TWITTER_HANDLE } from "../consts";
import { SITE_ORIGIN } from "../../lib/site";
import Favicons from "../../components/Favicons.astro";
import SiteScripts from "../../components/SiteScripts.astro";

// Declared inline and preloaded so the face is usually in hand by first paint.
import { FIRA_CODE_FACE, FIRA_CODE_URL } from "../../lib/fonts";

export interface Props {
  // Omitted for the blog index, which gets the homepage title.
  title?: string;
  description?: string;
  // "article" adds the article:* tags.
  ogType?: "website" | "article";
  publishedTime?: Date;
  tags?: string[];
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  ogType = "website",
  publishedTime,
  tags = [],
  noindex = false,
  jsonLd
} = Astro.props;

const metaDescription = description || SITE_DESCRIPTION;
const fullTitle = title ? `${title} | ${SITE_TITLE}` : `${SITE_TITLE} — ${SITE_DESCRIPTION}`;
const ogTitle = title || SITE_TITLE;

// Trailing slash to match the served directory URL and the sitemap.
const pathname = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = `${SITE_ORIGIN}${pathname}`;
const ogImage = `${SITE_URL}/og-image.png`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
{noindex && <meta name="robots" content="noindex" />}
<link rel="canonical" href={canonical} />
{/* Agent discovery, as in ../../layouts/Layout.astro. */}
<link
  rel="service-desc"
  type="application/json"
  href={`${SITE_ORIGIN}/openapi.json`}
  title="murugappan.dev API — OpenAPI 3.1.0"
/>
<link rel="service-doc" type="text/html" href={`${SITE_ORIGIN}/developers/`} />
<Favicons />
<meta name="theme-color" content="#06038d" />
<meta name="description" content={metaDescription} />
<link rel="preload" as="font" type="font/woff2" crossorigin href={FIRA_CODE_URL} />
<style is:inline set:html={FIRA_CODE_FACE}></style>
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={SITE_TITLE} />
{ogType === "article" && publishedTime && (
  <meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{ogType === "article" && tags.map(tag => <meta property="article:tag" content={tag} />)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:creator" content={TWITTER_HANDLE} />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={ogImage} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE_TITLE} RSS Feed`}
  href="/blog/rss.xml"
/>
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
<SiteScripts />
