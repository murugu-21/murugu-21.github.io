---
import { Image } from "astro:assets";
import Icon from "../../components/Icon.astro";
import { socialMediaLinks } from "../../data/portfolio";
import { AUTHOR } from "../consts";
// The same photo the portfolio landing shows (Greeting.astro), resized at
// build time; .bio-avatar in style.css crops the 50px circle to head and
// shoulders, so the blog keeps no second copy of the picture.
import portrait from "../../assets/images/portrait.webp";

const links = [
  { href: socialMediaLinks.github, icon: "github", value: "github", label: "GitHub profile" },
  {
    href: socialMediaLinks.linkedin,
    icon: "linkedin-in",
    value: "linkedin",
    label: "LinkedIn profile"
  },
  { href: socialMediaLinks.twitter, icon: "twitter", value: "x", label: "X profile" }
];
---

<div class="bio">
  <span class="bio-avatar">
    <Image src={portrait} width={86} densities={[1, 2]} alt="Profile picture" loading="lazy" />
  </span>
  <p>
    technical blog by{" "}
    <a
      href={socialMediaLinks.twitter}
      data-ph-event="social_click"
      data-ph-prop="social"
      data-ph-value="x"
    >
      <strong>{AUTHOR.name}</strong>
    </a>
    <br />
    {AUTHOR.summary}
  </p>
</div>
<div class="bio-social">
  {
    links.map(link => (
      <a
        href={link.href}
        aria-label={link.label}
        title={link.label}
        data-ph-event="social_click"
        data-ph-prop="social"
        data-ph-value={link.value}
      >
        <Icon name={link.icon} size="1.75rem" />
      </a>
    ))
  }
</div>
