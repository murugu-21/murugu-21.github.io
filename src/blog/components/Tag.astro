---
// One tag filter chip (was Tag.tsx): a visually hidden checkbox `.tag` plus
// its label, styled entirely through the checkbox state. Checked/unchecked is
// plain DOM state now — PostList.astro's script reads it on `change`.
//
// The port of tag.css's `.tag + label` rules, split by concern. Written as
// arbitrary `[.tag:…+&]:` variants rather than `peer-*` because Tailwind's
// `peer-*` compiles to the GENERAL sibling combinator `~`: every input and
// label is a sibling inside TagBar's flex row, so checking one tag would paint
// every LATER label blue. The old rules used the adjacent combinator `+`.
//
// The `:hover` half is live: hovering a `<label>` forwards `:hover` to the
// control it labels, so `.tag:hover + label` matches while the pointer is over
// the label even though the checkbox itself is parked offscreen.
export interface TagCount {
  name: string;
  count: number;
}

interface Props {
  tag: TagCount;
}
const { tag } = Astro.props;

const labelClass = [
  // base: `.tag + label { cursor: pointer }` plus the label's own box
  "mt-[.875em] mr-[.75em] flex cursor-pointer items-center rounded-[.25em]",
  // `.tag:checked + label { background-color: …; color: #fff }` — the fill is
  // the site accent per theme (navy / box-dark), the same blue the links and
  // titles use.
  "[.tag:checked+&]:bg-navy [.tag:checked+&]:text-white dark:[.tag:checked+&]:bg-box-dark",
  // `.tag:hover + label { outline: none; box-shadow: … }`
  "[.tag:hover+&]:shadow-[0_0_10px_var(--color-chip-outline)] [.tag:hover+&]:outline-none",
  "dark:[.tag:hover+&]:shadow-[0_0_10px_var(--color-chip-outline-dark)]",
  // keyboard focus on the (offscreen) checkbox shows on its label
  "[.tag:focus-visible+&]:ring-2 [.tag:focus-visible+&]:ring-blue/50",
  // `.tag:focus + label { border-radius: .25em }` — inert, kept for parity
  "[.tag:focus+&]:rounded-[0.25em]"
].join(" ");
---

{
  /* The checkbox is visually hidden but focusable and still the label's styling
    source, so it keeps the old `opacity: 0; position: absolute; left: -99999px`
    exactly (not `sr-only`, whose 1px clip would change nothing visually but is
    a different box). */
}
<input
  class="tag absolute -left-[99999px] opacity-0"
  type="checkbox"
  id={`tag-${tag.name}`}
  value={tag.name}
/>
<label for={`tag-${tag.name}`} class={labelClass}>
  {
    /* Chip outline is the portfolio's chip token (navy 45% / blue 55%), the same
      outline the per-post tag chips use. */
  }
  <span
    class="rounded-[.25em_0_0_.25em] border border-chip-outline px-[.5em] dark:border-chip-outline-dark"
  >
    {tag.name}
  </span>
  {
    /* Count badge: tonal accent (was #aaa with white numerals, 2.3:1); on a
      checked chip it sits on the navy fill, so it flips to white. */
  }
  <div
    class="flex items-center self-stretch rounded-[0_.25em_.25em_0] bg-navy/10 px-[.5em] text-[.8em] text-navy [.tag:checked+label_&]:bg-white/20 [.tag:checked+label_&]:text-white dark:bg-blue-light/20 dark:text-blue-light"
  >
    {tag.count}
  </div>
</label>
