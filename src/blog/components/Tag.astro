---
// One tag filter chip (was Tag.tsx): a visually hidden checkbox `.tag` plus
// its label, styled entirely through the checkbox state. Checked/unchecked is
// plain DOM state now — PostList.astro's script reads it on `change`.
//
// The port of tag.css's `.tag + label` rules, split by concern. Written as
// arbitrary `[.tag:…+&]:` variants rather than `peer-*` because Tailwind's
// `peer-*` compiles to the GENERAL sibling combinator `~`: every input and
// label is a sibling inside TagBar's flex row, so checking one tag would paint
// every LATER label blue. The old rules used the adjacent combinator `+`.
//
// The `:hover` half is live: hovering a `<label>` forwards `:hover` to the
// control it labels, so `.tag:hover + label` matches while the pointer is over
// the label even though the checkbox itself is parked offscreen.
export interface TagCount {
  name: string;
  count: number;
}

interface Props {
  tag: TagCount;
}
const { tag } = Astro.props;

const labelClass = [
  // base: `.tag + label { cursor: pointer }` plus the label's own box
  "mt-[.875em] mr-[.75em] flex cursor-pointer items-center rounded-[.25em]",
  // `.tag:checked + label { background-color: …; color: #fff }` — the fill is
  // the site accent per theme (navy / box-dark), the same blue the links and
  // titles use.
  "[.tag:checked+&]:bg-navy [.tag:checked+&]:text-white dark:[.tag:checked+&]:bg-box-dark",
  // `.tag:hover + label { outline: none; box-shadow: … }`
  "[.tag:hover+&]:shadow-[0_0_10px_var(--color-chip-outline)] [.tag:hover+&]:outline-none",
  "dark:[.tag:hover+&]:shadow-[0_0_10px_var(--color-chip-outline-dark)]",
  // keyboard focus on the (offscreen) checkbox shows on its label, in the
  // light theme's warm accent: the old blue/50 ring sat right next to the navy
  // chip outline it wraps, so focus and border read as the same colour. Solid
  // amber-ink, not amber/50: a half-alpha ring does not clear the 3:1 a focus
  // indicator needs on the sky, amber-ink does on every stop. Dark keeps the
  // blue.
  "[.tag:focus-visible+&]:ring-2 [.tag:focus-visible+&]:ring-amber-ink",
  "dark:[.tag:focus-visible+&]:ring-blue/50"
].join(" ");
---

{
  /* The checkbox is visually hidden but focusable and still the label's styling
    source, so it keeps the old `opacity: 0; position: absolute; left: -99999px`
    exactly (not `sr-only`, whose 1px clip would change nothing visually but is
    a different box). */
}
<input
  class="tag absolute -left-[99999px] opacity-0"
  type="checkbox"
  id={`tag-${tag.name}`}
  value={tag.name}
/>
<label for={`tag-${tag.name}`} class={labelClass}>
  {
    /* Chip outline is the portfolio's chip token (--color-chip-outline), the
      same outline the per-post tag chips use.
      The name (and the count below) sits in its own inline-block span so a
      selection highlight, and therefore a copy, hugs the text. Both cells are
      flex items (blocks) with padding, and text sitting straight on a block's
      line box gets a selection painted out to the cell's edges: Chrome paints
      a line-end marker one space wide after the text whenever the selection
      continues into the next cell or chip. An atomic inline keeps the text off
      the cell's own line box, so no marker is painted (same fix as the
      per-post chips in Post.astro and pages/blog/[...slug].astro). */
  }
  <span
    class="rounded-[.25em_0_0_.25em] border border-chip-outline px-[.5em] dark:border-chip-outline-dark"
  >
    <span class="inline-block">{tag.name}</span>
  </span>
  {
    /* Count badge: tonal accent (was #aaa with white numerals, 2.3:1); on a
      checked chip it sits on the navy fill, so it flips to white.
      Not a flex box: a flex container would blockify the inner span again and
      bring the line-end marker back, so the numeral is centred in the
      stretched badge with `content-center` (align-content on a block, in
      every evergreen browser since 2024). */
  }
  <div
    class="content-center self-stretch rounded-[0_.25em_.25em_0] bg-navy/10 px-[.5em] text-[.8em] text-navy [.tag:checked+label_&]:bg-white/20 [.tag:checked+label_&]:text-white dark:bg-blue-light/20 dark:text-blue-light"
  >
    <span class="inline-block">{tag.count}</span>
  </div>
</label>
