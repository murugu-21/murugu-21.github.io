---
// The blog index's searchable, tag-filterable post list — server-rendered
// Astro plus ~30 lines of inline script. Replaces the AllPosts React island
// (a Gatsby leftover): the list, chips and search box never needed React, and
// hydrating them pulled ~70 KB of script ahead of the largest paint on
// mobile. Filtering is the same as before — case-insensitive substring match
// on title + description (or the excerpt when there is no description), AND
// "has at least one checked tag" — applied by toggling `hidden` on the <li>s.
//
// The filter state also mirrors into the URL (`?q=`, one `?tag=` per checked
// chip) so a filtered view can be shared, bookmarked and reloaded. The URL is
// the source of truth on load; see the script at the bottom.
import type { SerializedPost } from "../utils/posts";
import SearchBar from "./SearchBar.astro";
import TagBar from "./TagBar.astro";
import type { TagCount } from "./Tag.astro";
import Post from "./Post.astro";

interface Props {
  posts: SerializedPost[];
}
const { posts } = Astro.props;

// Tag counts, most-used first, ties alphabetical (the old React useMemo).
const totals = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.tags) totals.set(tag, (totals.get(tag) ?? 0) + 1);
}
const tags: TagCount[] = [...totals]
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => (a.count === b.count ? (a.name > b.name ? 1 : -1) : b.count - a.count));
---

<div data-post-list>
  <SearchBar />
  <TagBar tags={tags} />
  {
    /* `ul, ol { margin: 1em 0 2rem; padding: 0; list-style: none }` — the 2rem
      bottom came from style.css, the 1em top from the UA sheet. */
  }
  <ol class="mt-4 mb-8 list-none p-0">
    {posts.map(post => <Post post={post} />)}
  </ol>
  <p class="post-list-item h2 my-8 leading-relaxed" data-empty hidden>No matching article found</p>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-post-list]");
  if (root) {
    const search = root.querySelector<HTMLInputElement>("#search");
    const tagInputs = Array.from(root.querySelectorAll<HTMLInputElement>("input.tag"));
    const items = Array.from(root.querySelectorAll<HTMLLIElement>("li[data-tags]")).map(li => ({
      li,
      text: li.dataset.search ?? "",
      tags: JSON.parse(li.dataset.tags ?? "[]") as string[]
    }));
    const empty = root.querySelector<HTMLElement>("[data-empty]");

    const apply = () => {
      const query = (search?.value ?? "").toLowerCase();
      const selected = tagInputs.filter(t => t.checked).map(t => t.value);
      let shown = 0;
      for (const item of items) {
        const match =
          item.text.includes(query) &&
          (selected.length === 0 || item.tags.some(tag => selected.includes(tag)));
        item.li.hidden = !match;
        if (match) shown++;
      }
      if (empty) empty.hidden = shown > 0;
    };

    // Mirror the state into the URL: `?q=` for the query and one `?tag=` per
    // checked chip (repeated, not comma-joined, so no escaping games). Params
    // this script does not own (utm_*) are preserved. replaceState rather than
    // pushState: the address bar is always current, but typing does not pile up
    // history entries, and Back still leaves /blog/ from the first navigation.
    const syncUrl = () => {
      const params = new URLSearchParams(location.search);
      const query = search?.value ?? "";
      if (query) params.set("q", query);
      else params.delete("q");
      params.delete("tag");
      for (const input of tagInputs) if (input.checked) params.append("tag", input.value);
      const qs = params.toString();
      history.replaceState(null, "", `${location.pathname}${qs ? `?${qs}` : ""}${location.hash}`);
    };

    // URL → DOM. Runs on load and again on back/forward (popstate) and bfcache
    // restores (pageshow — those do not fire popstate). Re-reading the URL also
    // beats the browser's own form restoration, so a shared link's params win
    // over whatever the input held before.
    const readUrl = () => {
      const params = new URLSearchParams(location.search);
      if (search) search.value = params.get("q") ?? "";
      const tags = new Set(params.getAll("tag"));
      for (const input of tagInputs) input.checked = tags.has(input.value);
    };

    search?.addEventListener("input", () => {
      apply();
      syncUrl();
    });
    for (const input of tagInputs) {
      input.addEventListener("change", () => {
        apply();
        syncUrl();
      });
    }
    addEventListener("popstate", () => {
      readUrl();
      apply();
    });
    addEventListener("pageshow", () => {
      readUrl();
      apply();
    });

    readUrl();
    apply();
  }
</script>
