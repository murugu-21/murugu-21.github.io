---
// One entry in the blog index list (was Post.tsx). The data-* attributes feed
// PostList.astro's filter script: `data-search` is the lower-cased haystack
// (title + description, or the excerpt when there is no description — the
// same fallback the old island's search used), `data-tags` the JSON tag list.
import type { SerializedPost } from "../utils/posts";
import { formatReadingTime } from "../utils/helpers";

interface Props {
  post: SerializedPost;
}
const { post } = Astro.props;
const haystack = `${post.title}\n${post.description ?? post.excerpt}`.toLowerCase();
---

{/* The old `ol li { padding-left: 0; margin-bottom: calc(2rem / 2) }`. */}
<li class="mb-4 pl-0" data-search={haystack} data-tags={JSON.stringify(post.tags)}>
  {
    /* `.post-list-item { margin-top: 2rem; margin-bottom: 2rem }`, but the
      article is the li's only child so the old `li *:last-child
      { margin-bottom: 0 }` (0,1,1) beat the class (0,1,0) — only the top
      margin survived. */
  }
  <article class="post-list-item mt-8" itemscope itemtype="http://schema.org/Article">
    {/* `.post-list-item header { margin-bottom: 1rem }` */}
    <header class="mb-4">
      {
        /* `h1..h6` (line-height 1.1, letter-spacing -0.025em, font-weight bold)
          narrowed by `.post-list-item h2` (1.728rem = --fontSize-4,
          --color-primary, margin 0 0 0.5rem). */
      }
      <h2
        class="mt-0 mb-2 text-[1.728rem] leading-[1.1] font-bold tracking-tight text-navy dark:text-blue-light"
      >
        {/* `h2 > a { text-decoration: none; color: inherit }` */}
        <a href={post.href} itemprop="url" class="text-inherit no-underline">
          <span itemprop="headline">{post.title}</span>
        </a>
      </h2>
      {
        /* The old normalize.css `small { font-size: 80% }` needs no port:
          Tailwind v4's preflight ships the same rule. */
      }
      <small>
        {post.dateFormatted}
        {` • ${formatReadingTime(post.minutes)}`}{" "}
      </small>
      {
        /* Was an inline style object. `flex-wrap` is the ONE deliberate visual
          deviation of the Tailwind v4 migration: this un-wrapped row was the
          source of the blog index's pre-existing horizontal overflow at phone
          width (the document measured 490px wide at a 390px viewport). With it
          the chips wrap onto a second line. Nothing changes at desktop width,
          where the chips already fit on one line. */
      }
      <div class="flex flex-row flex-wrap gap-[10px]">
        {
          post.tags.map(tag => (
            // --fontSize-0 gone with style.css; the outline is the portfolio's
            // chip token, shared with the filter chips (Tag.astro).
            <div class="border border-chip-outline p-[2px] text-[0.833rem] dark:border-chip-outline-dark">
              {tag}
            </div>
          ))
        }
      </div>
    </header>
    <section>
      {
        /* `p { line-height: 1.625 }`; `.post-list-item p { margin-bottom: 0 }`
          (preflight already zeroes the margin). The description is trusted
          frontmatter / excerpt HTML, as before. */
      }
      <p
        class="leading-relaxed"
        itemprop="description"
        set:html={post.description || post.excerpt}
      />
    </section>
  </article>
</li>
