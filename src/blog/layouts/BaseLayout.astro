---
// The blog sets in the site's one text face, Fira Code, declared inline by
// BaseHead (see ../../lib/fonts.ts) — no second font family to ship.
// The one Tailwind entry, shared with the portfolio app
import "../../styles/global.css";
import Icon from "../../components/Icon.astro";
// Highlighting for code blocks
import "prismjs/themes/prism.css";
// Rendered-markdown rules for post bodies (every selector under .blog-post)
import "../styles/post.css";

import BaseHead from "../components/BaseHead.astro";
import ThemeToggle from "../../components/ThemeToggle.astro";
import ChatWidget from "../../components/chat/ChatWidget.astro";
import { SITE_TITLE } from "../consts";

// title/description plus SEO passthroughs for BaseHead (ogType,
// publishedTime, tags, noindex, jsonLd).
const { title, description, ...seo } = Astro.props;

// The <body> utilities below are the blog's own page canvas and body type,
// which used to come from style.css (`html { line-height: 1.5; font-size: 16px }`
// + `body { font-size: 1rem; color; background-color }`). The shared entry's
// base layer paints the PORTFOLIO gradient and sets 19px/23px, so the blog has
// to restate both: `bg-none` clears the gradient that the base `background`
// shorthand sets, `text-base leading-normal` restores 16px/1.5.

// Literal: the /blog prefix comes from src/pages/blog/, not Astro's `base`.
const base = "/blog";
const rootPath = `${base}/`;
const isRootPath = Astro.url.pathname === rootPath;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} {...seo} />
  </head>
  <body
    class="bg-none bg-white text-base leading-normal text-text dark:bg-dark-bg dark:text-text-dark"
  >
    <!-- Theme bootstrap, ported from gatsby-ssr.js. Runs before first paint so
         there is no light/dark flash; exposes window.__theme (the current
         value) and window.__setPreferredTheme, and fires a `themechange` event
         on window so any number of React islands can subscribe (see
         ../utils/useTheme.ts). -->
    <script is:inline>
      // Shared persistence contract with the portfolio app: key "isDark",
      // value is a JSON bool. Derive the blog's "dark"/"light" string from it.
      var preferredTheme = null;
      try {
        var stored = localStorage.getItem("isDark");
        if (stored !== null) preferredTheme = JSON.parse(stored) ? "dark" : "light";
      } catch (err) {}

      function setTheme(newTheme) {
        // One theme class for both apps: html.dark-mode (see ThemeToggle.astro
        // and the `dark` custom variant in ../../styles/islands.css).
        document.documentElement.classList.toggle("dark-mode", newTheme === "dark");
        window.__theme = newTheme;
        preferredTheme = newTheme;
        window.dispatchEvent(new Event("themechange"));
      }

      window.__setPreferredTheme = function (newTheme) {
        setTheme(newTheme);
        try {
          localStorage.setItem("isDark", JSON.stringify(newTheme === "dark"));
        } catch (err) {}
      };
      var darkQuery = window.matchMedia("(prefers-color-scheme: dark)");
      darkQuery.onchange = function (e) {
        window.__setPreferredTheme(e.matches ? "dark" : "light");
      };
      setTheme(preferredTheme || (darkQuery.matches ? "dark" : "light"));
    </script>
    <!-- `data-[is-root-path=true]:[&_.bio]:mb-5` is the old
         `.global-wrapper[data-is-root-path="true"] .bio { margin-bottom: 1.25rem }`:
         the Bio sits in the page slot, so the override has to be written from
         the wrapper. Its (0,3,0) specificity beats Bio's own `mb-16`. -->
    <div
      class="global-wrapper mx-auto max-w-2xl px-5 py-10 data-[is-root-path=true]:[&_.bio]:mb-5"
      data-is-root-path={isRootPath}
    >
      <header class="global-header mb-12 flex flex-row items-center justify-between">
        {
          isRootPath ? (
            <h1 class="main-heading m-0 text-[2.488rem] leading-[1.1] font-bold tracking-tight text-black dark:text-white">
              <a class="text-inherit no-underline" href={rootPath}>
                {SITE_TITLE}
              </a>
            </h1>
          ) : (
            <a
              class="header-link-home text-[1.2rem] font-bold text-navy no-underline dark:text-blue-light"
              href={rootPath}
            >
              {SITE_TITLE}
            </a>
          )
        }
        <div class="header-actions flex items-center gap-4">
          <a
            class="rss-link inline-flex items-center text-text hover:text-navy dark:text-text-dark dark:hover:text-blue-light"
            href={`${rootPath}rss.xml`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Subscribe via RSS"
            title="Subscribe via RSS"
          >
            <Icon name="rss" size="18px" />
          </a>
          <ThemeToggle />
        </div>
      </header>
      <main>
        <slot />
      </main>
    </div>
    <!-- Render any ```mermaid code blocks client-side (ported from
         gatsby-browser.js; the webpack __name shim is unnecessary under Vite).
         The ~140KB mermaid chunk is only fetched once the first diagram
         scrolls near the viewport (IntersectionObserver, 300px margin), so it
         never competes with the initial page load. -->
    <script>
      const blocks = document.querySelectorAll("code.language-mermaid");
      if (blocks.length > 0) {
        // Same lazy medium-zoom wiring as post images ([...slug].astro), for
        // the diagram <img>s created below. Separate memoized instance since
        // these elements don't exist at page load.
        let zoomPromise: Promise<ReturnType<typeof import("medium-zoom").default>> | null = null;
        const ensureZoom = () =>
          (zoomPromise ??= import("medium-zoom").then(({ default: mediumZoom }) =>
            mediumZoom({ margin: 24, background: "rgba(0, 0, 0, 0.85)" })
          ));
        const wireZoom = (img: HTMLImageElement) => {
          const attach = () =>
            ensureZoom().then(zoom => {
              if (!img.dataset.zoomWired) {
                img.dataset.zoomWired = "1";
                zoom.attach(img);
              }
              return zoom;
            });
          img.addEventListener("pointerenter", () => void attach(), {
            once: true
          });
          img.addEventListener(
            "click",
            async () => {
              const zoom = await attach();
              if (!document.querySelector(".medium-zoom-image--opened")) {
                zoom.open({ target: img });
              }
            },
            { once: true }
          );
        };

        let loaded = false;
        const renderAll = () => {
          if (loaded) return;
          loaded = true;
          import("mermaid").then(({ default: mermaid }) => {
            mermaid.initialize({
              startOnLoad: false,
              theme: "neutral",
              securityLevel: "loose",
              fontFamily: "Fira Code, ui-monospace, monospace"
            });
            blocks.forEach((block, i) => {
              const pre = block.closest("pre") || block;
              const source = block.textContent || "";
              const id = `mermaid-svg-${i}`;

              mermaid
                .render(id, source)
                .then(({ svg }) => {
                  const figure = document.createElement("figure");
                  figure.className = "mermaid-diagram";
                  // Serve the SVG through an <img> (blob URL) so medium-zoom
                  // can attach — it only supports IMG elements. Inside an
                  // SVG-image the page's webfont is unavailable, but Georgia
                  // (the metric-matched fallback already in the diagram font
                  // stack) renders instead — visually near-identical. The blob
                  // URL is intentionally never revoked: medium-zoom keeps
                  // using the src for the zoomed view.
                  const img = document.createElement("img");
                  const viewBox = svg.match(/viewBox="([^"]+)"/);
                  if (viewBox) {
                    const [, , width, height] = viewBox[1].trim().split(/\s+/).map(Number);
                    if (width && height) {
                      img.width = Math.round(width);
                      img.height = Math.round(height);
                    }
                  }
                  img.src = URL.createObjectURL(new Blob([svg], { type: "image/svg+xml" }));
                  img.alt = `Diagram ${i + 1}`;
                  figure.appendChild(img);
                  pre.replaceWith(figure);
                  wireZoom(img);
                })
                .catch(err => {
                  // Leave the source block in place so the page still renders.
                  console.error("Mermaid render failed:", err);
                });
            });
          });
        };

        const io = new IntersectionObserver(
          (entries, obs) => {
            if (!entries.some(e => e.isIntersecting)) return;
            obs.disconnect();
            renderAll();
          },
          { rootMargin: "300px" }
        );
        blocks.forEach(b => io.observe(b.closest("pre") || b));
      }
    </script>
    <ChatWidget />
  </body>
</html>
