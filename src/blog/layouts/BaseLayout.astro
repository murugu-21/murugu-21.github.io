---
import "../../styles/global.css";
import Icon from "../../components/Icon.astro";
import "../styles/code.css";
import "../styles/post.css";

import BaseHead, { type Props as HeadProps } from "../components/BaseHead.astro";
import ThemeToggle from "../../components/ThemeToggle.astro";
import ChatWidget from "../../components/chat/ChatWidget.astro";
import Particles from "../../components/Particles.astro";
import { SITE_TITLE } from "../consts";

type Props = HeadProps;

// The <body>'s `text-base leading-normal` overrides the shared base layer's
// 19px/23px.

// Literal: the /blog prefix comes from src/pages/blog/, not Astro's `base`.
const rootPath = "/blog/";
const isRootPath = Astro.url.pathname === rootPath;
---

<!doctype html>
{/* Smooth anchor jumps, set here rather than in the shared global.css.
     Headings carry their own scroll-margin (post.css). */}
<html lang="en" class="scroll-smooth motion-reduce:scroll-auto">
  <head>
    <BaseHead {...Astro.props} />
  </head>
  <body class="text-base leading-normal text-text dark:text-text-dark">
    {/* Dimmed for reading: stars between words read as stray bullets. */}
    <Particles class="opacity-50 dark:opacity-70" />
    {/* Theme bootstrap, before first paint to avoid a flash. Exposes
         window.__setPreferredTheme and fires `themechange` (see
         ../../lib/theme.ts). */}
    <script is:inline>
      // Shared with the portfolio: key "isDark", a JSON bool. Inline scripts
      // can't import, so keep in step with resolveTheme in ../../lib/theme.ts.
      var preferredTheme = null;
      try {
        var stored = localStorage.getItem("isDark");
        if (stored !== null) preferredTheme = JSON.parse(stored) ? "dark" : "light";
      } catch (err) {}

      // Paint and announce without persisting.
      function applyTheme(newTheme) {
        document.documentElement.classList.toggle("dark-mode", newTheme === "dark");
        preferredTheme = newTheme;
        window.dispatchEvent(new Event("themechange"));
      }

      window.__setPreferredTheme = function (newTheme) {
        applyTheme(newTheme);
        try {
          localStorage.setItem("isDark", JSON.stringify(newTheme === "dark"));
        } catch (err) {}
      };
      var darkQuery = window.matchMedia("(prefers-color-scheme: dark)");
      darkQuery.onchange = function (e) {
        window.__setPreferredTheme(e.matches ? "dark" : "light");
      };
      applyTheme(preferredTheme || (darkQuery.matches ? "dark" : "light"));
    </script>
    {/* Bio sits in the page slot, so its index-page margin is set from the
         wrapper; (0,3,0) beats Bio's own `mb-16`. */}
    <div
      class="global-wrapper mx-auto max-w-2xl px-5 py-10 data-[is-root-path=true]:[&_.bio]:mb-5 max-md:pb-24"
      data-is-root-path={isRootPath}
    >
      <header class="global-header mb-12 flex flex-row items-center justify-between">
        {isRootPath ? (
          <h1 class="main-heading m-0 text-[2.488rem] leading-[1.1] font-bold tracking-tight text-title dark:text-white">
            <a class="text-inherit no-underline" href={rootPath}>
              {SITE_TITLE}
            </a>
          </h1>
        ) : (
          <a
            class="header-link-home text-[1.2rem] font-bold text-navy no-underline dark:text-blue-light"
            href={rootPath}
          >
            {SITE_TITLE}
          </a>
        )}
        <div class="header-actions flex items-center gap-4">
          <a
            class="rss-link inline-flex items-center text-text hover:text-navy dark:text-text-dark dark:hover:text-blue-light"
            href={`${rootPath}rss.xml`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Subscribe via RSS"
            title="Subscribe via RSS"
          >
            <Icon name="rss" size="18px" />
          </a>
          <ThemeToggle />
        </div>
      </header>
      <main>
        <slot />
      </main>
    </div>
    <ChatWidget />
  </body>
</html>
