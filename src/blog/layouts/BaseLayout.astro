---
// The blog sets in the site's one text face, Fira Code, declared inline by
// BaseHead (see ../../lib/fonts.ts) — no second font family to ship.
// The one Tailwind entry, shared with the portfolio app
import "../../styles/global.css";
import Icon from "../../components/Icon.astro";
// Highlighting for code blocks: Prism's light theme, then the fence surface +
// dark palette that must follow it unlayered (see prism-dark.css header).
import "prismjs/themes/prism.css";
import "../styles/prism-dark.css";
// Rendered-markdown rules for post bodies (every selector under .blog-post)
import "../styles/post.css";

import BaseHead from "../components/BaseHead.astro";
import ThemeToggle from "../../components/ThemeToggle.astro";
import ChatWidget from "../../components/chat/ChatWidget.astro";
// The landing page's drifting starfield, shared so the blog reads as the
// same site (idle-loaded canvas, off under prefers-reduced-motion).
import Particles from "../../components/Particles.astro";
import { SITE_TITLE } from "../consts";

// title/description plus SEO passthroughs for BaseHead (ogType,
// publishedTime, tags, noindex, jsonLd).
const { title, description, ...seo } = Astro.props;

// The <body> utilities below are the blog's body type and text colour, which
// used to come from style.css (`html { line-height: 1.5; font-size: 16px }` +
// `body { font-size: 1rem; color }`). The shared entry's base layer sets
// 19px/23px, so `text-base leading-normal` restores 16px/1.5. The page canvas
// is NOT restated: the blog paints the same gradients as the portfolio (base
// layer, --background-image-page / -dark) so the shared starfield reads the
// same on both apps — the old flat white / #282c35 canvas is gone.

// Literal: the /blog prefix comes from src/pages/blog/, not Astro's `base`.
const base = "/blog";
const rootPath = `${base}/`;
const isRootPath = Astro.url.pathname === rootPath;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} {...seo} />
  </head>
  <body class="text-base leading-normal text-text dark:text-text-dark">
    <!-- Dimmed: the blog is a reading surface. At dusk the close amber stars
         landing between words read as stray bullets (half strength); at night
         the bright white ones land inside code fences (70%). The landing page
         is untouched. -->
    <Particles class="opacity-50 dark:opacity-70" />
    <!-- Theme bootstrap, ported from gatsby-ssr.js. Runs before first paint so
         there is no light/dark flash; exposes window.__theme (the current
         value) and window.__setPreferredTheme, and fires a `themechange` event
         on window so any number of React islands can subscribe (see
         ../utils/useTheme.ts). -->
    <script is:inline>
      // Shared persistence contract with the portfolio app: key "isDark",
      // value is a JSON bool. Derive the blog's "dark"/"light" string from it.
      // Inline so it runs before paint, which means it cannot import; the key
      // and the rule are ../../lib/theme.ts (resolveTheme) — keep in step.
      var preferredTheme = null;
      try {
        var stored = localStorage.getItem("isDark");
        if (stored !== null) preferredTheme = JSON.parse(stored) ? "dark" : "light";
      } catch (err) {}

      // Paint and announce, without persisting — unlike setTheme in
      // ../../lib/theme.ts, which remembers the choice too.
      function applyTheme(newTheme) {
        // One theme class for both apps: html.dark-mode (see ../../lib/theme.ts
        // and the `dark` custom variant in ../../styles/islands.css).
        document.documentElement.classList.toggle("dark-mode", newTheme === "dark");
        window.__theme = newTheme;
        preferredTheme = newTheme;
        window.dispatchEvent(new Event("themechange"));
      }

      window.__setPreferredTheme = function (newTheme) {
        applyTheme(newTheme);
        try {
          localStorage.setItem("isDark", JSON.stringify(newTheme === "dark"));
        } catch (err) {}
      };
      var darkQuery = window.matchMedia("(prefers-color-scheme: dark)");
      darkQuery.onchange = function (e) {
        window.__setPreferredTheme(e.matches ? "dark" : "light");
      };
      applyTheme(preferredTheme || (darkQuery.matches ? "dark" : "light"));
    </script>
    <!-- `data-[is-root-path=true]:[&_.bio]:mb-5` is the old
         `.global-wrapper[data-is-root-path="true"] .bio { margin-bottom: 1.25rem }`:
         the Bio sits in the page slot, so the override has to be written from
         the wrapper. Its (0,3,0) specificity beats Bio's own `mb-16`. -->
    <div
      class="global-wrapper mx-auto max-w-2xl px-5 py-10 data-[is-root-path=true]:[&_.bio]:mb-5 max-md:pb-24"
      data-is-root-path={isRootPath}
    >
      <header class="global-header mb-12 flex flex-row items-center justify-between">
        {
          isRootPath ? (
            <h1 class="main-heading m-0 text-[2.488rem] leading-[1.1] font-bold tracking-tight text-title dark:text-white">
              <a class="text-inherit no-underline" href={rootPath}>
                {SITE_TITLE}
              </a>
            </h1>
          ) : (
            <a
              class="header-link-home text-[1.2rem] font-bold text-navy no-underline dark:text-blue-light"
              href={rootPath}
            >
              {SITE_TITLE}
            </a>
          )
        }
        <div class="header-actions flex items-center gap-4">
          <a
            class="rss-link inline-flex items-center text-text hover:text-navy dark:text-text-dark dark:hover:text-blue-light"
            href={`${rootPath}rss.xml`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Subscribe via RSS"
            title="Subscribe via RSS"
          >
            <Icon name="rss" size="18px" />
          </a>
          <ThemeToggle />
        </div>
      </header>
      <main>
        <slot />
      </main>
    </div>
    <!-- Render any ```mermaid code blocks client-side (ported from
         gatsby-browser.js; the webpack __name shim is unnecessary under Vite).
         The ~140KB mermaid chunk is only fetched once the first diagram
         scrolls near the viewport (IntersectionObserver, 300px margin), so it
         never competes with the initial page load. -->
    <script>
      import { FIRA_CODE_URL } from "../../lib/fonts";
      import { reportError } from "../../lib/analytics";

      const blocks = document.querySelectorAll("code.language-mermaid");
      if (blocks.length > 0) {
        // Mermaid measures label widths in the live DOM, where the page's Fira
        // Code webfont is loaded — but the SVG is then shown through an <img>,
        // and an SVG-as-image cannot reach the page's fonts, so the browser
        // substituted a system monospace with different advance widths and
        // labels ran past their node boxes (cut off at the box edge). Embedding
        // the same woff2 as a data: URI inside each SVG makes the image render
        // with the exact face it was measured in. Fetched once (already in
        // the HTTP cache: the layout preloads it); ~100 KB base64 per blob.
        const fontFace: Promise<string> = fetch(FIRA_CODE_URL)
          .then(r => (r.ok ? r.blob() : Promise.reject(new Error(String(r.status)))))
          .then(
            blob =>
              new Promise<string>((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = () => resolve(String(reader.result));
                reader.onerror = () => reject(reader.error);
                reader.readAsDataURL(blob);
              })
          )
          .then(
            dataUrl =>
              `@font-face{font-family:"Fira Code";font-style:normal;font-weight:300 700;src:url(${dataUrl}) format("woff2-variations")}`
          )
          .catch(() => "");

        // Baked into the SVG (not just CSS on the <img>) so the zoomed copy —
        // which medium-zoom clones outside the article, over its dark overlay —
        // keeps a solid card behind edge labels and sequence text too. The card
        // follows the theme, as the diagram does: mermaid's "neutral" theme on
        // white at dusk, its "dark" theme on #282c35 (--color-dark-bg) at night
        // — a white slab was the brightest thing on the night page, at 16:1.
        // post.css paints the same colour behind the <img>'s padding.
        const isDark = () => document.documentElement.classList.contains("dark-mode");
        const withEmbeddedStyle = (svg: string, face: string, dark: boolean) =>
          svg.replace(
            /<svg\b[^>]*>/,
            open => `${open}<style>${face}svg{background:${dark ? "#282c35" : "#fff"}}</style>`
          );

        // Same lazy medium-zoom wiring as post images ([...slug].astro), for
        // the diagram <img>s created below. Separate memoized instance since
        // these elements don't exist at page load.
        let zoomPromise: Promise<ReturnType<typeof import("medium-zoom").default>> | null = null;
        const ensureZoom = () =>
          (zoomPromise ??= import("medium-zoom").then(({ default: mediumZoom }) =>
            mediumZoom({ margin: 24, background: "rgba(0, 0, 0, 0.85)" })
          ));
        const wireZoom = (img: HTMLImageElement) => {
          const attach = () =>
            ensureZoom().then(zoom => {
              if (!img.dataset.zoomWired) {
                img.dataset.zoomWired = "1";
                zoom.attach(img);
              }
              return zoom;
            });
          img.addEventListener("pointerenter", () => void attach(), {
            once: true
          });
          img.addEventListener(
            "click",
            async () => {
              const zoom = await attach();
              if (!document.querySelector(".medium-zoom-image--opened")) {
                zoom.open({ target: img });
              }
            },
            { once: true }
          );
        };

        // One <img> per fence, created on the first render and repainted on
        // every theme toggle after it (the element stays, so medium-zoom's
        // attachment and the reader's scroll position survive). The fences'
        // <code> nodes keep the source once detached. Renders are chained on
        // `queue`: mermaid.initialize() is global, so two themes must never
        // render at once. `painted` is the theme of the last completed pass,
        // so a burst of toggles settles to one repaint (or none).
        const images: HTMLImageElement[] = [];
        let pass = 0;
        let painted: boolean | undefined;
        const render = () =>
          Promise.all([import("mermaid"), fontFace]).then(([{ default: mermaid }, face]) => {
            const dark = isDark();
            if (dark === painted) return;
            painted = dark;
            mermaid.initialize({
              startOnLoad: false,
              theme: dark ? "dark" : "neutral",
              securityLevel: "loose",
              fontFamily: "Fira Code, ui-monospace, monospace"
            });
            const id = ++pass;
            return Promise.all(
              [...blocks].map(async (block, i) => {
                try {
                  const { svg } = await mermaid.render(
                    `mermaid-svg-${i}-${id}`,
                    block.textContent || ""
                  );
                  let img = images[i];
                  if (!img) {
                    // Serve the SVG through an <img> (blob URL) so medium-zoom
                    // can attach — it only supports IMG elements. The embedded
                    // @font-face + background (see withEmbeddedStyle) travel
                    // with the blob, so the image and its zoomed clone render
                    // exactly as measured.
                    img = document.createElement("img");
                    img.alt = `Diagram ${i + 1}`;
                    const figure = document.createElement("figure");
                    figure.className = "mermaid-diagram";
                    figure.appendChild(img);
                    (block.closest("pre") || block).replaceWith(figure);
                    wireZoom(img);
                    images[i] = img;
                  }
                  const viewBox = svg.match(/viewBox="([^"]+)"/);
                  if (viewBox) {
                    const [, , width, height] = viewBox[1].trim().split(/\s+/).map(Number);
                    if (width && height) {
                      img.width = Math.round(width);
                      img.height = Math.round(height);
                    }
                  }
                  // medium-zoom clones the <img> when a zoom opens, so the
                  // previous blob can go once the repaint has loaded — unless a
                  // zoom is showing it right now (then the ~100 KB stays).
                  const previous = img.src;
                  img.addEventListener(
                    "load",
                    () => {
                      if (previous && !document.querySelector(".medium-zoom-image--opened")) {
                        URL.revokeObjectURL(previous);
                      }
                    },
                    { once: true }
                  );
                  img.src = URL.createObjectURL(
                    new Blob([withEmbeddedStyle(svg, face, dark)], { type: "image/svg+xml" })
                  );
                } catch (err) {
                  // Leave the source block in place so the page still renders.
                  console.error("Mermaid render failed:", err);
                  reportError(err, { surface: "mermaid" });
                }
              })
            );
          });

        // A pass that fails outright (the mermaid chunk did not load) leaves
        // the fences in place and is reported; the catch keeps the chain alive
        // so the next toggle tries again instead of piling up rejections.
        let queue: Promise<unknown> = Promise.resolve();
        const enqueue = () => {
          queue = queue.then(render).catch(err => {
            console.error("Mermaid render failed:", err);
            reportError(err, { surface: "mermaid" });
          });
        };
        let loaded = false;
        const renderAll = () => {
          if (loaded) return;
          loaded = true;
          enqueue();
        };
        // A toggle before the first render needs nothing: render reads the
        // theme when it runs.
        window.addEventListener("themechange", () => {
          if (loaded) enqueue();
        });

        const io = new IntersectionObserver(
          (entries, obs) => {
            if (!entries.some(e => e.isIntersecting)) return;
            obs.disconnect();
            renderAll();
          },
          { rootMargin: "300px" }
        );
        blocks.forEach(b => io.observe(b.closest("pre") || b));
      }
    </script>
    <ChatWidget />
  </body>
</html>
