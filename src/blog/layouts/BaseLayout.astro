---
import "#src/styles/global.css";
import Icon from "#src/components/Icon.astro";
import "#src/blog/styles/code.css";
import "#src/blog/styles/post.css";

import BaseHead, { type Props as HeadProps } from "#src/blog/components/BaseHead.astro";
import ThemeToggle from "#src/components/ThemeToggle.astro";
import ChatWidget from "#src/components/chat/ChatWidget.astro";
import Particles from "#src/components/Particles.astro";
import { SITE_TITLE } from "#src/blog/consts.ts";
import { themeBootstrapScript } from "#src/lib/theme.ts";

type Props = HeadProps;

// The <body>'s `text-base leading-normal` overrides the shared base layer's
// 19px/23px.

// Literal: the /blog prefix comes from src/pages/blog/, not Astro's `base`.
const rootPath = "/blog/";
const isRootPath = Astro.url.pathname === rootPath;
---

<!doctype html>
{/* Smooth anchor jumps, set here rather than in the shared global.css.
     Headings carry their own scroll-margin (post.css). */}
<html lang="en" class="scroll-smooth motion-reduce:scroll-auto">
  <head>
    <BaseHead {...Astro.props} />
    <script is:inline set:html={themeBootstrapScript} />
  </head>
  <body class="text-base leading-normal text-text dark:text-text-dark">
    {/* Dimmed for reading: stars between words read as stray bullets. */}
    <Particles class="opacity-50 dark:opacity-70" />
    {/* Bio sits in the page slot, so its index-page margin is set from the
         wrapper; (0,3,0) beats Bio's own `mb-16`. */}
    <div
      class="mx-auto max-w-2xl px-5 py-10 data-[is-root-path=true]:[&_.bio]:mb-5 max-md:pb-24"
      data-is-root-path={isRootPath}
    >
      <header class="mb-12 flex flex-row items-center justify-between">
        {isRootPath ? (
          <h1 class="m-0 text-[2.488rem] leading-[1.1] font-bold tracking-tight text-title dark:text-white">
            <a class="text-inherit no-underline" href={rootPath}>
              {SITE_TITLE}
            </a>
          </h1>
        ) : (
          <a
            class="text-[1.2rem] font-bold text-navy no-underline dark:text-blue-light"
            href={rootPath}
          >
            {SITE_TITLE}
          </a>
        )}
        <div class="flex items-center gap-4">
          <a
            class="inline-flex items-center text-text hover:text-navy dark:text-text-dark dark:hover:text-blue-light"
            href={`${rootPath}rss.xml`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Subscribe via RSS"
            title="Subscribe via RSS"
          >
            <Icon name="rss" size="18px" />
          </a>
          <ThemeToggle />
        </div>
      </header>
      <main>
        <slot />
      </main>
    </div>
    <ChatWidget />
  </body>
</html>
