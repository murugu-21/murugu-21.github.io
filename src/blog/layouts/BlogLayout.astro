---
// Restated from Layout: Astro emits a module's own CSS before its components',
// and the blog sheets must follow global.css's @layer order declaration.
import "#src/styles/global.css";
import "#src/blog/styles/code.css";
import "#src/blog/styles/post.css";
import Layout, { type Props as LayoutProps } from "#src/layouts/Layout.astro";
import Icon from "#src/components/Icon.astro";
import ThemeToggle from "#src/components/ThemeToggle.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "#src/blog/consts.ts";

// title is omitted for the blog index, which gets the homepage title.
type Props = Pick<LayoutProps, "title" | "description" | "noindex" | "article" | "graph">;

const { title, ...rest } = Astro.props;

// Literal: the /blog prefix comes from src/pages/blog/, not Astro's `base`.
const rootPath = "/blog/";
const isRootPath = Astro.url.pathname === rootPath;
---

<Layout
  section="blog"
  title={title ? `${title} | ${SITE_TITLE}` : `${SITE_TITLE} | ${SITE_DESCRIPTION}`}
  socialTitle={title ?? SITE_TITLE}
  {...rest}
>
  {/* Bio sits in the page slot, so its index-page margin is set from the
       wrapper; (0,3,0) beats Bio's own `mb-16`. */}
  <div
    class="mx-auto max-w-2xl px-5 py-10 data-[is-root-path=true]:[&_.bio]:mb-5 max-md:pb-24"
    data-is-root-path={isRootPath}
  >
    <header class="mb-12 flex flex-row items-center justify-between">
      {isRootPath ? (
        <h1 class="m-0 text-[2.488rem] leading-[1.1] font-bold tracking-tight text-title dark:text-white">
          <a class="text-inherit no-underline" href={rootPath}>
            {SITE_TITLE}
          </a>
        </h1>
      ) : (
        <a
          class="text-[1.2rem] font-bold text-navy no-underline dark:text-blue-light"
          href={rootPath}
        >
          {SITE_TITLE}
        </a>
      )}
      <div class="flex items-center gap-4">
        <a
          class="inline-flex items-center text-text hover:text-navy dark:text-text-dark dark:hover:text-blue-light"
          href={`${rootPath}rss.xml`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Subscribe via RSS"
          title="Subscribe via RSS"
        >
          <Icon name="rss" size="18px" />
        </a>
        <ThemeToggle />
      </div>
    </header>
    <main>
      <slot />
    </main>
  </div>
</Layout>
