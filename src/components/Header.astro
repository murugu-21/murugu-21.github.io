---
import { greeting } from "#src/data/portfolio.ts";
import ThemeToggle from "./ThemeToggle.astro";

// Root-relative so the links work from other pages. /about is deliberately left out
// (machine entity page, linked via sitemap/llms.txt/rel=author).
const links = [
  { href: "/#skills", label: "Skills" },
  { href: "/#experience", label: "Work Experiences" },
  { href: "/#projects", label: "Projects" },
  { href: "/#achievements", label: "Achievements" },
  { href: "/#blogs", label: "Blogs" },
  {
    href: greeting.resumePath,
    label: "Resume",
    download: greeting.resumeFileName,
    event: "resume_download"
  },
  { href: "/#contact", label: "Contact Me" }
];

// Breakpoints are the literal pair `max-[768px]:` / `min-[768px]:`, not `md:`:
// the theme puts md at 769px (global.css), which would leave 768px in neither band.

// Transparent at rest, blurred once `.scrolled` (script below). Always solid
// below 768px: the CSS-only dropdown needs an opaque surface.
const headerClass = [
  "fixed top-0 right-0 left-0 z-[999] mx-auto max-w-full bg-transparent px-5 py-2.5",
  "transition-all duration-300 ease-out motion-reduce:transition-none",
  "[&.scrolled]:backdrop-blur-[15px]",
  "max-[768px]:bg-surface max-[768px]:shadow-[0_4px_10px_0_rgba(3,5,40,0.12)]",
  "dark:max-[768px]:bg-dark-base",
  "min-[768px]:flex min-[768px]:items-center min-[768px]:justify-between",
  "min-[768px]:[&.scrolled]:bg-nav-scrolled",
  "min-[768px]:[&.scrolled]:shadow-[0_10px_10px_0_rgba(3,5,40,0.12)]",
  "dark:min-[768px]:[&.scrolled]:bg-nav-scrolled-dark",
  // Nav text + logo don't fit one row below 1320px, so type steps down in three bands.
  "min-[768px]:max-[961px]:text-[12px]",
  "min-[961px]:max-[1121px]:text-[13px]",
  "min-[1121px]:max-[1321px]:text-[14px]"
];

// The ~300px logo and the hamburger can't share a narrow row, so it shrinks in two steps.
const logo = [
  "float-left block flex-none leading-[normal] no-underline",
  "mt-2.5 text-[1.5em] min-[768px]:mt-0",
  "min-[360px]:max-[768px]:mt-[18px] min-[360px]:max-[768px]:text-[1.05em]",
  "max-[360px]:mt-6 max-[360px]:text-[0.85em]"
];

// The 961 to 1320px band tightens the padding, so the underline's inset follows.
const navLink = [
  "relative block px-5 py-[15px] text-text no-underline dark:text-white",
  "after:absolute after:bottom-2 after:left-5 after:h-[3px] after:w-0 after:rounded-[3px]",
  "after:bg-navy after:transition-[width] after:duration-300 after:ease-out after:content-['']",
  "dark:after:bg-blue motion-reduce:after:transition-none",
  "hover:after:w-[calc(100%-40px)] focus-visible:after:w-[calc(100%-40px)]",
  "min-[961px]:max-[1321px]:px-3 min-[961px]:max-[1321px]:after:left-3",
  "min-[961px]:max-[1321px]:hover:after:w-[calc(100%-24px)]",
  "min-[961px]:max-[1321px]:focus-visible:after:w-[calc(100%-24px)]"
];

// Middle bar is the element, outer bars its ::before/::after; checked, they
// cross into an X. Variants are written out in full: Tailwind scans this file as text.
const navicon = [
  "relative block h-[3px] w-[22px] rounded-[3px] bg-navy dark:bg-blue",
  "transition-[background] duration-200 ease-out",
  "before:absolute before:top-[7px] before:block before:h-full before:w-full before:rounded-[3px]",
  "before:bg-navy before:transition-all before:duration-200 before:ease-out before:content-['']",
  "dark:before:bg-blue",
  "after:absolute after:top-[-7px] after:block after:h-full after:w-full after:rounded-[3px]",
  "after:bg-navy after:transition-all after:duration-200 after:ease-out after:content-['']",
  "dark:after:bg-blue",
  "[.menu-btn:checked~.menu-icon_&]:bg-transparent",
  "[.menu-btn:checked~.menu-icon_&]:before:top-0",
  "[.menu-btn:checked~.menu-icon_&]:before:-rotate-45",
  "[.menu-btn:checked~.menu-icon_&]:after:top-0",
  "[.menu-btn:checked~.menu-icon_&]:after:rotate-45"
];

// visibility hidden (with max-height 0) keeps collapsed links out of the tab order.
const menu = [
  "clear-both m-0 list-none p-0",
  "max-[768px]:invisible max-[768px]:max-h-0 max-[768px]:overflow-hidden",
  "max-[768px]:transition-[max-height,visibility] max-[768px]:duration-200 max-[768px]:ease-out",
  "max-[768px]:[.menu-btn:checked~nav_&]:visible",
  "max-[768px]:[.menu-btn:checked~nav_&]:max-h-[486px]"
];
---

<header class:list={headerClass} id="site-header">
  <a href="/" class:list={logo}>
    <span class="text-subtitle dark:text-white/65">&lt;</span>
    <span class="px-2.5 font-bold text-navy dark:text-white">Murugappan M</span>
    <span class="text-subtitle dark:text-white/65">/&gt;</span>
  </a>
  {/* Kept over the icon (48px, opacity 0, not sr-only) for hit area and focus order. */}
  <input
    class="menu-btn peer absolute top-2 right-2 z-[1] m-0 h-12 w-12 cursor-pointer opacity-0 min-[768px]:hidden"
    type="checkbox"
    id="menu-btn"
  />
  <label
    class="menu-icon relative float-right inline-block cursor-pointer px-5 py-7 select-none peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-navy min-[768px]:hidden"
    for="menu-btn"
  >
    <span class="sr-only">Open menu</span>
    <span class:list={navicon}></span>
  </label>
  <nav aria-label="Main" class="min-[768px]:ml-auto">
    <ul class:list={menu}>
      {links.map(l => (
        <li class="min-[768px]:float-left">
          <a href={l.href} download={l.download} data-ph-event={l.event} class:list={navLink}>
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  {/* Outside the collapsible menu so it stays in the bar. top-[41px] (10px
       padding + half the 62px hamburger), not top-1/2: the header grows when
       the menu opens. */}
  <div class="absolute top-[41px] right-[86px] -translate-y-1/2 min-[768px]:static min-[768px]:ml-1 min-[768px]:translate-y-0">
    <ThemeToggle />
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const onScroll = () => header?.classList.toggle("scrolled", window.scrollY >= 20);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>
