---
import ThemeToggle from "./ThemeToggle.astro";

// "/#hash" (not bare "#hash") so the section links also work from /about
const links = [
  {href: "/#skills", label: "Skills"},
  {href: "/#experience", label: "Work Experiences"},
  {href: "/#projects", label: "Projects"},
  {href: "/#achievements", label: "Achievements"},
  {href: "/#blogs", label: "Blogs"},
  {href: "/about", label: "About"},
  {href: "/#resume", label: "Resume"},
  {href: "/#contact", label: "Contact Me"}
];
---

<header class="header" id="site-header">
  <a href="/" class="logo">
    <span class="grey-color">&lt;</span>
    <span class="logo-name">Murugappan M</span>
    <span class="grey-color">/&gt;</span>
  </a>
  <input
    class="menu-btn"
    type="checkbox"
    id="menu-btn"
    aria-label="Open menu"
  />
  <label class="menu-icon" for="menu-btn"><span class="navicon"></span></label>
  <nav aria-label="Main">
    <ul class="menu">
      {
        links.map(l => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))
      }
      <li><ThemeToggle /></li>
    </ul>
  </nav>
</header>

<script>
  // Reference navbar behavior: transparent over the hero, translucent +
  // blurred once the page is scrolled (threshold 20px, like the original).
  const header = document.getElementById("site-header");
  const onScroll = () =>
    header?.classList.toggle("scrolled", window.scrollY >= 20);
  onScroll();
  window.addEventListener("scroll", onScroll, {passive: true});
</script>

<style lang="scss">
  @import "../styles/variables";

  /* reference navbar: fixed on top, transparent at rest, translucent + blur
     once scrolled (`.scrolled` added by the script above) */

  .header {
    max-width: 100%;
    padding: 10px 20px;
    margin: 0px auto;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 999;
    background-color: transparent;
    transition: all 0.3s ease-out;
  }

  .header.scrolled {
    background-color: $navScrolledLight;
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    box-shadow: 0 10px 10px 0 rgba(5, 30, 10, 0.12);
  }

  :global(html.dark-mode) .header.scrolled {
    background-color: $navScrolledDark;
  }

  .header ul {
    margin: 0;
    padding: 0;
    list-style: none;
    overflow: hidden;
  }

  .grey-color {
    color: $subTitle;
  }

  /* nav links: grow-in accent underline on hover (reference ::after bar) */
  .header li a {
    display: block;
    position: relative;
    padding: 15px 20px;
    color: $textColor;
    text-decoration: none;
  }

  .header li a::after {
    content: "";
    position: absolute;
    left: 20px;
    bottom: 8px;
    height: 3px;
    width: 0;
    border-radius: 3px;
    background: $accentLight;
    transition: width 0.3s ease-out;
  }

  .header li a:hover::after,
  .header li a:focus-visible::after {
    width: calc(100% - 40px);
  }

  @media (prefers-reduced-motion: reduce) {
    .header,
    .header li a::after {
      transition: none;
    }
  }

  .header .logo {
    display: block;
    flex: none;
    float: left;
    font-size: 1.5em;
    text-decoration: none;
    margin-top: 10px;
    line-height: normal;
  }

  .header .logo-name {
    font-family: "Agustina Regular", "Agustina Regular fallback";
    font-weight: bold;
    font-variant-ligatures: no-common-ligatures;
    -webkit-font-variant-ligatures: no-common-ligatures;
    padding: 0 10px;
    color: $buttonColor; // theme green (was inheriting the browser's violet visited-link color)
  }

  /* keep the toggle aligned like the old <li><a> wrapper */
  .header li :global(.switch) {
    margin: 15px 20px;
  }

  /* dark mode */

  :global(html.dark-mode) .header li a {
    color: $textColorDark !important;
  }

  :global(html.dark-mode) .header li a::after {
    background: $accentDark;
  }

  :global(html.dark-mode) .header .logo-name {
    color: $textColorDark; // keep the name readable (white) on the dark header
  }

  /* menu */

  .header .menu {
    clear: both;
    max-height: 0;
    visibility: hidden; /* keep collapsed menu links out of the tab order */
    transition:
      max-height 0.2s ease-out,
      visibility 0.2s;
  }

  /* menu icon (hamburger bars in accent green, reference-style) */

  .header .menu-icon {
    cursor: pointer;
    display: inline-block;
    float: right;
    padding: 28px 20px;
    position: relative;
    user-select: none;
  }

  .header .menu-icon .navicon {
    background: $accentLight;
    display: block;
    height: 3px;
    border-radius: 3px;
    position: relative;
    transition: background 0.2s ease-out;
    width: 22px;
  }

  .header .menu-icon .navicon:before,
  .header .menu-icon .navicon:after {
    background: $accentLight;
    border-radius: 3px;
    content: "";
    display: block;
    height: 100%;
    position: absolute;
    transition: all 0.2s ease-out;
    width: 100%;
  }

  :global(html.dark-mode) .header .menu-icon .navicon {
    background: $accentDark;
  }

  :global(html.dark-mode) .header .menu-icon .navicon:before,
  :global(html.dark-mode) .header .menu-icon .navicon:after {
    background: $accentDark !important;
  }

  .header .menu-icon .navicon:before {
    top: 7px;
  }

  .header .menu-icon .navicon:after {
    top: -7px;
  }

  /* menu btn */

  .header .menu-btn {
    position: absolute;
    opacity: 0;
    /* keep it over the icon for hit-area + focus order */
    width: 48px;
    height: 48px;
    right: 8px;
    top: 8px;
    margin: 0;
    cursor: pointer;
    z-index: 1;
  }

  .header .menu-btn:focus-visible ~ .menu-icon {
    outline: 2px solid $buttonColor;
    outline-offset: 2px;
  }

  .header .menu-btn:checked ~ nav .menu {
    max-height: 486px;
    visibility: visible;
  }

  .header .menu-btn:checked ~ .menu-icon .navicon {
    background: transparent !important;
  }

  .header .menu-btn:checked ~ .menu-icon .navicon:before {
    transform: rotate(-45deg);
  }

  .header .menu-btn:checked ~ .menu-icon .navicon:after {
    transform: rotate(45deg);
  }

  .header .menu-btn:checked ~ .menu-icon:not(.steps) .navicon:before,
  .header .menu-btn:checked ~ .menu-icon:not(.steps) .navicon:after {
    top: 0;
  }

  /* below 48em (768px) the bar is always solid (reference behavior on mobile) —
     the dropdown menu needs an opaque surface regardless of scroll position */
  @media (max-width: 47.99em) {
    .header,
    .header.scrolled {
      background-color: $lightBackground1;
      box-shadow: 0 4px 10px 0 rgba(5, 30, 10, 0.12);
    }
    :global(html.dark-mode) .header,
    :global(html.dark-mode) .header.scrolled {
      background-color: $darkPageBase;
    }
  }

  /* 48em = 768px */

  @media (min-width: 48em) {
    .header li {
      float: left;
    }
    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .header .menu {
      max-height: none;
      visibility: visible;
      overflow: visible; /* underline sits near the link box edge */
    }
    .header .menu-icon {
      display: none;
    }
    .header .menu-btn {
      display: none;
    }
  }
  @media (max-width: 960px) and (min-width: 768px) {
    .header {
      font-size: 12px;
    }
  }
</style>
