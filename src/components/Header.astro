---
import { greeting } from "#src/data/portfolio.ts";
import ThemeToggle from "./ThemeToggle.astro";
import { cn } from "#src/lib/utils.ts";

// Root-relative so the links work from other pages. /about is deliberately left out
// (machine entity page, linked via sitemap/llms.txt/rel=author).
const links = [
  { href: "/#skills", label: "Skills" },
  { href: "/#experience", label: "Work Experiences" },
  { href: "/#projects", label: "Projects" },
  { href: "/#achievements", label: "Achievements" },
  { href: "/#blogs", label: "Blogs" },
  { href: greeting.resumePath, label: "Resume", event: "resume_download" },
  { href: "/#contact", label: "Contact Me" }
];
---

{/* Transparent at rest, blurred once `data-scrolled` (script below). Always solid
   below lg, where the menu sheet continues its surface. */}
<header
  class={cn(
    "group fixed inset-x-0 top-0 z-30 mx-auto max-w-full bg-transparent px-5 py-2.5 transition-all duration-300 ease-out not-print:data-scrolled:backdrop-blur-lg motion-reduce:transition-none max-lg:not-print:bg-surface max-lg:not-print:shadow-md lg:flex lg:items-center lg:justify-between lg:not-print:data-scrolled:bg-nav-scrolled lg:not-print:data-scrolled:shadow-lg dark:max-lg:bg-dark-base dark:lg:data-scrolled:bg-nav-scrolled-dark print:absolute",
    // Nav text + logo don't fit one row below 2xl, so type steps down in two bands.
    "lg:max-xl:text-sm xl:max-2xl:text-base"
  )}
  id="site-header"
>
  {/* The logo, the theme toggle and the hamburger share a phone's row, so the
     logo is smaller there; mt-4 levels it with the hamburger. */}
  <a
    href="/"
    class="float-left mt-4 block flex-none text-base no-underline sm:text-xl lg:mt-0 2xl:text-3xl"
  >
    <span class="text-subtitle-muted">&lt;</span>
    <span class="px-1 font-bold text-navy sm:px-2.5 dark:text-white">Murugappan M</span>
    <span class="text-subtitle-muted">/&gt;</span>
  </a>
  {/* Without the Popover API (Safari < 17, Firefox < 125) the phone nav is
     unavailable, so the button hides rather than sit dead. */}
  <button
    type="button"
    class="float-right cursor-pointer px-5 py-7 not-supports-[selector(:popover-open)]:hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy lg:hidden print:hidden"
    popovertarget="site-menu"
  >
    <span class="sr-only">Menu</span>
    {/* Middle bar is the element, outer bars its ::before/::after; while the menu is
       open, they cross into an X. Variants are written out in full: Tailwind scans
       this file as text. */}
    <span class="relative block h-1 w-6 rounded-full bg-navy transition-colors duration-200 ease-out group-has-open:bg-transparent before:absolute before:top-2 before:block before:size-full before:rounded-full before:bg-navy before:transition-all before:duration-200 before:ease-out before:content-[''] group-has-open:before:top-0 group-has-open:before:-rotate-45 after:absolute after:-top-2 after:block after:size-full after:rounded-full after:bg-navy after:transition-all after:duration-200 after:ease-out after:content-[''] group-has-open:after:top-0 group-has-open:after:rotate-45 dark:bg-blue dark:before:bg-blue dark:after:bg-blue"></span>
  </button>
  <nav aria-label="Main" class="lg:ml-auto">
    {/* The list is a popover: Escape and a tap outside close it, and the button gets
       aria-expanded for free. The UA styles a popover as a hidden, centred, bordered
       box, so both bands undo that. */}
    <ul
      id="site-menu"
      popover
      class={cn(
        "m-0 size-auto list-none border-0 p-0",
        // Inline on desktop: the UA hides a closed popover, and the script keeps it closed there.
        "lg:static lg:block lg:overflow-visible lg:bg-transparent",
        // A sheet in the top layer, tucked 2px under the bar's content edge (10px padding
        // + the 60px button), on the bar's surface. max-h-120 clears the seven links.
        "max-lg:fixed max-lg:inset-x-0 max-lg:top-17 max-lg:bottom-auto max-lg:bg-surface max-lg:px-5 max-lg:pb-2.5 dark:max-lg:bg-dark-base",
        "max-lg:max-h-0 max-lg:overflow-hidden max-lg:shadow-md max-lg:open:max-h-120",
        // The slide: max-height from 0 on open, back to 0 on close. display and overlay
        // are discrete, so the sheet leaves the top layer only once the slide ends.
        "max-lg:transition-[max-height,display,overlay] max-lg:transition-discrete max-lg:starting:open:max-h-0",
        // The breakpoint variant must wrap motion-reduce, or the transition rule above outranks it.
        "max-lg:duration-200 max-lg:ease-out max-lg:motion-reduce:transition-none"
      )}
    >
      {links.map(l => (
        <li class="lg:float-left">
          {/* Below 2xl the padding tightens with the type, and the underline's inset follows. */}
          <a
            href={l.href}
            data-ph-event={l.event}
            class="relative block px-5 py-4 text-text no-underline after:absolute after:inset-x-5 after:bottom-2 after:h-1 after:origin-left after:scale-x-0 after:rounded-full after:bg-navy after:transition-transform after:duration-300 after:ease-out after:content-[''] hover:after:scale-x-100 focus-visible:after:scale-x-100 motion-reduce:after:transition-none lg:max-xl:px-2.5 lg:max-xl:after:inset-x-2.5 xl:max-2xl:px-3 xl:max-2xl:after:inset-x-3 dark:text-white dark:after:bg-blue"
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  {/* Outside the menu so it stays in the bar, level with the hamburger. */}
  <div class="absolute top-10 right-22 -translate-y-1/2 lg:static lg:ml-1 lg:translate-y-0">
    <ThemeToggle />
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  if (!header) throw new Error("Header: #site-header is missing");
  const onScroll = () => header.toggleAttribute("data-scrolled", window.scrollY >= 20);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const menu = document.getElementById("site-menu");
  if (!menu) throw new Error("Header: #site-menu is missing");

  // Without the Popover API the button is hidden (menuButton) and there is nothing to close.
  if ("hidePopover" in menu) {
    // Light dismiss ignores taps inside the popover, and a same-page hash link
    // never navigates away, so a chosen link closes the menu itself.
    menu.addEventListener("click", e => {
      if (e.target instanceof Element && e.target.closest("a")) menu.hidePopover();
    });

    // An open popover stays in the top layer, where the desktop's inline layout
    // can't reach it, so a menu left open across the breakpoint closes.
    window.matchMedia("(min-width: 64rem)").addEventListener("change", e => {
      if (e.matches) menu.hidePopover();
    });
  }
</script>
