---
import ThemeToggle from "./ThemeToggle.astro";

// "/#hash" (not bare "#hash") so the section links also work from /about.
// /about itself is deliberately NOT in the human nav — it's the machine
// entity page, reachable via sitemap/llms.txt/rel=author instead.
const links = [
  { href: "/#skills", label: "Skills" },
  { href: "/#experience", label: "Work Experiences" },
  { href: "/#projects", label: "Projects" },
  { href: "/#achievements", label: "Achievements" },
  { href: "/#blogs", label: "Blogs" },
  { href: "/#resume", label: "Resume" },
  { href: "/#contact", label: "Contact Me" }
];

// Breakpoints. Tailwind's max-* variants are exclusive (`width < X`) while the
// SCSS this replaces used the inclusive `max-width: X`, so every max band here
// is the old bound + 1px. This file's old queries were `max-width: 47.99em`
// (767.84px) and `min-width: 48em` (768px), so the mobile/desktop split is
// written as `max-[768px]:` / `min-[768px]:` — a literal pair that meets at 768
// with no overlap and no gap. `md:` is deliberately NOT used: the theme now
// puts md at 769px, which would leave 768px in neither band.

// Reference navbar: fixed on top, transparent at rest, translucent + blurred
// once scrolled (`.scrolled` is added by the inline script below). Below 768px
// the bar is always solid — the CSS-only dropdown needs an opaque surface no
// matter where the page is scrolled to.
const headerClass = [
  "header fixed top-0 right-0 left-0 z-[999] mx-auto max-w-full bg-transparent px-5 py-2.5",
  "transition-all duration-300 ease-out motion-reduce:transition-none",
  "[&.scrolled]:backdrop-blur-[15px]",
  "max-[768px]:bg-white max-[768px]:shadow-[0_4px_10px_0_rgba(3,5,40,0.12)]",
  "dark:max-[768px]:bg-dark-base",
  "min-[768px]:flex min-[768px]:items-center min-[768px]:justify-between",
  "min-[768px]:[&.scrolled]:bg-nav-scrolled",
  "min-[768px]:[&.scrolled]:shadow-[0_10px_10px_0_rgba(3,5,40,0.12)]",
  "dark:min-[768px]:[&.scrolled]:bg-nav-scrolled-dark",
  // 768–960 / 961–1120 / 1121–1320: full-size nav text + logo don't fit one
  // row, so the bar's type steps down through three bands.
  "min-[768px]:max-[961px]:text-[12px]",
  "min-[961px]:max-[1121px]:text-[13px]",
  "min-[1121px]:max-[1321px]:text-[14px]"
];

// The signature logo at 1.5em (~300px) plus the floated hamburger can't share a
// narrow row, so it shrinks (and re-centres) in two steps below 768px.
const logo = [
  "logo float-left block flex-none leading-[normal] no-underline",
  "mt-2.5 text-[1.5em] min-[768px]:mt-0",
  // old `max-width: 22.49em` = 359.84px, so the tiny band is < 360px
  "min-[360px]:max-[768px]:mt-[18px] min-[360px]:max-[768px]:text-[1.05em]",
  "max-[360px]:mt-6 max-[360px]:text-[0.85em]"
];

// Nav links: grow-in accent underline on hover/focus (the reference ::after
// bar); the 961–1320 band tightens the padding, so the bar's inset follows.
const navLink = [
  "relative block px-5 py-[15px] text-text no-underline dark:text-white",
  "after:absolute after:bottom-2 after:left-5 after:h-[3px] after:w-0 after:rounded-[3px]",
  "after:bg-navy after:transition-[width] after:duration-300 after:ease-out after:content-['']",
  "dark:after:bg-blue motion-reduce:after:transition-none",
  "hover:after:w-[calc(100%-40px)] focus-visible:after:w-[calc(100%-40px)]",
  "min-[961px]:max-[1321px]:px-3 min-[961px]:max-[1321px]:after:left-3",
  "min-[961px]:max-[1321px]:hover:after:w-[calc(100%-24px)]",
  "min-[961px]:max-[1321px]:focus-visible:after:w-[calc(100%-24px)]"
];

// Hamburger bars. The middle bar is the element; the two outer bars are its
// ::before/::after. Checked, the middle bar goes transparent and the outer two
// stack at top:0 and cross into an X.
// (the checked-state variants are written out in full — Tailwind scans this
// file as text, so a composed template string would never be generated)
const navicon = [
  "navicon relative block h-[3px] w-[22px] rounded-[3px] bg-navy dark:bg-blue",
  "transition-[background] duration-200 ease-out",
  "before:absolute before:top-[7px] before:block before:h-full before:w-full before:rounded-[3px]",
  "before:bg-navy before:transition-all before:duration-200 before:ease-out before:content-['']",
  "dark:before:bg-blue",
  "after:absolute after:top-[-7px] after:block after:h-full after:w-full after:rounded-[3px]",
  "after:bg-navy after:transition-all after:duration-200 after:ease-out after:content-['']",
  "dark:after:bg-blue",
  "[.menu-btn:checked~.menu-icon_&]:bg-transparent",
  "[.menu-btn:checked~.menu-icon_&]:before:top-0",
  "[.menu-btn:checked~.menu-icon_&]:before:-rotate-45",
  "[.menu-btn:checked~.menu-icon_&]:after:top-0",
  "[.menu-btn:checked~.menu-icon_&]:after:rotate-45"
];

// Collapsed menu: max-height 0 + visibility hidden keeps the links out of the
// tab order. Above 768px it is a plain row, so the collapse only exists below.
const menu = [
  "menu clear-both m-0 list-none p-0",
  "max-[768px]:invisible max-[768px]:max-h-0 max-[768px]:overflow-hidden",
  "max-[768px]:transition-[max-height,visibility] max-[768px]:duration-200 max-[768px]:ease-out",
  "max-[768px]:[.menu-btn:checked~nav_&]:visible",
  "max-[768px]:[.menu-btn:checked~nav_&]:max-h-[486px]"
];
---

<header class:list={headerClass} id="site-header">
  <a href="/" class:list={logo}>
    <span class="text-subtitle">&lt;</span>
    <span class="logo-name px-2.5 font-bold text-navy dark:text-white">Murugappan M</span>
    <span class="text-subtitle">/&gt;</span>
  </a>
  <!-- Kept over the icon (48px, opacity 0 — not sr-only) for hit area + focus order. -->
  <input
    class="menu-btn peer absolute top-2 right-2 z-[1] m-0 h-12 w-12 cursor-pointer opacity-0 min-[768px]:hidden"
    type="checkbox"
    id="menu-btn"
    aria-label="Open menu"
  />
  <label
    class="menu-icon relative float-right inline-block cursor-pointer px-5 py-7 select-none peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-navy min-[768px]:hidden"
    for="menu-btn"><span class:list={navicon}></span></label
  >
  <nav aria-label="Main" class="min-[768px]:ml-auto">
    <ul class:list={menu}>
      {
        links.map(l => (
          <li class="min-[768px]:float-left">
            <a href={l.href} class:list={navLink}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <!-- Below 768px the menu collapses, so the toggle can't live inside it —
       react.dev keeps its theme control in the top bar at every width. Anchored
       to the fixed header, vertically centred like the hamburger and clear of
       its 62px box (22px bars + 20px padding each side) sitting 20px off the
       edge. -->
  <div
    class="theme-slot absolute top-1/2 right-[86px] -translate-y-1/2 min-[768px]:static min-[768px]:ml-1 min-[768px]:translate-y-0"
  >
    <ThemeToggle />
  </div>
</header>

<script>
  // Reference navbar behavior: transparent over the hero, translucent +
  // blurred once the page is scrolled (threshold 20px, like the original).
  const header = document.getElementById("site-header");
  const onScroll = () => header?.classList.toggle("scrolled", window.scrollY >= 20);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>
