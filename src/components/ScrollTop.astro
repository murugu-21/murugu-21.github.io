---
import Icon from "./Icon.astro";
---

<button
  id="topButton"
  class="fixed right-7.5 bottom-22.5 z-99 hidden cursor-pointer rounded-[15px] border-none bg-navy p-3.75 text-white outline-none hover:bg-dusk-violet hover:transition-all hover:duration-200 hover:ease-in-out data-visible:block dark:bg-blue-light dark:text-navy dark:hover:bg-blue"
  aria-label="Back to top"
  title="Go to top"
>
  <Icon name="hand-point-up" class="block" size="25px" />
</button>

<script>
  const btn = document.getElementById("topButton");
  if (!btn) throw new Error("ScrollTop: #topButton is missing");
  const onScroll = () => btn.toggleAttribute("data-visible", window.scrollY >= 20);
  // Firefox and Safari restore a reload's scroll position without a scroll event.
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
  btn.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
</script>
