---
import Icon from "./Icon.astro";
---

<button
  id="topButton"
  class="hidden fixed bottom-[90px] right-[30px] z-[99] cursor-pointer rounded-[15px] border-none bg-navy p-[15px] text-white outline-none hover:bg-black dark:bg-blue-light dark:text-navy dark:hover:bg-blue hover:transition-all hover:duration-200 hover:ease-in-out [&.visible]:block"
  aria-label="Back to top"
  title="Go to top"
>
  <Icon name="hand-point-up" class="block" size="25px" />
</button>

<script>
  const btn = document.getElementById("topButton")!;
  window.addEventListener(
    "scroll",
    () => {
      btn.classList.toggle("visible", window.scrollY > 20);
    },
    { passive: true }
  );
  btn.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
</script>
