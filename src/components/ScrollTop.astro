---
import Icon from "./Icon.astro";
---

<button
  id="topButton"
  class="hidden fixed bottom-[90px] right-[30px] z-[99] cursor-pointer rounded-[15px] border-none bg-navy p-[15px] text-white outline-none hover:bg-dusk-violet dark:bg-blue-light dark:text-navy dark:hover:bg-blue hover:transition-all hover:duration-200 hover:ease-in-out [&.visible]:block"
  aria-label="Back to top"
  title="Go to top"
>
  <Icon name="hand-point-up" class="block" size="25px" />
</button>

<script>
  const btn = document.getElementById("topButton");
  if (!btn) throw new Error("ScrollTop: #topButton is missing");
  const onScroll = () => btn.classList.toggle("visible", window.scrollY >= 20);
  // Firefox and Safari restore a reload's scroll position without a scroll event.
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
  btn.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
</script>
