---
import {greeting, typewriterRoles} from "../data/portfolio";
import SocialMedia from "./SocialMedia.astro";
import Button from "./Button.astro";
import Typewriter from "./Typewriter.astro";
// Developer-at-desk illustration from soumyajit4419/Portfolio (home-main.svg),
// used with the credit its README asks for — see the Credits section in this
// repo's README. Recolored purple → theme green at pixel level (selective hue
// rotate that preserves the skin tones); source art embedded a 775×817 PNG.
import heroDesk from "../assets/images/heroDesk.png";
---

<div class="greet-main section-animate" id="greeting">
  <div class="greeting-main">
    <div class="greeting-text-div">
      <div>
        <h1 class="greeting-text">
          <span class="greeting-hi">
            Hi There!
            <span class="wave-emoji">👋</span>
          </span>
          <span class="greeting-name">
            I'm <span class="accent">{greeting.username}</span>
          </span>
        </h1>
        <p class="greeting-roles"><Typewriter roles={typewriterRoles} /></p>
        <p class="greeting-text-p subTitle">{greeting.subTitle}</p>
        <div id="resume" class="empty-div"></div>
        <SocialMedia />
        <div class="button-greeting-div">
          <Button text="Contact me" href="#contact" />
          <Button
            text="Download my resume"
            href={greeting.resumePath}
            download="Murugappan-M-Resume.pdf"
          />
        </div>
      </div>
    </div>
    <div class="greeting-image-div">
      <img
        src={heroDesk.src}
        width={heroDesk.width}
        height={heroDesk.height}
        alt="Illustration of a developer coding at a desk with a laptop, coffee, and a plant"
        fetchpriority="high"
      />
    </div>
  </div>
</div>

<style lang="scss">
  @import "../styles/variables";

  .greet-main {
    width: 90%;
    padding: 20px 10px;
    margin: 0px auto;
    margin-top: 2rem;
  }

  .greeting-main {
    display: flex;
  }

  .greeting-main > * {
    flex: 1;
    margin-bottom: 30px;
  }

  .empty-div {
    margin-bottom: 40px;
  }

  .button-greeting-div {
    display: flex;
    margin-top: 40px;
  }

  .greeting-text {
    font-size: 70px;
    line-height: 1.1;
    color: $textColor;
  }

  /* reference hero: "Hi There! 👋" on its own line, then the name line with
     the accent highlight */
  .greeting-hi,
  .greeting-name {
    display: block;
  }

  .greeting-hi {
    font-size: 0.55em;
    margin-bottom: 12px;
  }

  .greeting-roles {
    font-size: 34px;
    line-height: 1.3;
    margin-top: 12px;
    min-height: 1.3em; /* reserve the line while roles type/delete */
  }

  .greeting-text-p {
    font-size: 30px;
    line-height: 40px;
  }

  /* old conditional `dark-mode greeting-text` classes, now driven by html.dark-mode */
  :global(html.dark-mode) .greeting-text,
  :global(html.dark-mode) .greeting-text-p {
    color: $textColorDark;
  }

  /* hero illustration (static img, the page's LCP element; width/height
     attributes reserve the box before load to avoid CLS) */
  .greeting-image-div {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .greeting-image-div img {
    width: 100%;
    max-width: 520px;
    height: auto;
  }

  .wave-emoji {
    animation-duration: 1.8s;
    animation-iteration-count: infinite;
    animation-name: wave;
    display: inline-block;
    transform-origin: 70% 70%;
  }

  @media (prefers-reduced-motion: reduce) {
    .wave-emoji {
      animation: none;
    }
  }

  @keyframes wave {
    0% {
      transform: rotate(0deg);
    }
    10% {
      transform: rotate(-10deg);
    }
    20% {
      transform: rotate(12deg);
    }
    30% {
      transform: rotate(-10deg);
    }
    40% {
      transform: rotate(9deg);
    }
    50% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(0deg);
    }
  }

  /* Media Query */
  @media (max-width: 1380px) {
    .greeting-text {
      font-size: 50px;
    }
    .greeting-roles {
      font-size: 26px;
    }
    .greeting-text-p {
      font-size: 20px;
    }
  }
  @media (max-width: 768px) {
    .greeting-roles {
      font-size: 20px;
      text-align: center;
    }
    .button-greeting-div {
      justify-content: space-around;
      /* the buttons' desktop margin-right is zeroed at this width (legacy
         developerFolio rule); without a gap they touch when the row is full */
      gap: 12px;
      flex-wrap: wrap;
    }
    .greeting-text {
      font-size: 30px;
      text-align: center;
    }
    .greeting-text-p {
      font-size: 16px;
      line-height: normal;
      text-align: center;
    }
    .greeting-main {
      display: block;
    }
    .greeting-image-div img {
      max-width: 300px;
    }
  }
</style>
