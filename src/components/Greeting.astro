---
import { greeting, typewriterRoles } from "../data/portfolio";
import SocialMedia from "./SocialMedia.astro";
import Button from "./Button.astro";
import Typewriter from "./Typewriter.astro";
import { Image } from "astro:assets";
// Developer-at-desk illustration from soumyajit4419/Portfolio (home-main.svg),
// used with the credit its README asks for — see the Credits section in this
// repo's README. Recolored purple → theme accent at pixel level (selective hue
// rotate that preserves the skin tones); source art embedded a 775×817 PNG.
import portrait from "../assets/images/portrait.webp";
---

{
  /* box-content: `width: 90%` + `padding: 20px 10px` was a content-box outer
  width of `90vw + 20px` before Preflight switched everything to border-box. */
}
<div class="greet-main section-animate mx-auto mt-8 box-content w-[90%] px-2.5 py-5" id="greeting">
  <div class="greeting-main flex max-md:block">
    <div class="greeting-text-div mb-[30px] flex-1">
      <div>
        {
          /* my-[0.67em] / my-[1em] below restore the browser default h1 and p
          margins that Preflight removes; the pre-Tailwind site relied on them. */
        }
        <h1
          class="greeting-text my-[0.67em] text-[70px] font-bold leading-[1.1] text-text dark:text-white max-wide:text-[50px] max-md:text-center max-md:text-[30px]"
        >
          <span class="greeting-hi mb-3 block text-[0.55em]">
            Hi There!
            <span
              class="wave-emoji inline-block origin-[70%_70%] animate-[wave_1.8s_infinite] motion-reduce:animate-none"
              >👋</span
            >
          </span>
          <span class="greeting-name block">
            I'm <span class="accent">{greeting.nickname}</span>
          </span>
        </h1>
        {/* min-h reserves the line while the roles type/delete */}
        <p
          class="greeting-roles mt-3 mb-[1em] min-h-[1.3em] text-[34px] leading-[1.3] max-wide:text-[26px] max-md:text-center max-md:text-[20px]"
        >
          <Typewriter roles={typewriterRoles} />
        </p>
        <p
          class="greeting-text-p subTitle my-[1em] text-[30px] leading-[40px] dark:text-white max-wide:text-[20px] max-md:text-center max-md:text-[16px] max-md:leading-[normal]"
        >
          {greeting.subTitle}
        </p>
        <div id="resume" class="empty-div mb-10"></div>
        <SocialMedia />
        {
          /* the buttons' desktop margin-right is zeroed at 768px (legacy
          developerFolio rule in Button.astro); without a gap they touch when
          the wrapped row is full */
        }
        <div
          class="button-greeting-div mt-10 flex max-md:flex-wrap max-md:justify-around max-md:gap-3"
        >
          <Button text="Contact me" href="#contact" event="contact_click" />
          <Button
            text="Download my resume"
            href={greeting.resumePath}
            download="Murugappan-M-Resume.pdf"
            event="resume_download"
          />
        </div>
      </div>
    </div>
    <div class="greeting-image-div mb-[30px] flex flex-1 items-center justify-center">
      {
        /* Rendered at up to 440px (2x → the 880px source) on wide screens and
          240px on phones (the 768px breakpoint below), so the srcset lets a
          phone take the 480px file instead of the full one. Eager + high
          priority: it is above the fold on every viewport.
          Round portrait with the site's navy ring and glow; box-content keeps
          the old content-box sizing so the 6px ring sits outside the 440px. */
      }
      <Image
        class="box-content aspect-square w-full max-w-[440px] rounded-full border-6 border-navy object-cover shadow-glow dark:border-blue dark:shadow-glow-dark max-md:max-w-[240px]"
        src={portrait}
        widths={[240, 480, 880]}
        sizes="(max-width: 768px) 240px, 440px"
        alt="Murugappan M smiling on a hilltop with arms outstretched"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</div>

<style>
  /* referenced by the `animate-[wave_1.8s_infinite]` utility on .wave-emoji */
  @keyframes wave {
    0% {
      transform: rotate(0deg);
    }
    10% {
      transform: rotate(-10deg);
    }
    20% {
      transform: rotate(12deg);
    }
    30% {
      transform: rotate(-10deg);
    }
    40% {
      transform: rotate(9deg);
    }
    50% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(0deg);
    }
  }
</style>
