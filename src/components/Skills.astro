---
import {skillsSection} from "../data/portfolio";
import LottiePlayer from "./LottiePlayer.astro";
import Icon from "./Icon.astro";
import Tilt from "./Tilt.astro";
import {accentTitle} from "../lib/accent";
---

<div id="skills" class="skills-main-div section-animate">
  <div class="skills-image-div">
    <Tilt>
      <LottiePlayer
        src="/lottie-coding.json"
        label="Illustration of a developer at a desk writing code"
      />
    </Tilt>
  </div>
  <div class="skills-text-div">
    <h2 class="skills-heading" set:html={accentTitle(skillsSection.title)} />
    <p class="subTitle skills-text-subtitle">{skillsSection.subTitle}</p>
    <div class="software-skills-main-div">
      <ul class="dev-icons">
        {
          skillsSection.softwareSkills.map(skill => (
            <li class="software-skill-chip">
              <Icon name={skill.iconName} />
              <span>{skill.skillName}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      {skillsSection.skills.map(s => <p class="subTitle skills-text">{s}</p>)}
    </div>
  </div>
</div>

<style lang="scss">
  @import "../styles/variables";

  /* old `.main` wrapper (width/padding/margins) folded into the section root */
  .skills-main-div {
    display: flex;
    width: 90%;
    padding: 20px 10px;
    margin: 0px auto;
    margin-top: 4rem;
    overflow: hidden;
  }

  .skills-text-div {
    margin-left: 50px;
  }

  .skills-main-div > * {
    flex: 1;
    margin-bottom: 30px;
  }

  /* sizing for the lazy lottie holder (old `.skills-image-div > img` equivalent);
     aspect-ratio reserves the animation's box (1600x1200) before load to avoid CLS */
  .skills-image-div :global(.lottie-holder) {
    width: 100%;
    max-width: 100%;
    aspect-ratio: 1600 / 1200;
  }

  .skills-heading {
    font-size: 56px;
    font-weight: 400;
    /* pin old h1 UA margin after demotion to h2 (h2 UA would be 0.83em) */
    margin: 0.67em 0;
  }

  /* old conditional `dark-mode` classes on heading/subtitle/skills lines */
  :global(html.dark-mode) .skills-heading,
  :global(html.dark-mode) .skills-text-subtitle,
  :global(html.dark-mode) .skills-text {
    color: $textColorDark;
  }

  /* tech-stack chips (reference "Professional Skillset" grid: rounded outline
     pills with logo + label, hover glow + brighter outline) */
  .dev-icons {
    padding-left: 0;
    list-style: none;
    margin: 0 0 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .software-skill-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    border: 1px solid $chipOutlineLight;
    border-radius: 24px;
    box-shadow: $glowShadowLight;
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  /* same hover as the Proficiency chips: glow + outline, no scale */
  .software-skill-chip:hover {
    border-color: $accentLight;
    box-shadow: $glowShadowLightHover;
  }

  .software-skill-chip > :global(svg) {
    color: $skillsColor;
    width: 1.6rem;
    height: 1.6rem;
    flex: none;
  }

  .software-skill-chip > span {
    color: $textColor;
    font-size: 15px;
    white-space: nowrap;
  }

  :global(html.dark-mode) .software-skill-chip {
    border-color: $chipOutlineDark;
    box-shadow: $glowShadowDark;
  }

  :global(html.dark-mode) .software-skill-chip:hover {
    border-color: $accentDark;
    box-shadow: $glowShadowDarkHover;
  }

  :global(html.dark-mode) .software-skill-chip > :global(svg) {
    color: $accentDark;
  }

  :global(html.dark-mode) .software-skill-chip > span {
    color: $textColorDark;
  }

  @media (prefers-reduced-motion: reduce) {
    .software-skill-chip {
      transition: none;
    }
  }

  /* Media Query */
  @media (max-width: 1380px) {
    .skills-heading {
      font-size: 40px;
    }
  }
  @media (max-width: 768px) {
    .skills-heading {
      font-size: 30px;
      text-align: center;
    }
    .skills-main-div {
      flex-direction: column;
    }
    .skills-text-div {
      margin-left: 0px;
      margin: 20px;
    }
    .skills-text {
      font-size: 16px;
    }
    .skills-text-subtitle {
      font-size: 16px;
      text-align: center;
    }
    .skills-image-div {
      order: 2;
    }
  }
  @media (max-width: 320px) {
    .skills-main-div {
      width: auto;
    }
  }
</style>
