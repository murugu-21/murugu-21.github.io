---
import { skillsSection } from "../data/portfolio";
import LottiePlayer from "./LottiePlayer.astro";
import Icon from "./Icon.astro";
import Tilt from "./Tilt.astro";
import { accentTitle } from "../lib/accent";
---

{/* box-content: w-[90%] excludes the padding, as before Preflight's border-box */}
<div
  id="skills"
  class="skills-main-div section-animate mx-auto mt-16 box-content flex w-[90%] overflow-hidden px-2.5 py-5 max-md:flex-col max-xs:w-auto"
>
  <div class="skills-image-div mb-[30px] flex-1 max-md:order-2">
    <Tilt>
      <LottiePlayer
        src="/lottie-coding.json"
        label="Illustration of a developer at a desk writing code"
      />
    </Tilt>
  </div>
  <div class="skills-text-div ml-[50px] mb-[30px] flex-1 max-md:m-5">
    {/* my-[0.67em]: h1 UA margin, kept after demotion to h2 */}
    <h2
      class="skills-heading my-[0.67em] text-[56px] font-normal dark:text-white max-wide:text-[40px] max-md:text-center max-md:text-[30px]"
      set:html={accentTitle(skillsSection.title)}
    />
    <p class="subTitle skills-text-subtitle my-[1em] dark:text-white max-md:text-center max-md:text-[16px]">
      {skillsSection.subTitle}
    </p>
    <div class="software-skills-main-div">
      <ul class="dev-icons mb-2.5 flex flex-wrap gap-3">
        {skillsSection.softwareSkills.map(skill => (
          <li class="software-skill-chip inline-flex items-center gap-2.5 rounded-3xl border border-chip-outline px-[18px] py-2.5 shadow-glow transition-[border-color,box-shadow] duration-300 ease-[ease] hover:border-navy hover:shadow-glow-hover motion-reduce:transition-none dark:border-chip-outline-dark dark:shadow-glow-dark dark:hover:border-blue dark:hover:shadow-glow-dark-hover">
            <Icon name={skill.iconName} size="1.6rem" class="shrink-0 text-navy dark:text-blue" />
            <span class="text-[15px] whitespace-nowrap text-text dark:text-white">
              {skill.skillName}
            </span>
          </li>
        ))}
      </ul>
    </div>
    <div>
      {skillsSection.skills.map(s => (
        <p class="subTitle skills-text my-[1em] dark:text-white max-md:text-[16px]">{s}</p>
      ))}
    </div>
  </div>
</div>

<style>
  /* aspect-ratio reserves the 1600x1200 animation box to avoid CLS; global
     because lottie-web renders into this div at runtime. */
  .skills-image-div :global(.lottie-holder) {
    width: 100%;
    max-width: 100%;
    aspect-ratio: 1600 / 1200;
  }
</style>
