---
import Button from "./Button.astro";
import { projectsSection, socialMediaLinks } from "../data/portfolio";
import { fetchPinnedRepos, formatRepoSize, type GithubRepo } from "../lib/github";
import { accentTitle } from "../lib/accent";

let repos = await fetchPinnedRepos();

// Dev-only preview. Until a repo is pinned on GitHub (and a token is present)
// the live fetch is empty, so `astro dev` shows one sample card to make the
// layout reviewable. Production renders only real pinned repos — and nothing
// at all if none are pinned — so this sample never ships.
const SAMPLE_REPO: GithubRepo = {
  id: "sample-eventform",
  name: "eventform",
  description:
    "Event-driven form builder — transactional outbox → Debezium CDC → Redpanda → idempotent webhook delivery. NestJS, Postgres (Neon), Cognito, AWS.",
  url: "https://github.com/murugu-21/eventform",
  homepageUrl: "https://eventform.murugappan.dev",
  forkCount: 0,
  diskUsage: 23456,
  primaryLanguage: { name: "TypeScript", color: "#3178c6" },
  stargazers: { totalCount: 0 },
  topics: ["event-driven", "kafka", "debezium-server", "nestjs", "reactjs", "aws-cdk"]
};
if (repos.length === 0 && import.meta.env.DEV) repos = [SAMPLE_REPO];

const show = projectsSection.display && repos.length > 0;
---

{
  show && (
    <div
      class="projects-section section-animate mx-auto mt-16 box-content w-[90%] px-2.5 py-5"
      id="projects"
    >
      <div class="projects-header">
        <h2
          class="heading projects-heading m-0 text-[56px] leading-[normal] font-normal dark:text-white max-wide:text-[40px] max-md:text-center max-md:text-[30px]"
          set:html={accentTitle(projectsSection.title)}
        />
        <p class="subTitle projects-subtitle m-0 mb-[50px] uppercase dark:text-white max-md:text-center max-md:text-[16px] max-md:leading-[normal]">
          {projectsSection.subtitle}
        </p>
      </div>
      <div class="repo-cards-div-main grid grid-cols-[repeat(auto-fit,minmax(400px,1fr))] gap-4 max-md:grid-cols-[repeat(auto-fit,minmax(300px,1fr))]">
        {repos.map(repo => (
          <a
            class="repo-card-div glow-card flex flex-col cursor-pointer p-8 text-repo-text no-underline dark:text-white"
            href={repo.url}
            target="_blank"
            rel="noopener noreferrer"
            data-ph-event="project_click"
            data-ph-prop="project"
            data-ph-value={repo.name}
          >
            <div class="repo-name-div flex items-center">
              {/* no fill utility in light mode: the path keeps the SVG default (black) */}
              <svg
                class="repo-svg mr-2 min-w-4 dark:fill-white"
                aria-hidden="true"
                height="20"
                viewBox="0 0 12 16"
                width="14"
              >
                <path
                  fill-rule="evenodd"
                  d="M4 9H3V8h1v1zm0-3H3v1h1V6zm0-2H3v1h1V4zm0-2H3v1h1V2zm8-1v12c0 .55-.45 1-1 1H6v2l-1.5-1.5L3 16v-2H1c-.55 0-1-.45-1-1V1c0-.55.45-1 1-1h10c.55 0 1 .45 1 1zm-1 10H1v2h2v-1h3v1h5v-2zm0-10H2v9h9V1z"
                />
              </svg>
              <p class="repo-name m-0 h-[30px] overflow-hidden text-[25px] font-bold tracking-[-0.5px] overflow-ellipsis whitespace-nowrap text-repo-name dark:text-white">
                {repo.name}
              </p>
            </div>
            <p class="repo-description my-3 line-clamp-2">{repo.description}</p>
            {repo.topics.length > 0 && (
              <div class="repo-topics mb-4 flex flex-wrap gap-[0.4rem]">
                {repo.topics.map(t => (
                  <span class="repo-topic rounded-[999px] bg-[rgba(6,3,141,0.1)] px-[0.6rem] py-[0.1rem] text-[0.72rem] leading-[1.6] whitespace-nowrap text-navy dark:bg-[rgba(76,125,255,0.14)] dark:text-blue">
                    {t}
                  </span>
                ))}
              </div>
            )}
            <div class="repo-stats mt-auto flex justify-between text-[13px] text-repo-stats dark:text-white">
              <div class="repo-left-stat flex grow">
                {repo.primaryLanguage && (
                  <span class="mr-3 flex items-center">
                    <div
                      class="language-color mr-1 size-2.5 rounded-full bg-repo-lang"
                      style={`background-color:${repo.primaryLanguage.color}`}
                    />
                    <p class="m-0">{repo.primaryLanguage.name}</p>
                  </span>
                )}
                <span class="mr-3 flex items-center">
                  <svg
                    class="repo-star-svg mr-[0.3rem]"
                    aria-hidden="true"
                    height="20"
                    viewBox="0 0 10 16"
                    width="12"
                    fill="rgb(106, 115, 125)"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M8 1a1.993 1.993 0 0 0-1 3.72V6L5 8 3 6V4.72A1.993 1.993 0 0 0 2 1a1.993 1.993 0 0 0-1 3.72V6.5l3 3v1.78A1.993 1.993 0 0 0 5 15a1.993 1.993 0 0 0 1-3.72V9.5l3-3V4.72A1.993 1.993 0 0 0 8 1zM2 4.2C1.34 4.2.8 3.65.8 3c0-.65.55-1.2 1.2-1.2.65 0 1.2.55 1.2 1.2 0 .65-.55 1.2-1.2 1.2zm3 10c-.66 0-1.2-.55-1.2-1.2 0-.65.55-1.2 1.2-1.2.65 0 1.2.55 1.2 1.2 0 .65-.55 1.2-1.2 1.2zm3-10c-.66 0-1.2-.55-1.2-1.2 0-.65.55-1.2 1.2-1.2.65 0 1.2.55 1.2 1.2 0 .65-.55 1.2-1.2 1.2z"
                    />
                  </svg>
                  <p class="m-0">{repo.forkCount}</p>
                </span>
                <span class="mr-3 flex items-center">
                  <svg
                    class="repo-star-svg mr-[0.3rem]"
                    aria-hidden="true"
                    height="20"
                    viewBox="0 0 14 16"
                    width="14"
                    fill="rgb(106, 115, 125)"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M14 6l-4.9-.64L7 1 4.9 5.36 0 6l3.6 3.26L2.67 14 7 11.67 11.33 14l-.93-4.74L14 6z"
                    />
                  </svg>
                  <p class="m-0">{repo.stargazers.totalCount}</p>
                </span>
              </div>
              <div class="repo-right-stat">
                <p class="m-0">{formatRepoSize(repo.diskUsage)}</p>
              </div>
            </div>
          </a>
        ))}
      </div>
      <Button
        text="More Projects"
        href={socialMediaLinks.github}
        newTab={true}
        event="more_projects_click"
      />
    </div>
  )
}
