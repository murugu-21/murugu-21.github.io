---
import {workExperiences} from "../data/portfolio";
import {accentTitle} from "../lib/accent";
import {groupByCompany} from "../lib/experience";

// One card per company stint, roles stacked inside as a promotion ladder.
const stints = groupByCompany(workExperiences).map(stint => ({
  ...stint,
  logo: stint.roles[0].companyLogo
}));
---

<div id="experience">
  <div class="experience-container section-animate" id="workExperience">
    <div>
      <h2 class="experience-heading" set:html={accentTitle("Experiences")} />
      <ol class="stints">
        {
          stints.map(stint => (
            <li class="stint">
              <header class="stint-header">
                <img
                  class="stint-logo"
                  src={stint.logo.src}
                  width={stint.logo.width}
                  height={stint.logo.height}
                  alt={stint.company + " logo"}
                  loading="lazy"
                />
                <div>
                  <h3 class="stint-company">{stint.company}</h3>
                  <p class="stint-meta subTitle">
                    {stint.span}
                    {stint.location && <span> · {stint.location}</span>}
                  </p>
                </div>
              </header>

              <ol class="roles">
                {stint.roles.map(role => (
                  <li class="role">
                    <div class="role-head">
                      <h4 class="role-title">{role.role}</h4>
                      {/* a lone role's date already sits in the card header */}
                      {stint.roles.length > 1 && (
                        <p class="role-date subTitle">
                          {role.date}
                          {!stint.location && <span> · {role.location}</span>}
                        </p>
                      )}
                    </div>
                    <p class="role-desc">{role.desc}</p>
                    {role.descBullets?.length ? (
                      <details class="role-details">
                        <summary class="role-summary">
                          <span
                            class="role-summary-chevron"
                            aria-hidden="true"
                          />
                          {role.descBullets.length}{" "}
                          {role.descBullets.length === 1
                            ? "highlight"
                            : "highlights"}
                        </summary>
                        <ul class="role-bullets">
                          {role.descBullets.map(item => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      </details>
                    ) : null}
                  </li>
                ))}
              </ol>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</div>

<style lang="scss">
  @import "../styles/variables";

  .experience-heading {
    font-size: 56px;
    font-weight: 400;
    /* pin old h1 UA margin after demotion to h2 (h2 UA would be 0.83em) */
    margin: 0.67em 0;
  }

  .experience-container {
    display: flex;
    width: 90%;
    max-width: 960px;
    padding: 20px 10px;
    margin: 0px auto;
    margin-top: 2rem;
  }

  .experience-container > * {
    flex: 1;
  }

  .stints,
  .roles,
  .role-bullets {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .stints {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* ---- company card ---- */

  .stint {
    padding: 1.5rem 1.75rem;
    color: $textColor;
    @include glow-card-light;
  }

  /* glow only on hover: a full-width card scaling up reads as a jump */
  .stint:hover {
    @include glow-card-light-hover;
    transform: none;
  }

  .stint-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .stint-logo {
    flex: none;
    width: 4.5rem;
    height: 4.5rem;
    object-fit: cover;
    border-radius: 50%;
    box-shadow: 0 0.5rem 1rem $lightBoxShadowDarker;
  }

  .stint-company {
    margin: 0;
    font-size: 25px;
    font-weight: 700;
    line-height: 1.2;
  }

  .stint-meta {
    margin: 0.25rem 0 0;
    font-size: 16px;
  }

  /* ---- promotion ladder ---- */

  .roles {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    /* room for the rail: dot column + gap */
    margin-left: calc(4.5rem / 2 - 0.35rem);
    padding-left: 1.6rem;
  }

  .role {
    position: relative;
  }

  /* dot */
  .role::before {
    content: "";
    position: absolute;
    left: -1.6rem;
    top: 0.45rem;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: $buttonColor;
    box-shadow: 0 0 0 3px rgba(5, 123, 1, 0.18);
  }

  /* connector from this dot down to the next role's dot */
  .role::after {
    content: "";
    position: absolute;
    left: calc(-1.6rem + 0.35rem - 1px);
    top: 1.15rem;
    bottom: -1.25rem;
    width: 2px;
    background: rgba(5, 123, 1, 0.25);
  }

  .role:last-child::after {
    display: none;
  }

  .role-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }

  .role-title {
    margin: 0;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.3;
  }

  .role-date {
    margin: 0;
    font-size: 15px;
    white-space: nowrap;
  }

  .role-desc {
    margin: 0.4rem 0 0;
    font-size: 16px;
    line-height: 1.5;
  }

  /* ---- highlights disclosure ---- */

  .role-details {
    margin-top: 0.5rem;
  }

  .role-summary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    list-style: none;
    font-size: 15px;
    font-weight: 600;
    color: $buttonColor;
    user-select: none;
  }

  .role-summary::-webkit-details-marker {
    display: none;
  }

  .role-summary:hover {
    color: $buttonHover;
  }

  .role-summary:focus-visible {
    outline: 2px solid $buttonHover;
    outline-offset: 3px;
    border-radius: 4px;
  }

  .role-summary-chevron {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 0.2s ease;
    margin-bottom: 2px;
  }

  .role-details[open] .role-summary-chevron {
    transform: rotate(45deg);
    margin-bottom: 0;
    margin-top: -2px;
  }

  .role-bullets {
    margin: 0.6rem 0 0;
    padding-left: 1.25rem;
    list-style: disc;
    font-size: 16px;
    line-height: 1.55;
  }

  .role-bullets li + li {
    margin-top: 0.4rem;
  }

  /* ---- dark mode ---- */

  :global(html.dark-mode) .stint {
    @include glow-card-dark;
  }
  :global(html.dark-mode) .stint:hover {
    @include glow-card-dark-hover;
    transform: none;
  }
  :global(html.dark-mode) .stint-meta,
  :global(html.dark-mode) .role-date {
    color: rgba(255, 255, 255, 0.65);
  }
  :global(html.dark-mode) .role-summary {
    color: $buttonHover;
  }
  :global(html.dark-mode) .role-summary:hover {
    color: $textColorDark;
  }
  :global(html.dark-mode) .role::before {
    background: $buttonHover;
    box-shadow: 0 0 0 3px rgba(44, 207, 39, 0.2);
  }
  :global(html.dark-mode) .role::after {
    background: rgba(44, 207, 39, 0.3);
  }

  @media (prefers-reduced-motion: reduce) {
    .stint,
    .stint:hover,
    .role-summary-chevron {
      transition: none;
    }
  }

  /* ---- responsive ---- */

  @media (max-width: 1380px) {
    .experience-heading {
      font-size: 40px;
    }
  }

  @media (max-width: 768px) {
    .experience-heading {
      font-size: 30px;
      text-align: center;
    }
    .stint {
      padding: 1.25rem 1rem;
    }
    .stint-logo {
      width: 3rem;
      height: 3rem;
    }
    .stint-company {
      font-size: 21px;
    }
    .roles {
      margin-left: calc(3rem / 2 - 0.35rem);
      padding-left: 1.4rem;
    }
    .role::before {
      left: -1.4rem;
    }
    .role::after {
      left: calc(-1.4rem + 0.35rem - 1px);
    }
    .role-title {
      font-size: 18px;
    }
    .role-date {
      white-space: normal;
    }
  }
</style>
