---
// Glyphs from one hashed SVG sprite (src/assets/icons.svg, attributions in its
// header). fill="currentColor" cascades into the <use>d symbol.
import sprite from "#src/assets/icons.svg?url";
import spriteSource from "#src/assets/icons.svg?raw";

interface Props {
  name: string;
  class?: string;
  size?: string;
}
const { name, class: cls, size = "1em" } = Astro.props;
// A typo'd icon name fails the build instead of shipping an empty icon.
if (!spriteSource.includes(`<symbol id="${name}"`)) {
  throw new Error(`Icon "${name}" not defined in src/assets/icons.svg`);
}
---

<svg class={cls} width={size} height={size} fill="currentColor" aria-hidden="true">
  <use href={`${sprite}#${name}`}></use>
</svg>
