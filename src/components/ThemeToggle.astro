---
// Theme toggle: modelled on the react.dev header control — a round ghost icon
// button showing the theme you'd switch TO (sun while dark, moon while light)
// rather than a slider. Icons are the lucide sun/moon paths, inlined.
//
// Shared by BOTH apps, which have different theme contracts (the same split
// islands.css encodes as `html.dark-mode` vs `body.dark`):
//   portfolio — owns the class itself, writes localStorage directly
//   blog      — a pre-paint bootstrap owns it and exposes __setPreferredTheme
// The script below detects which is present. Being plain Astro, it is server
// rendered at full size, so unlike a hydrated island it can't shift the
// header after paint.
---

<button type="button" id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
  <svg
    class="icon sun"
    xmlns="http://www.w3.org/2000/svg"
    width="28"
    height="28"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>
  <svg
    class="icon moon"
    xmlns="http://www.w3.org/2000/svg"
    width="28"
    height="28"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path
      d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"
    ></path>
  </svg>
</button>

<script>
  import { tag } from "../lib/analytics";

  const btn = document.getElementById("theme-toggle") as HTMLButtonElement;
  const root = document.documentElement;

  const isDark = () =>
    root.classList.contains("dark-mode") || document.body.classList.contains("dark");

  // The label names the action, so it tracks the theme rather than the state.
  const label = () => btn.setAttribute("aria-label", isDark() ? "Use light mode" : "Use dark mode");
  label();

  btn.addEventListener("click", () => {
    const next = isDark() ? "light" : "dark";
    if (window.__setPreferredTheme) {
      // Blog: the bootstrap owns the class, persistence and `themechange`.
      window.__setPreferredTheme(next);
    } else {
      root.classList.toggle("dark-mode", next === "dark");
      try {
        localStorage.setItem("isDark", JSON.stringify(next === "dark"));
      } catch {}
    }
    label();
    // A super property, not an event: the point is segmenting by the theme
    // the visitor actually read the site in.
    tag("theme", next);
  });

  // The blog can change theme from elsewhere (OS preference); keep up.
  window.addEventListener("themechange", label);
</script>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: 9999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition:
      transform 0.15s ease,
      background-color 0.15s ease;
  }

  /* Tinted from the icon's own colour, so it works in both themes without a
     second variable. */
  .theme-toggle:hover {
    background-color: color-mix(in srgb, currentColor 10%, transparent);
  }

  .theme-toggle:active {
    transform: scale(0.95);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .icon {
    display: block;
  }

  /* Show the theme you'd switch TO: sun while dark, moon while light. */
  .sun {
    display: none;
  }

  :global(html.dark-mode) .sun,
  :global(body.dark) .sun {
    display: block;
  }

  :global(html.dark-mode) .moon,
  :global(body.dark) .moon {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle {
      transition: none;
    }
    .theme-toggle:active {
      transform: none;
    }
  }
</style>
