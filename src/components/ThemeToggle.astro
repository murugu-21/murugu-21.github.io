---
// Shows the theme you'd switch TO. Shared by both apps: clicks go through
// window.__setPreferredTheme (../lib/theme.ts); the label follows the `themechange` event.
// Plain Astro, not an island, so it can't shift the header after paint.
// The hover tint mixes the icon's own colour, so one class covers both themes.
---

<button
  type="button"
  id="theme-toggle"
  class="flex size-12 cursor-pointer items-center justify-center rounded-full border-0 bg-transparent p-0 text-inherit transition-[scale,background-color] duration-150 ease-[ease] hover:bg-[color-mix(in_srgb,currentColor_10%,transparent)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current motion-safe:active:scale-95 motion-reduce:transition-none"
  aria-label="Toggle theme"
>
  <svg
    class="hidden dark:block"
    width="28"
    height="28"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>
  <svg
    class="block dark:hidden"
    width="28"
    height="28"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"></path>
  </svg>
</button>

<script>
  import { currentTheme } from "#src/lib/theme.ts";

  const btn = document.getElementById("theme-toggle");
  if (!btn) throw new Error("ThemeToggle: #theme-toggle is missing");

  // The label names the action, so it tracks the theme rather than the state.
  const label = () =>
    btn.setAttribute("aria-label", currentTheme() === "dark" ? "Use light mode" : "Use dark mode");
  label();

  btn.addEventListener("click", () =>
    window.__setPreferredTheme(currentTheme() === "dark" ? "light" : "dark")
  );
  window.addEventListener("themechange", label);
</script>
