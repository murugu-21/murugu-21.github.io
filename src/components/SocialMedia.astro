---
import {socialMediaLinks} from "../data/portfolio";
import Icon from "./Icon.astro";
---

<div class="social-media-div">
  <a
    href={socialMediaLinks.github}
    class="icon-button github"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="GitHub profile"
  >
    <Icon name="github" />
  </a>
  <a
    href={socialMediaLinks.linkedin}
    class="icon-button linkedin"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="LinkedIn profile"
  >
    <Icon name="linkedin-in" />
  </a>
  <a
    href={`mailto:${socialMediaLinks.gmail}`}
    class="icon-button google"
    aria-label="Send an email"
  >
    <Icon name="envelope" />
  </a>
  <a
    href={socialMediaLinks.twitter}
    class="icon-button twitter"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="X (formerly Twitter) profile"
  >
    <Icon name="twitter" />
  </a>
  <a
    href={socialMediaLinks.rss}
    class="icon-button rss"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Subscribe to the blog RSS feed"
  >
    <Icon name="rss" />
  </a>
</div>

<style lang="scss">
  @import "../styles/variables";

  .social-media-div {
    font-size: 2em;
  }

  /* The anchor is the 2.6rem circle and the svg a plain 1.3rem glyph inside
     it. Putting padding + border-radius on the <svg> itself (the old FA <i>
     translation) made Chrome clip the glyph to the radius inset by the
     padding, which shaved the corners off the LinkedIn "i" dot. */
  .icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    margin: 0 5px 10px;
    border-radius: 50%;
    color: $textColorDark;
    text-decoration: none;
    cursor: pointer;
    vertical-align: middle;
    user-select: none;
    transition: background-color 0.2s ease-in;
  }

  .icon-button :global(svg) {
    display: block;
    width: 1.3rem;
    height: 1.3rem;
  }

  .linkedin {
    background-color: $linkedin;
  }

  .github {
    background-color: $github;
  }

  .google {
    background-color: $google;
  }

  .twitter {
    background-color: $twitter;
  }

  .rss {
    background-color: $rss;
  }

  /* Hover Transition */
  .icon-button:hover {
    background-color: $buttonColor; // theme green; was $textColor (#2e353f) which blended into the dark background
  }

  /* Media Query */
  @media (max-width: 768px) {
    .social-media-div {
      text-align: center;
    }
  }
</style>
