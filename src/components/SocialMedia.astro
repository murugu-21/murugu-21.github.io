---
import { socialMediaLinks } from "../data/portfolio";
import Icon from "./Icon.astro";

// Monochrome glyphs in the section's text color, same treatment as the blog
// footer (src/blog/components/Bio.astro), instead of per-brand colored discs.
const links = [
  {
    href: socialMediaLinks.github,
    icon: "github",
    value: "github",
    label: "GitHub profile",
    external: true
  },
  {
    href: socialMediaLinks.linkedin,
    icon: "linkedin-in",
    value: "linkedin",
    label: "LinkedIn profile",
    external: true
  },
  {
    href: `mailto:${socialMediaLinks.gmail}`,
    icon: "envelope",
    value: "email",
    label: "Send an email",
    external: false
  },
  {
    href: socialMediaLinks.twitter,
    icon: "twitter",
    value: "x",
    label: "X (formerly Twitter) profile",
    external: true
  },
  {
    href: socialMediaLinks.rss,
    icon: "rss",
    value: "rss",
    label: "Subscribe to the blog RSS feed",
    external: true
  }
];
---

<div class="social-media-div max-md:text-center">
  {
    links.map(link => (
      <a
        href={link.href}
        data-ph-event="social_click"
        data-ph-prop="social"
        data-ph-value={link.value}
        class="icon-button inline-flex items-center justify-center w-[2.6rem] h-[2.6rem] mx-[5px] mb-2.5 text-text no-underline cursor-pointer align-middle select-none transition-colors duration-200 ease-in hover:text-navy dark:text-white dark:hover:text-blue"
        target={link.external ? "_blank" : undefined}
        rel={link.external ? "noopener noreferrer" : undefined}
        aria-label={link.label}
        title={link.label}
      >
        {/* The anchor keeps a 2.6rem hit target; the svg is a plain glyph
            inside it. Putting padding + border-radius on the <svg> itself
            (the old FA <i> translation) made Chrome clip the glyph to the
            radius inset by the padding, which shaved the corners off the
            LinkedIn "i" dot. */}
        <Icon name={link.icon} class="block" size="1.6rem" />
      </a>
    ))
  }
</div>
