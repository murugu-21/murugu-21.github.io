---
import { socialMediaLinks } from "../data/portfolio";
import Icon from "./Icon.astro";

// Monochrome glyphs in the section's text color, same treatment as the blog
// footer (src/blog/components/Bio.astro), instead of per-brand colored discs.
const links = [
  {
    href: socialMediaLinks.github,
    icon: "github",
    value: "github",
    label: "GitHub profile",
    external: true
  },
  {
    href: socialMediaLinks.linkedin,
    icon: "linkedin-in",
    value: "linkedin",
    label: "LinkedIn profile",
    external: true
  },
  {
    href: `mailto:${socialMediaLinks.gmail}`,
    icon: "envelope",
    value: "email",
    label: "Send an email",
    external: false
  },
  {
    href: socialMediaLinks.twitter,
    icon: "twitter",
    value: "x",
    label: "X (formerly Twitter) profile",
    external: true
  },
  {
    href: socialMediaLinks.rss,
    icon: "rss",
    value: "rss",
    label: "Subscribe to the blog RSS feed",
    external: true
  }
];
---

<div class="social-media-div">
  {
    links.map(link => (
      <a
        href={link.href}
        data-ph-event="social_click"
        data-ph-prop="social"
        data-ph-value={link.value}
        class="icon-button"
        target={link.external ? "_blank" : undefined}
        rel={link.external ? "noopener noreferrer" : undefined}
        aria-label={link.label}
        title={link.label}
      >
        <Icon name={link.icon} />
      </a>
    ))
  }
</div>

<style lang="scss">
  @import "../styles/variables";

  /* The anchor keeps a 2.6rem hit target; the svg is a plain glyph inside it.
     Putting padding + border-radius on the <svg> itself (the old FA <i>
     translation) made Chrome clip the glyph to the radius inset by the
     padding, which shaved the corners off the LinkedIn "i" dot. */
  .icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    margin: 0 5px 10px;
    color: $textColor;
    text-decoration: none;
    cursor: pointer;
    vertical-align: middle;
    user-select: none;
    transition: color 0.2s ease-in;
  }

  .icon-button :global(svg) {
    display: block;
    width: 1.6rem;
    height: 1.6rem;
  }

  .icon-button:hover {
    color: $buttonColor;
  }

  :global(html.dark-mode) .icon-button {
    color: $textColorDark;
  }

  :global(html.dark-mode) .icon-button:hover {
    color: $buttonHover;
  }

  /* Media Query */
  @media (max-width: 768px) {
    .social-media-div {
      text-align: center;
    }
  }
</style>
