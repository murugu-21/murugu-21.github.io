---
import SocialMedia from "./SocialMedia.astro";
import { contactInfo, isHireable } from "../data/portfolio";
import { fetchGithubProfile } from "../lib/github";
import { accentTitle } from "../lib/accent";
import { resumeContact } from "../data/resume";

const prof = await fetchGithubProfile();
// The site's own wording ("Bangalore, India") rather than whatever the GitHub
// profile's location field says.
const location = resumeContact.location;
---

{
  prof ? (
    <div class="main section-animate box-content mx-auto mt-16 w-[90%] px-2.5 py-5" id="contact">
      <h2
        class="prof-title m-0 text-[40px] font-normal max-md:pb-4 max-md:text-center max-md:text-[32px]"
        set:html={accentTitle("Reach Out to me!")}
      />
      <div class="main-content-profile max-md:text-center">
        <div class="blog-header">
          {/* .subTitle is the shared global class (color only); the rest of
              the old .blog-subtitle rule (recreated from the old app's leaked
              global) is inlined here. my-[1em] restores the UA <p> margin
              preflight removes. */}
          <p class="subTitle blog-subtitle my-[1em] uppercase max-md:text-center max-md:text-[16px]">
            {contactInfo.subtitle}
          </p>
        </div>
        {prof.bio && (
          <h2 class="bio-text text-[22px] font-bold leading-[30px] max-md:text-[16px] my-[0.83em]">
            "{prof.bio}"
          </h2>
        )}
        {location && (
          <div class="location-div">
            <span class="desc-prof text-[19px] leading-[45px] max-md:text-[16px] max-md:leading-[30px]">
              {/* old CSS never set a `display` on this svg and relied on it
                  staying inline (baseline for .desc-prof's text) — preflight
                  makes svg a block, so restore it here to keep the icon on
                  the same line as the location text. */}
              <svg
                class="inline align-baseline"
                viewBox="-0.5 -2 20 19"
                version="1.1"
                width="22"
                height="16"
                aria-hidden="true"
                stroke="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M6 0C2.69 0 0 2.5 0 5.5 0 10.02 6 16 6 16s6-5.98 6-10.5C12 2.5 9.31 0 6 0zm0 14.55C4.14 12.52 1 8.44 1 5.5 1 3.02 3.25 1 6 1c1.34 0 2.61.48 3.56 1.36.92.86 1.44 1.97 1.44 3.14 0 2.94-3.14 7.02-5 9.05zM8 5.5c0 1.11-.89 2-2 2-1.11 0-2-.89-2-2 0-1.11.89-2 2-2 1.11 0 2 .89 2 2z"
                />
              </svg>
              {location}
            </span>
          </div>
        )}
        {/* "Open for opportunities" intentionally hidden — avoids signalling
              job-seeking to visitors landing here from LinkedIn/X. Uncomment to
              restore (`isHireable` still drives the Yes/No). */}
        {/* <div class="opp-div">
            <span class="desc-prof">
              Open for opportunities: {isHireable ? "Yes" : "No"}
            </span>
          </div> */}
        <SocialMedia />
      </div>
    </div>
  ) : (
    <div class="main section-animate box-content mx-auto mt-16 w-[90%] px-2.5 py-5" id="contact">
      <div class="contact-div-main flex [&>*]:flex-1">
        <div class="contact-header">
          <h2
            class="heading contact-title my-[0.67em] text-[65px] font-normal max-wide:text-center max-wide:text-[40px]"
            set:html={accentTitle(contactInfo.title)}
          />
          <p class="subTitle contact-subtitle my-[1em] uppercase dark:text-white max-wide:text-center max-wide:text-[16px] max-wide:leading-[normal]">
            {contactInfo.subtitle}
          </p>
          <div class="contact-text-div mt-6 max-wide:text-center dark:text-white">
            {contactInfo.number && (
              <>
                <a
                  class="contact-detail mt-5 text-[40px] font-normal text-subtitle no-underline hover:text-text hover:[text-shadow:2px_1px_2px_var(--color-contact-hover)] hover:transition-all hover:duration-300 hover:ease-[ease] dark:text-white max-wide:text-[20px]"
                  href={"tel:" + contactInfo.number}
                  data-ph-event="social_click"
                  data-ph-prop="social"
                  data-ph-value="phone"
                >
                  {contactInfo.number}
                </a>
                <br />
                <br />
              </>
            )}
            <a
              class="contact-detail-email mt-5 text-[40px] font-normal text-subtitle no-underline hover:text-text hover:[text-shadow:2px_1px_2px_var(--color-contact-hover)] hover:transition-all hover:duration-300 hover:ease-[ease] dark:text-white max-wide:text-[20px]"
              href={"mailto:" + contactInfo.emailAddress}
              data-ph-event="social_click"
              data-ph-prop="social"
              data-ph-value="email"
            >
              {contactInfo.emailAddress}
            </a>
            <br />
            <br />
            <SocialMedia />
          </div>
        </div>
        {/* the old Contact had a .contact-image-div with an email lottie;
            email.json was dropped deliberately, so the column is omitted
            (`.contact-div-main > *` flex still lays out the text block) */}
      </div>
    </div>
  )
}
