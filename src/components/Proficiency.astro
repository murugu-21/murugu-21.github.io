---
import { techStack } from "../data/portfolio";
import { accentTitle } from "../lib/accent";
import Icon from "./Icon.astro";
---

{
  /* box-content: old `.proficiency-container` was `width: 90%` + `padding:
  20px 10px` under content-box; keep that outer width now Preflight is
  border-box. */
}
<div
  class="proficiency-container section-animate box-content mx-auto mt-8 flex w-[90%] px-2.5 py-5"
  id="proficiency"
>
  <div class="flex-1">
    {/* my-[0.67em] pins the old h1 UA margin kept after demotion to h2 */}
    <h2
      class="proficiency-heading my-[0.67em] text-[56px] font-normal max-wide:text-[40px] max-md:text-center max-md:text-[30px]"
      set:html={accentTitle("Proficiency")}
    />
    <dl class="areas m-0 flex flex-col gap-4">
      {
        techStack.experience.map(exp => (
          <div class="area grid grid-cols-[12rem_1fr] items-center gap-x-6 gap-y-2 max-md:grid-cols-1 max-md:gap-[0.4rem]">
            <dt class="area-name m-0 text-[18px] font-semibold text-text max-md:text-[16px] dark:text-white">
              {exp.stack}
            </dt>
            <dd class="area-tools m-0">
              <ul class="chips m-0 flex list-none flex-wrap gap-2 p-0">
                {exp.tools.map(tool => (
                  <li class="chip inline-flex items-center gap-2 rounded-[20px] border border-chip-outline px-3.5 py-1.5 text-[14px] whitespace-nowrap text-text shadow-glow transition-[border-color,box-shadow] duration-300 ease-[ease] hover:border-navy hover:shadow-glow-hover motion-reduce:transition-none dark:border-chip-outline-dark dark:text-white dark:shadow-glow-dark dark:hover:border-blue dark:hover:shadow-glow-dark-hover">
                    <Icon name={tool.icon} size="1.1rem" class="shrink-0 text-navy" />
                    <span>{tool.name}</span>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</div>
