---
import { skillsSection } from "#src/data/portfolio.ts";
import LottiePlayer from "./LottiePlayer.astro";
import Icon from "#src/components/Icon.astro";
import Tilt from "./Tilt.astro";
import { accentTitle } from "#src/lib/accent.ts";
import Section from "./Section.astro";
---

<Section id="skills" class="mt-16 flex overflow-hidden max-md:flex-col max-xs:w-auto">
  <div class="mb-7.5 flex-1 max-md:order-2">
    <Tilt>
      <LottiePlayer
        src="/lottie-coding.json"
        label="Illustration of a developer at a desk writing code"
      />
    </Tilt>
  </div>
  <div class="mb-7.5 ml-12.5 flex-1 max-md:m-5">
    {/* my-[0.67em]: h1 UA margin, kept after demotion to h2 */}
    <h2
      class="my-[0.67em] text-[56px] font-normal max-wide:text-[40px] max-md:text-center max-md:text-[30px] dark:text-white"
      set:html={accentTitle(skillsSection.title)}
    />
    <p class="my-[1em] text-subtitle max-md:text-center max-md:text-[16px] dark:text-white">
      {skillsSection.subTitle}
    </p>
    <div>
      <ul class="mb-2.5 flex flex-wrap gap-3">
        {skillsSection.softwareSkills.map(skill => (
          <li class="inline-flex items-center gap-2.5 rounded-3xl border border-chip-outline px-4.5 py-2.5 shadow-glow transition-[border-color,box-shadow] duration-300 ease-[ease] hover:border-navy hover:shadow-glow-hover motion-reduce:transition-none dark:border-chip-outline-dark dark:shadow-glow-dark dark:hover:border-blue dark:hover:shadow-glow-dark-hover">
            <Icon name={skill.iconName} size="1.6rem" class="shrink-0 text-navy dark:text-blue" />
            <span class="text-[15px] whitespace-nowrap text-text dark:text-white">
              {skill.skillName}
            </span>
          </li>
        ))}
      </ul>
    </div>
    <div>
      {skillsSection.skills.map(s => (
        <p class="my-[1em] text-subtitle max-md:text-[16px] dark:text-white">{s}</p>
      ))}
    </div>
  </div>
</Section>
