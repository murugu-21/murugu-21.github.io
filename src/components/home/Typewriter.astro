---
// The first role is server-rendered so no-JS and reduced-motion visitors see it.
interface Props {
  roles: string[];
}
const { roles } = Astro.props;
---

<span
  class="font-semibold text-navy dark:text-blue"
  data-typewriter
  data-roles={JSON.stringify(roles)}
>
  <span data-typewriter-text>{roles[0]}</span>
  <span
    class="ml-0.5 animate-typewriter-blink font-normal motion-reduce:animate-none max-md:hidden"
    aria-hidden="true"
  >
    |
  </span>
</span>

<script>
  import { parseStringArray } from "#src/lib/data-attributes.ts";

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>("[data-typewriter]").forEach(el => {
    if (reduced) return;
    const roles = parseStringArray(el.dataset.roles || "[]");
    const text = el.querySelector<HTMLElement>("[data-typewriter-text]");
    if (!text || roles.length < 2) return;

    let index = 0;
    let pos = roles[0].length;
    let deleting = true; // the SSR'd role is fully typed; pause, then delete

    const tick = () => {
      const current = roles[index % roles.length];
      pos += deleting ? -1 : 1;
      text.textContent = current.slice(0, pos);
      let delay = deleting ? 40 : 85;
      if (deleting && pos === 0) {
        deleting = false;
        index++;
        delay = 400;
      } else if (!deleting && pos === current.length) {
        deleting = true;
        delay = 1700;
      }
      setTimeout(tick, delay);
    };
    setTimeout(tick, 1700);
  });
</script>
