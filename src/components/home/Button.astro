---
interface Props {
  text: string;
  href: string;
  download?: string;
  newTab?: boolean;
  /* PostHog event name, captured by the delegated listener in ../lib/analytics.ts */
  event?: string;
}
const { text, href, download, newTab, event } = Astro.props;
---

<a
  class="mt-5 mr-12.5 block w-max cursor-pointer rounded-md border border-navy bg-navy px-5.5 py-3.25 text-center text-[1rem] font-bold text-white uppercase no-underline transition-all duration-300 ease-in-out hover:-translate-y-0.75 hover:bg-white hover:text-navy max-md:mr-0 max-md:px-4.5 max-md:py-3 max-md:text-[0.938rem] max-xs:text-[0.75rem] dark:border-blue-light dark:bg-blue-light dark:text-navy dark:hover:bg-transparent dark:hover:text-blue-light"
  href={href}
  download={download}
  target={newTab ? "_blank" : undefined}
  rel={newTab ? "noopener noreferrer" : undefined}
  data-ph-event={event}
>
  {text}
</a>
