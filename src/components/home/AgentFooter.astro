---
// Discoverability footer: links to the developer portal and machine-readable site descriptions.
const links = [
  { href: "/developers/", label: "API & agent docs" },
  { href: "/openapi.json", label: "OpenAPI spec" },
  { href: "/llms.txt", label: "llms.txt" },
  { href: "/AGENTS.md", label: "AGENTS.md" },
  { href: "/about/", label: "About" }
];
---

<footer class="mx-auto box-content max-w-6xl px-5 pt-8 pb-10 text-center text-sm max-md:pb-40">
  <p class="mb-2 text-xs tracking-widest text-subtitle-muted uppercase">
    For developers &amp; AI agents
  </p>
  <ul class="m-0 flex flex-wrap justify-center gap-x-5 gap-y-1.5 p-0">
    {links.map(l => (
      <li>
        <a href={l.href} class="text-navy no-underline hover:underline dark:text-blue-light">
          {l.label}
        </a>
      </li>
    ))}
  </ul>
</footer>
