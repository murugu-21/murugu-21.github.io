---
import { greeting, typewriterRoles } from "#src/data/portfolio.ts";
import SocialMedia from "./SocialMedia.astro";
import Button from "./Button.astro";
import Typewriter from "./Typewriter.astro";
import { Image } from "astro:assets";
// Portrait art from soumyajit4419/Portfolio (home-main.svg), recolored; credited
// in the README's Credits section as its license asks.
import portrait from "#src/assets/images/portrait.webp";
import Section from "./Section.astro";
---

<Section id="greeting" class="mt-8">
  <div class="flex max-md:block">
    <div class="mb-7.5 flex-1">
      <div>
        {/* my-[0.67em] / my-[1em]: UA h1 and p margins, which Preflight removes */}
        <h1 class="my-[0.67em] text-[70px] leading-[1.1] font-bold text-text max-wide:text-[50px] max-md:text-center max-md:text-[30px] dark:text-white">
          <span class="mb-3 block text-[0.55em]">
            Hi There!
            <span class="inline-block origin-[70%_70%] animate-wave motion-reduce:animate-none">
              👋
            </span>
          </span>
          <span class="block">
            I'm <span class="accent">{greeting.nickname}</span>
          </span>
        </h1>
        {/* min-h reserves the line while the roles type/delete */}
        <p class="mt-3 mb-[1em] min-h-[1.3em] text-[34px] leading-[1.3] max-wide:text-[26px] max-md:text-center max-md:text-[20px]">
          <Typewriter roles={typewriterRoles} />
        </p>
        <p class="mt-[1em] mb-10 text-3xl/10 text-subtitle max-wide:text-[20px] max-md:text-center max-md:text-[16px] max-md:leading-[normal] dark:text-white">
          {greeting.subTitle}
        </p>
        <SocialMedia />
        {/* Button.astro zeroes its margin-right below 768px, so the gap keeps wrapped buttons apart */}
        <div class="mt-10 flex max-md:flex-wrap max-md:justify-around max-md:gap-3">
          <Button text="Contact me" href="#contact" event="contact_click" />
          <Button
            text="Download my resume"
            href={greeting.resumePath}
            download={greeting.resumeFileName}
            event="resume_download"
          />
        </div>
      </div>
    </div>
    <div class="mb-7.5 flex flex-1 items-center justify-center">
      {/* 440px wide (240px on phones), so the srcset lets phones take the 480px
          file. Eager: above the fold everywhere. box-content puts the 6px ring
          outside the 440px. */}
      <Image
        class="alt-fallback box-content aspect-square w-full max-w-110 rounded-full border-6 border-navy object-cover shadow-glow max-md:max-w-60 dark:border-blue dark:shadow-glow-dark"
        src={portrait}
        widths={[240, 480, 880]}
        sizes="(max-width: 768px) 240px, 440px"
        alt="Murugappan M smiling on a hilltop with arms outstretched"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</Section>
