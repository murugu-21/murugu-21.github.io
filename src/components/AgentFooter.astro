---
// Slim site footer whose only job is discoverability: a homepage link to the
// developer portal and the machine-readable descriptions of this site, for
// both crawlers and the humans who go looking for an API. Deliberately quiet —
// it sits below the contact section and adds no new visual language.
const links = [
  {href: "/developers/", label: "API & agent docs"},
  {href: "/openapi.json", label: "OpenAPI spec"},
  {href: "/llms.txt", label: "llms.txt"},
  {href: "/AGENTS.md", label: "AGENTS.md"},
  {href: "/about/", label: "About"}
];
---

<footer class="agent-footer">
  <p class="label">For developers &amp; AI agents</p>
  <ul>
    {
      links.map(l => (
        <li>
          <a href={l.href}>{l.label}</a>
        </li>
      ))
    }
  </ul>
</footer>

<style lang="scss">
  @import "../styles/variables";

  .agent-footer {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.25rem 2.5rem;
    text-align: center;
    font-size: 0.9rem;

    .label {
      color: $subTitle;
      margin: 0 0 0.5rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: 0.75rem;
    }

    ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.4rem 1.25rem;
    }

    a {
      color: $accentLight;
      text-decoration: none;

      &:hover {
        text-decoration: underline;
      }
    }
  }

  :global(html.dark-mode) .agent-footer a {
    color: $accentDark;
  }
</style>
