---
// Canvas starfield behind both apps. Idle-loaded so it can't affect LCP, paused
// while hidden, off under prefers-reduced-motion. z-[-1] sits above the body
// background, which propagates to the root canvas. `class` lets a host tune it.
const { class: className } = Astro.props;
---

<canvas
  class:list={[
    "particles-canvas pointer-events-none fixed inset-0 z-[-1] h-full w-full",
    className
  ]}
  aria-hidden="true"
></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>(".particles-canvas");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (canvas && !reduced) {
    const start = () => {
      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      // 2x keeps small stars crisp without the fill cost of 3x on phones.
      const DPR = Math.min(window.devicePixelRatio || 1, 2);
      let width = 0;
      let height = 0;

      const resize = () => {
        width = window.innerWidth;
        height = window.innerHeight;
        canvas.width = Math.round(width * DPR);
        canvas.height = Math.round(height * DPR);
        ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      };
      resize();
      window.addEventListener("resize", resize, { passive: true });

      // ~1 star per 12000 CSS px², clamped for phones and ultrawides.
      const COUNT = Math.min(220, Math.max(90, Math.round((width * height) / 12000)));

      // Theme inks, plus the tone a bright star washes towards.
      const INK = { dark: [76, 125, 255], light: [47, 42, 77] };
      const BRIGHT = { dark: [255, 255, 255], light: [180, 83, 9] };
      const WARM = [255, 214, 170];
      const COOL = [180, 214, 255];

      const blend = (a: number[], b: number[], t: number) =>
        a.map((c, i) => Math.round(c + (b[i] - c) * t));
      const rgb = (c: number[]) => `${c[0]}, ${c[1]}, ${c[2]}`;

      // Power-curve sizes (mostly small specks); size drives brightness, drift and halo.
      const particles = Array.from({ length: COUNT }, () => {
        const r = 0.4 + Math.random() ** 3 * 2.3;
        // Wash towards the bright tone: any bright star at night, only close ones
        // at dusk (a distant amber star reads as dust on the light sky).
        const far = Math.round(Math.min(1, Math.max(0, (r - 1.2) / 1.4)) * 5) / 5;
        const near = Math.max(0, Math.min(1, (r - 1.9) / 0.8));
        const tint = Math.random() < 0.12 ? (Math.random() < 0.5 ? WARM : COOL) : null;
        // Pre-mixed per theme so the frame loop only varies alpha.
        const colour = (theme: "dark" | "light", w: number, t: number[] | null) => {
          let c = blend(INK[theme], BRIGHT[theme], w);
          if (t) c = blend(c, t, 0.35);
          return rgb(c);
        };
        return {
          x: Math.random() * width,
          y: Math.random() * height,
          r,
          base: Math.min(0.85, 0.18 + r * 0.3),
          halo: r > 1.7 ? Math.min(1, (r - 1.7) / 1.2) : 0,
          warm: near,
          vx: 0.03 + r * 0.09 + Math.random() * 0.04,
          vy: (Math.random() - 0.5) * 0.05,
          twinkle: 0.8 + Math.random() * 1.6,
          phase: Math.random() * Math.PI * 2,
          colour: {
            dark: colour("dark", far, tint),
            light: colour("light", near, null)
          }
        };
      });

      // One cached halo sprite per colour: a drawImage instead of a gradient per frame.
      const HALO = 64;
      const sprites = new Map<string, HTMLCanvasElement>();
      const haloFor = (colour: string) => {
        const cached = sprites.get(colour);
        if (cached) return cached;
        const sprite = document.createElement("canvas");
        sprite.width = sprite.height = HALO;
        const sctx = sprite.getContext("2d");
        if (!sctx) return null;
        const g = sctx.createRadialGradient(HALO / 2, HALO / 2, 0, HALO / 2, HALO / 2, HALO / 2);
        g.addColorStop(0, `rgba(${colour}, 0.65)`);
        g.addColorStop(0.25, `rgba(${colour}, 0.22)`);
        g.addColorStop(1, `rgba(${colour}, 0)`);
        sctx.fillStyle = g;
        sctx.fillRect(0, 0, HALO, HALO);
        sprites.set(colour, sprite);
        return sprite;
      };

      let raf = 0;
      const draw = (t: number) => {
        ctx.clearRect(0, 0, width, height);
        const dark = document.documentElement.classList.contains("dark-mode");
        for (const p of particles) {
          p.x += p.vx;
          p.y += p.vy;
          if (p.x > width + 4) p.x = -4;
          if (p.y > height + 4) p.y = -4;
          if (p.y < -4) p.y = height + 4;
          const colour = p.colour[dark ? "dark" : "light"];
          const alpha = p.base * (0.62 + 0.38 * Math.sin(p.phase + (t / 1000) * p.twinkle));
          // Dusk haloes only amber stars; an ink glow smudges a light sky.
          const halo = dark ? p.halo : p.halo * p.warm;
          if (halo > 0.02) {
            const sprite = haloFor(colour);
            if (sprite) {
              const s = p.r * 6;
              ctx.globalAlpha = halo * alpha * (dark ? 1 : 0.55);
              ctx.drawImage(sprite, p.x - s / 2, p.y - s / 2, s, s);
              ctx.globalAlpha = 1;
            }
          }
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(${colour}, ${alpha})`;
          ctx.fill();
        }
        raf = requestAnimationFrame(draw);
      };
      raf = requestAnimationFrame(draw);

      document.addEventListener("visibilitychange", () => {
        if (document.hidden) {
          cancelAnimationFrame(raf);
        } else {
          raf = requestAnimationFrame(draw);
        }
      });
    };

    if ("requestIdleCallback" in window) {
      requestIdleCallback(start);
    } else {
      setTimeout(start, 300);
    }
  }
</script>
