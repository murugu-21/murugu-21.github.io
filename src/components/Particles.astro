---
// Lightweight canvas "starfield" standing in for the reference's
// react-tsparticles: tiny dots drifting slowly with pulsing opacity, fixed
// behind all content. Idle-loaded so it can never affect LCP; paused while
// the tab is hidden; never started under prefers-reduced-motion.
---

<canvas class="particles-canvas" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>(".particles-canvas");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (canvas && !reduced) {
    const start = () => {
      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      const COUNT = 90;
      let width = 0;
      let height = 0;

      const resize = () => {
        width = window.innerWidth;
        height = window.innerHeight;
        canvas.width = width;
        canvas.height = height;
      };
      resize();
      window.addEventListener("resize", resize, {passive: true});

      const particles = Array.from({length: COUNT}, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        r: 0.6 + Math.random() * 1.2,
        vx: 0.05 + Math.random() * 0.2,
        vy: (Math.random() - 0.5) * 0.05,
        phase: Math.random() * Math.PI * 2
      }));

      let raf = 0;
      const draw = (t: number) => {
        ctx.clearRect(0, 0, width, height);
        const dark = document.documentElement.classList.contains("dark-mode");
        const rgb = dark ? "44, 207, 39" : "5, 123, 1";
        for (const p of particles) {
          p.x += p.vx;
          p.y += p.vy;
          if (p.x > width + 2) p.x = -2;
          if (p.y > height + 2) p.y = -2;
          if (p.y < -2) p.y = height + 2;
          const alpha = 0.15 + 0.35 * Math.abs(Math.sin(p.phase + t / 3000));
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(${rgb}, ${alpha})`;
          ctx.fill();
        }
        raf = requestAnimationFrame(draw);
      };
      raf = requestAnimationFrame(draw);

      document.addEventListener("visibilitychange", () => {
        if (document.hidden) {
          cancelAnimationFrame(raf);
        } else {
          raf = requestAnimationFrame(draw);
        }
      });
    };

    if ("requestIdleCallback" in window) {
      requestIdleCallback(start);
    } else {
      setTimeout(start, 300);
    }
  }
</script>

<style>
  .particles-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }
</style>
