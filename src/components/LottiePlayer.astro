---
interface Props {
  src: string;
  label: string;
  eager?: boolean;
}
const { src, label, eager } = Astro.props;
---

<div
  class="lottie-holder"
  data-lottie-src={src}
  data-eager={eager ? "true" : undefined}
  role="img"
  aria-label={label}
>
</div>

<script>
  import { onFirstInteraction } from "../lib/first-interaction";

  // Astro deduplicates this script: it runs once and initializes every holder.
  const REDUCED = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const holders = document.querySelectorAll<HTMLElement>(".lottie-holder");

  async function initHolder(el: HTMLElement) {
    if (el.dataset.loaded) return;
    el.dataset.loaded = "true";
    try {
      const lottie = (await import("lottie-web/build/player/lottie_light")).default;
      const res = await fetch(el.dataset.lottieSrc!);
      if (!res.ok) throw new Error(`lottie fetch ${res.status}`);
      const data = await res.json();
      lottie.loadAnimation({
        container: el,
        renderer: "svg",
        loop: !REDUCED,
        autoplay: !REDUCED,
        animationData: data
      });
      // reduced motion: render the first frame as a static illustration
    } catch {
      // failed to load: stop announcing an image that isn't there
      el.removeAttribute("role");
      el.removeAttribute("aria-label");
      el.setAttribute("aria-hidden", "true");
    }
  }

  const io = new IntersectionObserver(
    entries => {
      entries.forEach(e => {
        if (!e.isIntersecting) return;
        io.unobserve(e.target);
        initHolder(e.target as HTMLElement);
      });
    },
    { rootMargin: "120px" }
  );
  // Decoration waits for the visitor's first input (see lib/first-interaction.ts):
  // the player is 170 KB and the coding illustration a 430 KB JSON whose parse
  // and SVG build are a ~450 ms main-thread task — on a desktop viewport the
  // Skills section is already in range at load, so it landed inside what
  // Lighthouse scores as blocking time. A pointer move, key or touch (which
  // reaching the section on a phone requires anyway) starts the observer.
  onFirstInteraction(() => {
    holders.forEach(h => {
      if (h.dataset.eager) initHolder(h);
      else io.observe(h);
    });
  });
</script>
