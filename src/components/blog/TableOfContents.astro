---
// Notion-style rail of bars on the right edge, one per h2/h3, expanding into
// the heading list on hover or keyboard focus. Mounted after `</article>` so
// post.css rules don't apply, the article's links come first in tab order,
// and the medium-zoom overlay still paints over it.
//
// Hover pointers get the collapsed rail from 64rem. Touch devices only get it,
// always expanded, from 87rem, where the panel clears the 42rem column:
// 2 × (19.75rem prose half + 22.25rem panel) = 84rem, plus a 1.5rem gap.
import type { MarkdownHeading } from "astro";
import { tocEntries } from "#src/lib/blog/toc.ts";

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const entries = tocEntries(headings);
---

{entries.length > 0 && (
  <nav class="toc" aria-label="On this page">
    <ol>
      {entries.map(entry => (
        <li class:list={[{ sub: entry.depth === 3 }]}>
          {/* Collapsed labels are clipped, not display:none, so links keep
                their accessible name. */}
          <a href={`#${entry.slug}`}>
            <span class="bar" aria-hidden="true" />
            <span class="label">{entry.text}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}

<style>
  .toc {
    display: none;
  }

  /* ---- The expanded panel: the default styling of the list ------------- */

  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0.75rem 1rem;
    max-width: 20rem;
    max-height: calc(100vh - 12rem);
    overflow-y: auto;
    border-radius: 0.75rem;
    /* The frosted band the pinned read-aloud bar paints. */
    background: light-dark(var(--color-nav-scrolled), var(--color-nav-scrolled-dark));
    -webkit-backdrop-filter: blur(15px);
    backdrop-filter: blur(15px);
    box-shadow: var(--shadow-glow);
    transition:
      background-color 0.15s ease,
      box-shadow 0.15s ease;
  }
  /* The shadow tokens differ in spread, not only colour, so they stay a pair.
     `:where` keeps this level with `.toc ol` (so it must follow it) and below
     the collapsed-rail rule, which clears the shadow. */
  :global(:where(html.dark-mode)) .toc ol {
    box-shadow: var(--shadow-glow-dark);
  }

  .toc a {
    display: flex;
    align-items: center;
    padding: 0.3rem 0;
    font-size: 0.875rem;
    line-height: 1.35;
    color: light-dark(var(--color-text-light), var(--color-text-dark));
    text-decoration: none;
  }
  /* h3s indent under their h2, as in Notion's open list. */
  .toc li.sub a {
    padding-left: 1rem;
    font-size: 0.8125rem;
  }
  .toc a:hover,
  .toc a:focus-visible {
    color: light-dark(var(--color-title), var(--color-heading-dark));
  }
  .toc a[aria-current] {
    color: light-dark(var(--color-title), var(--color-heading-dark));
    font-weight: 700;
  }
  .toc a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
    border-radius: 0.25rem;
  }

  /* Long headings wrap inside the 20rem panel rather than widening it. */
  .toc .label {
    overflow-wrap: anywhere;
  }

  /* Only shown in the collapsed state, below. */
  .toc .bar {
    display: none;
    height: 2px;
    border-radius: 1px;
    background: light-dark(var(--color-toc-bar), var(--color-accent-grey-dark));
  }
  .toc a[aria-current] .bar {
    background: light-dark(var(--color-title), var(--color-heading-dark));
  }

  /* ---- Placement --------------------------------------------------------- */

  @media (min-width: 64rem) and (hover: hover), (min-width: 87rem) and (hover: none) {
    .toc {
      display: block;
      position: fixed;
      /* `right`, not `100vw`: fixed is measured inside a classic scrollbar. */
      right: 0;
      top: 50%;
      transform: translateY(-50%);
      /* The padding is the hover target around the 2px bars and keeps the
         growing panel under the pointer. */
      padding: 1rem 0.75rem 1rem 1.5rem;
    }
  }

  /* ---- The collapsed rail: bars only, while neither hovered nor focused ---
     `:has(:focus-visible)`, not `:focus-within`: a mouse click would leave
     the panel held open over the prose. */

  /* Flat, not nested: Astro leaves nested selectors unscoped, which would
     drop them to the panel rules' specificity. */
  @media (hover: hover) {
    .toc:not(:hover, :has(:focus-visible)) ol {
      background: transparent;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      box-shadow: none;
      padding: 0;
      /* No scrollbar beside the bars; extra bars run past max-height. */
      overflow: visible;
    }
    .toc:not(:hover, :has(:focus-visible)) a {
      justify-content: flex-end;
      padding: 0.35rem 0;
    }
    .toc:not(:hover, :has(:focus-visible)) .bar {
      display: block;
      width: 1rem;
    }
    .toc:not(:hover, :has(:focus-visible)) li.sub .bar {
      width: 0.625rem;
    }
    /* Visually hidden, still announced. */
    .toc:not(:hover, :has(:focus-visible)) .label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toc ol {
      transition: none;
    }
  }
</style>

<script>
  // Scroll spy: re-measure headings once per frame on scroll and resize. Not
  // an IntersectionObserver: it fires on a heading's bottom edge, so after a
  // hash jump parked a heading on the line nothing fired. Listeners live as
  // long as the page.
  import { TOC_LINE_SLACK, activeIndex } from "#src/lib/blog/toc.ts";

  const nav = document.querySelector<HTMLElement>("nav.toc");
  if (nav) {
    const pairs = [...nav.querySelectorAll<HTMLAnchorElement>("a[href^='#']")].flatMap(link => {
      const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
      return heading ? [{ link, heading }] : [];
    });

    // Read the scroll margin from the live heading; post.css owns the value.
    const scrollMargin = pairs.length
      ? parseFloat(getComputedStyle(pairs[0].heading).scrollMarginTop) || 0
      : 0;
    const line = scrollMargin + TOC_LINE_SLACK;

    // A heading with no box (inside a closed <details>, say) reports a top of
    // 0, which would read as reached; give it Infinity instead.
    const topOf = (heading: HTMLElement) => {
      const rects = heading.getClientRects();
      return rects.length ? rects[0].top : Infinity;
    };

    const update = () => {
      const tops = pairs.map(p => topOf(p.heading));
      const root = document.documentElement;
      const atEnd = Math.ceil(window.scrollY + window.innerHeight) >= root.scrollHeight - 1;
      const active = activeIndex(tops, line, atEnd);
      pairs.forEach((p, i) => {
        if (i === active) p.link.setAttribute("aria-current", "location");
        else p.link.removeAttribute("aria-current");
      });
    };

    // Escape collapses a keyboard-opened panel.
    nav.addEventListener("keydown", event => {
      const focused = document.activeElement;
      if (event.key === "Escape" && focused instanceof HTMLElement && nav.contains(focused)) {
        focused.blur();
      }
    });

    let frame = 0;
    const schedule = () => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        update();
      });
    };
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule, { passive: true });
    update();
  }
</script>
