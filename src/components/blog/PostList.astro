---
// The blog index's searchable, tag-filterable post list. Plain script, no
// React island: hydration cost ~70 KB ahead of LCP on mobile. Filter state
// mirrors into the URL (`?q=`, one `?tag=` per chip), which wins on load.
import type { SerializedPost } from "#src/lib/blog/posts.ts";
import SearchBar from "./SearchBar.astro";
import Tag, { type TagCount } from "./Tag.astro";
import Post from "./Post.astro";

interface Props {
  posts: SerializedPost[];
}
const { posts } = Astro.props;

// Most-used first, ties alphabetical.
const totals = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.tags) totals.set(tag, (totals.get(tag) ?? 0) + 1);
}
const tags: TagCount[] = [...totals]
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
---

<div data-post-list>
  <SearchBar />
  <div class="flex flex-wrap">
    {tags.map(tag => (
      <Tag tag={tag} />
    ))}
  </div>
  <ol class="mt-4 mb-8 list-none p-0">
    {posts.map(post => (
      <Post post={post} />
    ))}
  </ol>
  <p class="my-8 leading-relaxed" data-empty hidden>
    No matching article found
  </p>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-post-list]");
  if (root) {
    const search = root.querySelector<HTMLInputElement>("#search");
    const tagInputs = Array.from(root.querySelectorAll<HTMLInputElement>("input.tag"));
    const items = Array.from(root.querySelectorAll<HTMLLIElement>("li[data-tags]")).map(li => ({
      li,
      text: li.dataset.search ?? "",
      tags: li.dataset.tags?.split(" ") ?? []
    }));
    const empty = root.querySelector<HTMLElement>("[data-empty]");

    const apply = () => {
      const query = (search?.value ?? "").toLowerCase();
      const selected = tagInputs.filter(t => t.checked).map(t => t.value);
      let shown = 0;
      for (const item of items) {
        const match =
          item.text.includes(query) &&
          (selected.length === 0 || item.tags.some(tag => selected.includes(tag)));
        item.li.hidden = !match;
        if (match) shown++;
      }
      if (empty) empty.hidden = shown > 0;
    };

    // Other params (utm_*) are preserved. replaceState so typing doesn't pile
    // up history entries.
    const syncUrl = () => {
      const params = new URLSearchParams(location.search);
      const query = search?.value ?? "";
      if (query) params.set("q", query);
      else params.delete("q");
      params.delete("tag");
      for (const input of tagInputs) if (input.checked) params.append("tag", input.value);
      const qs = params.toString();
      history.replaceState(null, "", `${location.pathname}${qs ? `?${qs}` : ""}${location.hash}`);
    };

    // URL to DOM, on load, popstate and pageshow (bfcache restores don't fire
    // popstate). Also overrides the browser's form restoration.
    const readUrl = () => {
      const params = new URLSearchParams(location.search);
      if (search) search.value = params.get("q") ?? "";
      const tags = new Set(params.getAll("tag"));
      for (const input of tagInputs) input.checked = tags.has(input.value);
    };

    const onFilter = () => {
      apply();
      syncUrl();
    };
    const restore = () => {
      readUrl();
      apply();
    };

    search?.addEventListener("input", onFilter);
    for (const input of tagInputs) input.addEventListener("change", onFilter);
    addEventListener("popstate", restore);
    addEventListener("pageshow", restore);
    restore();
  }
</script>
