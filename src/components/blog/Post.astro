---
// One blog index entry. `data-search` and `data-tags` feed PostList.astro's
// filter script; keywords are in the haystack so SEO terms stay searchable.
import { formatReadingTime, type SerializedPost } from "#src/lib/blog/posts.ts";

interface Props {
  post: SerializedPost;
}
const { post } = Astro.props;
const haystack = [post.title, post.description ?? post.excerpt, ...post.tags, ...post.keywords]
  .join("\n")
  .toLowerCase();
---

<li class="mb-4 pl-0" data-search={haystack} data-tags={post.tags.join(" ")}>
  <article class="mt-8">
    <header class="mb-4">
      <h2 class="mt-0 mb-2 text-[1.728rem] leading-[1.1] font-bold tracking-tight text-navy dark:text-blue-light">
        <a href={post.href} class="text-inherit no-underline">
          {post.title}
        </a>
      </h2>
      <small>
        {post.dateFormatted}
        {` • ${formatReadingTime(post.minutes)}`}
      </small>
      {/* flex-wrap: an unwrapped row overflowed the page at phone width. */}
      <div class="flex flex-row flex-wrap gap-[10px]">
        {post.tags.map(tag => (
          // The inline-block label stops Chrome painting a line-end selection
          // marker into the chip's padding (see Tag.astro).
          <div class="border border-chip-outline px-[.5em] py-[3px] text-[0.833rem] dark:border-chip-outline-dark">
            <span class="inline-block">{tag}</span>
          </div>
        ))}
      </div>
    </header>
    <section>
      {/* Trusted frontmatter / excerpt HTML. */}
      <p class="leading-relaxed" set:html={post.description || post.excerpt} />
    </section>
  </article>
</li>
