---
import { cn } from "#src/lib/utils.ts";

// One tag filter chip: a visually hidden checkbox `[data-tag]` plus its label,
// styled from the checkbox state; PostList.astro's script reads it on `change`.
//
// `[[data-tag]:…+&]:` variants, not `peer-*`: peer compiles to `~`, and all chips are
// siblings, so checking one would paint every later label. Hovering a label
// forwards `:hover` to its offscreen checkbox, so `[data-tag]:hover + label` works.
export interface TagCount {
  name: string;
  count: number;
}

interface Props {
  tag: TagCount;
}
const { tag } = Astro.props;
---

{/* Visually hidden but focusable: it is the label's styling source. */}
<input class="sr-only" data-tag type="checkbox" id={`tag-${tag.name}`} value={tag.name} />
<label
  for={`tag-${tag.name}`}
  class={cn(
    "mt-3.5 mr-3 flex cursor-pointer items-center rounded-sm [[data-tag]:checked+&]:bg-navy [[data-tag]:checked+&]:text-white dark:[[data-tag]:checked+&]:bg-box-dark [[data-tag]:hover+&]:shadow-md [[data-tag]:hover+&]:shadow-chip-outline [[data-tag]:hover+&]:outline-none dark:[[data-tag]:hover+&]:shadow-chip-outline-dark",
    // Solid rings: half-alpha ones miss the 3:1 a focus indicator needs.
    "[[data-tag]:focus-visible+&]:ring-2 [[data-tag]:focus-visible+&]:ring-amber-ink dark:[[data-tag]:focus-visible+&]:ring-blue-light"
  )}
>
  {/* Inline-block text spans: on a padded flex item, Chrome paints a
      line-end selection marker out to the cell's edge. An atomic inline
      keeps the text off that line box. */}
  <span class="rounded-l-sm border border-chip-outline px-2 dark:border-chip-outline-dark">
    <span class="inline-block">{tag.name}</span>
  </span>
  {/* Badge alphas are tuned for AA (palette.test.ts guards night). Not a flex
      box, which would blockify the span and bring the selection marker back;
      `content-center` centres the numeral instead. */}
  <div class="content-center self-stretch rounded-r-sm bg-navy/10 px-2 text-xs text-navy dark:bg-blue-light/12 dark:text-blue-light [[data-tag]:checked+label_&]:bg-white/10 [[data-tag]:checked+label_&]:text-white">
    <span class="inline-block">{tag.count}</span>
  </div>
</label>
