<div id="chat-widget-root"></div>

<script>
  // Defer the whole widget (JS + CSS) to idle so it stays out of the initial
  // load waterfall — same pattern as the Clarity tag in Layout.astro.
  const start = () => void import("./widget");
  if ("requestIdleCallback" in window) {
    requestIdleCallback(start, {timeout: 4000});
  } else {
    setTimeout(start, 2500);
  }
</script>
