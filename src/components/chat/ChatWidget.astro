---
// React island wrapper. client:interaction (our directive, see
// ../../directives/interaction.ts) defers hydration — React + widget JS — to
// the visitor's first input, so a page that is only loaded never pays for it;
// the wrapper div carries the id the chat.css design tokens are scoped under.
import { ChatWidget } from "./ChatWidget";
---

<div id="chat-widget-root" class="ui-island">
  <ChatWidget client:interaction />
</div>
