---
// The first role is server-rendered so no-JS and reduced-motion visitors see it.
interface Props {
  roles: string[];
}
const { roles } = Astro.props;
---

<span class="typewriter text-navy dark:text-blue font-semibold" data-roles={JSON.stringify(roles)}>
  <span class="typewriter-text">{roles[0]}</span>
  <span
    class="ml-0.5 font-normal animate-[typewriter-blink_1s_step-end_infinite] motion-reduce:animate-none max-[768px]:hidden"
    aria-hidden="true"
  >
    |
  </span>
</span>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>(".typewriter").forEach(el => {
    if (reduced) return;
    const roles: string[] = JSON.parse(el.dataset.roles || "[]");
    const text = el.querySelector<HTMLElement>(".typewriter-text");
    if (!text || roles.length < 2) return;

    let index = 0;
    let pos = roles[0].length;
    let deleting = true; // the SSR'd role is fully typed; pause, then delete

    const tick = () => {
      const current = roles[index % roles.length];
      pos += deleting ? -1 : 1;
      text.textContent = current.slice(0, pos);
      let delay = deleting ? 40 : 85;
      if (deleting && pos === 0) {
        deleting = false;
        index++;
        delay = 400;
      } else if (!deleting && pos === current.length) {
        deleting = true;
        delay = 1700;
      }
      setTimeout(tick, delay);
    };
    setTimeout(tick, 1700);
  });
</script>

<style>
  @keyframes typewriter-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
</style>
