---
// Reference footer: slim dark strip with three centered columns —
// credit / copyright / plain social icons (columns stack on mobile).
import {socialMediaLinks} from "../data/portfolio";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();

const items = [
  {href: socialMediaLinks.github, icon: "github", label: "GitHub profile"},
  {
    href: socialMediaLinks.linkedin,
    icon: "linkedin-in",
    label: "LinkedIn profile"
  },
  {
    href: socialMediaLinks.twitter,
    icon: "twitter",
    label: "X (formerly Twitter) profile"
  },
  {
    href: socialMediaLinks.stackoverflow,
    icon: "stack-overflow",
    label: "Stack Overflow profile"
  }
];
---

<footer class="footer-div section-animate">
  <p class="footer-text">Designed and Developed by Murugappan M</p>
  <p class="footer-text">Copyright © {year} MM</p>
  <ul class="footer-social">
    {
      items.map(item => (
        <li>
          <a
            href={item.href}
            aria-label={item.label}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name={item.icon} />
          </a>
        </li>
      ))
    }
  </ul>
</footer>

<style lang="scss">
  @import "../styles/variables";

  .footer-div {
    margin-top: 3rem;
    padding: 14px 20px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: center;
    background-color: $lightBackground3;
  }

  .footer-text {
    text-align: center;
    margin: 4px 0;
    color: $textColor;
    font-size: 0.95em;
  }

  .footer-social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    gap: 18px;
  }

  .footer-social a {
    color: $textColor;
    display: inline-flex;
  }

  .footer-social :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    transition: color 0.2s ease-in;
  }

  .footer-social a:hover {
    color: $buttonColor;
  }

  /* dark mode: near-black strip like the reference footer */
  :global(html.dark-mode) .footer-div {
    background-color: $darkFooterBG;
  }

  :global(html.dark-mode) .footer-text,
  :global(html.dark-mode) .footer-social a {
    color: $textColorDark;
  }

  :global(html.dark-mode) .footer-social a:hover {
    color: $accentDark;
  }

  @media (max-width: 768px) {
    .footer-div {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
