---
import { FIRA_CODE_FACE, FIRA_CODE_URL } from "#src/lib/fonts.ts";
import { SITE_ORIGIN } from "#src/lib/site.ts";
import "#src/styles/global.css";
import ChatWidget from "#src/components/chat/ChatWidget.astro";
import Favicons from "#src/components/Favicons.astro";
import Particles from "#src/components/Particles.astro";
import SiteScripts from "#src/components/SiteScripts.astro";
import { sameAs, skillsCategories, socialMediaLinks } from "#src/data/portfolio.ts";

interface Props {
  title?: string;
  // Defaults to the site pitch; pages not about the person need their own.
  description?: string;
  noindex?: boolean;
  // the canonical entity page (/about)
  profilePage?: boolean;
}

const description =
  "I build B2B SaaS that ships in regulated industries, using TypeScript end-to-end and event-driven services on AWS. I was the founding engineer who took a product from 0 to $300k ARR, and now I automate pharmacy workflows with LLMs at MedMe Health.";
// Under 160 chars so Google doesn't truncate it; og/twitter/JSON-LD keep the full pitch.
const metaDescription =
  "I build B2B SaaS that ships in regulated industries. I took a product from 0 to $300k ARR and now automate pharmacy workflows with LLMs at MedMe Health.";
const {
  title = "Murugappan M | Full Stack Engineer | TypeScript, Node.js, React & AWS",
  description: pageDescription,
  noindex = false,
  profilePage = false
} = Astro.props;
const pageMetaDescription = pageDescription ?? metaDescription;
const socialDescription = pageDescription ?? description;

// Canonical on the custom domain, so other hosts (workers.dev previews) consolidate to it.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

// knowsAbout is the hand-written list plus the resume skills, split on ";", "—"
// and commas outside parentheses (keeps "(AWS SQS, EventBridge)" intact),
// deduped case-insensitively.
const handWrittenKnowsAbout = [
  "TypeScript",
  "Node.js",
  "React",
  "AWS",
  "Distributed systems",
  "Event-driven architecture",
  "Observability",
  "SOC 2",
  "HIPAA"
];
const seenKnowsAbout = new Set(handWrittenKnowsAbout.map(s => s.toLowerCase()));
const extraKnowsAbout: string[] = [];
for (const { items } of skillsCategories) {
  for (const raw of items.split(/;|—|,(?![^()]*\))/)) {
    const term = raw.trim();
    if (!term) continue;
    const key = term.toLowerCase();
    if (seenKnowsAbout.has(key)) continue;
    seenKnowsAbout.add(key);
    extraKnowsAbout.push(term);
  }
}
const knowsAbout = [...handWrittenKnowsAbout, ...extraKnowsAbout];

// Stable @ids so crawlers merge every page into one entity; keep PERSON_ID in
// sync with src/blog/consts.ts.
const PERSON_ID = `${SITE_ORIGIN}/#person`;
const WEBSITE_ID = `${SITE_ORIGIN}/#website`;
const personNode = {
  "@type": "Person",
  "@id": PERSON_ID,
  name: "Murugappan M",
  givenName: "Murugappan",
  // helps entity resolvers connect the sameAs profiles
  alternateName: ["murugu-21", "murugu21"],
  email: `mailto:${socialMediaLinks.gmail}`,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Bangalore",
    addressCountry: "IN"
  },
  url: `${SITE_ORIGIN}/`,
  image: {
    "@type": "ImageObject",
    url: `${SITE_ORIGIN}/og-image.png`
  },
  jobTitle: "Full Stack Engineer",
  description,
  worksFor: {
    "@type": "Organization",
    name: "MedMe Health",
    url: "https://www.medmehealth.com"
  },
  alumniOf: [
    {
      "@type": "Organization",
      name: "HyperVerge",
      url: "https://hyperverge.co"
    },
    {
      "@type": "Organization",
      name: "Samsung R&D Institute India",
      url: "https://research.samsung.com/sri-b"
    },
    {
      "@type": "CollegeOrUniversity",
      name: "Kumaraguru College of Technology",
      url: "https://kct.ac.in"
    }
  ],
  knowsAbout,
  sameAs,
  mainEntityOfPage: { "@id": `${SITE_ORIGIN}/about/` }
};
const graph: object[] = [
  {
    "@type": "WebSite",
    "@id": WEBSITE_ID,
    url: `${SITE_ORIGIN}/`,
    name: "Murugappan M, Full Stack Engineer",
    description,
    publisher: { "@id": PERSON_ID },
    inLanguage: "en"
  },
  personNode
];
if (!noindex) {
  graph.push({
    "@type": profilePage ? "ProfilePage" : "WebPage",
    "@id": canonicalUrl,
    url: canonicalUrl,
    name: title,
    isPartOf: { "@id": WEBSITE_ID },
    about: { "@id": PERSON_ID },
    ...(profilePage ? { mainEntity: { "@id": PERSON_ID } } : {}),
    inLanguage: "en"
  });
}
const jsonLd = { "@context": "https://schema.org", "@graph": graph };

// scroll-pt-20 (80px) clears the fixed header. It lives here, not in global.css,
// which the blog (no fixed header) shares.
---

<!doctype html>
<html lang="en" class="scroll-smooth scroll-pt-20">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={pageMetaDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    {/* the entity page, kept out of the human nav */}
    <link rel="author" href="/about/" />
    {/* IANA link relations for agent discovery */}
    <link
      rel="service-desc"
      type="application/json"
      href="/openapi.json"
      title="OpenAPI 3.1.0 description of the murugappan.dev API"
    />
    <link rel="service-doc" type="text/html" href="/developers/" />
    <link
      rel="api-catalog"
      type="application/linkset+json"
      href="/.well-known/api-catalog"
      title="murugappan.dev API catalogue (RFC 9727)"
    />
    <link rel="describedby" type="text/plain" href="/llms.txt" title="Site summary for LLMs" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="SDE Journey RSS Feed"
      href="/blog/rss.xml"
    />

    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:image" content={`${SITE_ORIGIN}/og-image.png`} />

    <meta name="twitter:card" content="summary_large_image" />
    {!noindex && <meta name="twitter:url" content={canonicalUrl} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={`${SITE_ORIGIN}/og-image.png`} />

    <meta name="msapplication-TileColor" content="#06038d" />
    <meta name="theme-color" content="#06038d" />
    <meta name="theme-color" content="#282c35" media="(prefers-color-scheme: dark)" />

    <Favicons />

    {/* Preloaded: with no metric-tuned fallback (../lib/fonts.ts), a late swap shifts layout. */}
    <link rel="preload" as="font" type="font/woff2" crossorigin href={FIRA_CODE_URL} />
    <style is:inline set:html={FIRA_CODE_FACE}></style>

    <script is:inline>
      // Sets html.dark-mode before first paint. Inline, so it can't import;
      // keep in step with resolveTheme in ../lib/theme.ts.
      (function () {
        var dark = false;
        try {
          dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        } catch (e) {}
        try {
          var stored = localStorage.getItem("isDark");
          if (stored !== null) dark = JSON.parse(stored);
        } catch (e) {}
        if (dark) document.documentElement.classList.add("dark-mode");
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <SiteScripts />
  </head>
  <body>
    <Particles />
    <slot />
    <ChatWidget />
  </body>
</html>
