---
import "../styles/global.scss";
import agustinaUrl from "../assets/fonts/Agustina.woff?url";
import ChatWidget from "../components/chat/ChatWidget.astro";
import {skillsCategories} from "../data/portfolio";

interface Props {
  title?: string;
  // Per-page meta description. Defaults to the site pitch, which is right for
  // pages about the person; a page about something else (the API, say) needs
  // its own or it will never surface for a query about that thing.
  description?: string;
  noindex?: boolean;
  // marks this page as THE canonical entity page about the person (/about)
  profilePage?: boolean;
}

const description =
  "I build B2B SaaS that ships in regulated industries — TypeScript end-to-end, event-driven on AWS. Founding engineer who took a product from 0 to $300k ARR; now automating pharmacy workflows with LLMs at MedMe Health.";
// Search-snippet variant of the pitch, kept under 160 chars so Google doesn't
// truncate it. The stack list is dropped because the <title> already carries
// it; og/twitter/JSON-LD keep the full pitch.
const metaDescription =
  "I build B2B SaaS that ships in regulated industries — founding engineer, 0 to $300k ARR, now automating pharmacy workflows with LLMs at MedMe Health.";
const {
  title = "Murugappan M | Full Stack Engineer — TypeScript, Node.js, React & AWS",
  description: pageDescription,
  noindex = false,
  profilePage = false
} = Astro.props;
const pageMetaDescription = pageDescription ?? metaDescription;
const socialDescription = pageDescription ?? description;

// Self-referencing canonical built on the custom domain, so copies served
// from any other host (workers.dev preview, etc.) consolidate to it.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

// Extend the hand-written knowsAbout list below with the resume's skills
// taxonomy — split each category's "items" string on semicolons/em dashes and
// on commas that are NOT inside a parenthesized group (so "(AWS SQS,
// EventBridge)" stays intact instead of splitting into two unbalanced
// fragments), trim, drop empties and anything already present
// (case-insensitive).
const handWrittenKnowsAbout = [
  "TypeScript",
  "Node.js",
  "React",
  "AWS",
  "Distributed systems",
  "Event-driven architecture",
  "Observability",
  "SOC 2",
  "HIPAA"
];
const seenKnowsAbout = new Set(handWrittenKnowsAbout.map(s => s.toLowerCase()));
const extraKnowsAbout: string[] = [];
for (const {items} of skillsCategories) {
  for (const raw of items.split(/;|—|,(?![^()]*\))/)) {
    const term = raw.trim();
    if (!term) continue;
    const key = term.toLowerCase();
    if (seenKnowsAbout.has(key)) continue;
    seenKnowsAbout.add(key);
    extraKnowsAbout.push(term);
  }
}
const knowsAbout = [...handWrittenKnowsAbout, ...extraKnowsAbout];

// Identity graph with stable @ids: the blog's BlogPosting/Blog nodes point
// their author/publisher at PERSON_ID (see blog/src/consts.js — keep in
// sync), so crawlers can merge every page's markup into one entity.
const SITE_URL = "https://murugappan.dev";
const PERSON_ID = `${SITE_URL}/#person`;
const WEBSITE_ID = `${SITE_URL}/#website`;
const personNode = {
  "@type": "Person",
  "@id": PERSON_ID,
  name: "Murugappan M",
  givenName: "Murugappan",
  // public handles — help entity resolvers connect the sameAs profiles
  alternateName: ["murugu-21", "murugu21"],
  email: "mailto:murugu2001@gmail.com",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Bangalore",
    addressCountry: "IN"
  },
  url: `${SITE_URL}/`,
  image: {
    "@type": "ImageObject",
    url: `${SITE_URL}/og-image.png`
  },
  jobTitle: "Full Stack Engineer",
  description,
  worksFor: {
    "@type": "Organization",
    name: "MedMe Health",
    url: "https://www.medmehealth.com"
  },
  alumniOf: [
    {
      "@type": "Organization",
      name: "HyperVerge",
      url: "https://hyperverge.co"
    },
    {
      "@type": "Organization",
      name: "Samsung R&D Institute India",
      url: "https://research.samsung.com/sri-b"
    },
    {
      "@type": "CollegeOrUniversity",
      name: "Kumaraguru College of Technology",
      url: "https://kct.ac.in"
    }
  ],
  knowsAbout,
  sameAs: [
    "https://github.com/murugu-21",
    "https://www.linkedin.com/in/murugappan-m-56920a192/",
    "https://x.com/murugu21"
  ],
  // /about is the canonical entity page about the person
  mainEntityOfPage: {"@id": `${SITE_URL}/about/`}
};
const graph: object[] = [
  {
    "@type": "WebSite",
    "@id": WEBSITE_ID,
    url: `${SITE_URL}/`,
    name: "Murugappan M — Full Stack Engineer",
    description,
    publisher: {"@id": PERSON_ID},
    inLanguage: "en"
  },
  personNode
];
// Every indexable page gets a page node tied into the graph; /about (the
// canonical entity page) is a ProfilePage whose mainEntity is the person.
if (!noindex) {
  graph.push({
    "@type": profilePage ? "ProfilePage" : "WebPage",
    "@id": canonicalUrl,
    url: canonicalUrl,
    name: title,
    isPartOf: {"@id": WEBSITE_ID},
    about: {"@id": PERSON_ID},
    ...(profilePage ? {mainEntity: {"@id": PERSON_ID}} : {}),
    inLanguage: "en"
  });
}
const jsonLd = {"@context": "https://schema.org", "@graph": graph};

// Microsoft Clarity project id, set per-environment in Cloudflare Pages build
// env vars. PUBLIC_ because the value is inlined into the served HTML anyway.
// Unset (local dev, CI) → the tag is omitted entirely. The snippet is built
// here and injected via set:html — a <script> nested inside a template
// expression can't hold braces (they parse as expressions). The tag itself is
// injected on idle so it stays out of the initial load waterfall; the queue
// stub buffers clarity() calls until then.
// trim(): a stray space pasted into the build env var otherwise 400s the tag URL
const PUBLIC_CLARITY_PROJECT_ID =
  import.meta.env.PUBLIC_CLARITY_PROJECT_ID?.trim();
const claritySnippet = PUBLIC_CLARITY_PROJECT_ID
  ? `(function () {
  window.clarity =
    window.clarity ||
    function () {
      (window.clarity.q = window.clarity.q || []).push(arguments);
    };
  var loadClarity = function () {
    var s = document.createElement("script");
    s.async = true;
    s.src = "https://www.clarity.ms/tag/" + ${JSON.stringify(PUBLIC_CLARITY_PROJECT_ID)};
    document.head.appendChild(s);
  };
  if ("requestIdleCallback" in window) {
    requestIdleCallback(loadClarity, {timeout: 3000});
  } else {
    setTimeout(loadClarity, 2000);
  }
})();`
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={pageMetaDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    {/* crawler-only pointer to the entity page (not in the human nav) */}
    <link rel="author" href="/about/" />
    {
      /* IANA link relations for agent discovery: the API's OpenAPI description
        and the human-readable developer portal that documents it. */
    }
    <link
      rel="service-desc"
      type="application/json"
      href="/openapi.json"
      title="murugappan.dev API — OpenAPI 3.1.0"
    />
    <link rel="service-doc" type="text/html" href="/developers/" />
    <link
      rel="api-catalog"
      type="application/linkset+json"
      href="/.well-known/api-catalog"
      title="murugappan.dev API catalogue (RFC 9727)"
    />
    <link
      rel="describedby"
      type="text/plain"
      href="/llms.txt"
      title="Site summary for LLMs"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="SDE Journey RSS Feed"
      href="/blog/rss.xml"
    />

    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:image" content="https://murugappan.dev/og-image.png" />

    <meta name="twitter:card" content="summary_large_image" />
    {!noindex && <meta name="twitter:url" content={canonicalUrl} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content="https://murugappan.dev/og-image.png" />

    <meta name="msapplication-TileColor" content="#057b01" />
    <meta name="theme-color" content="#057b01" />
    <meta
      name="theme-color"
      content="#282c35"
      media="(prefers-color-scheme: dark)"
    />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#885bd5" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <link
      rel="preload"
      as="font"
      type="font/woff"
      crossorigin
      href={agustinaUrl}
    />

    <script is:inline>
      (function () {
        var dark = false;
        try {
          dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        } catch (e) {}
        try {
          var stored = localStorage.getItem("isDark");
          if (stored !== null) dark = JSON.parse(stored);
        } catch (e) {}
        if (dark) document.documentElement.classList.add("dark-mode");
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {claritySnippet && <script is:inline set:html={claritySnippet} />}

    <script>
      import "../lib/webmcp";
    </script>
  </head>
  <body>
    <slot />
    <ChatWidget />
  </body>
</html>
