---
import { Font } from "astro:assets";
import { PERSON_ID, SITE_ORIGIN, WEBSITE_ID } from "#src/lib/site.ts";
import { SITE_TITLE } from "#src/blog/consts.ts";
import { themeBootstrapScript } from "#src/lib/theme.ts";
import "#src/styles/global.css";
import ChatWidget from "#src/components/chat/ChatWidget.astro";
import Favicons from "#src/components/Favicons.astro";
import Particles from "#src/components/Particles.astro";
import SiteScripts from "#src/components/SiteScripts.astro";
import { sameAs, skillsCategories, socialMediaLinks } from "#src/data/portfolio.ts";

export interface Props {
  title?: string;
  // og:title and twitter:title, when they drop the <title>'s suffix.
  socialTitle?: string;
  // Defaults to the section's pitch; pages not about the person need their own.
  description?: string;
  noindex?: boolean;
  // the canonical entity page (/about)
  profilePage?: boolean;
  section?: Section;
  article?: { published: Date; tags: string[] };
  // The page's own schema.org nodes, merged into the site-wide @graph.
  graph?: object[];
}

const description =
  "I build B2B SaaS that ships in regulated industries, using TypeScript end-to-end and event-driven services on AWS. I was the founding engineer who took a product from 0 to $300k ARR, and now I automate pharmacy workflows with LLMs at MedMe Health.";

export interface Section {
  siteName: string;
  ogImage: string;
  metaDescription: string;
  socialDescription: string;
  htmlClass: string;
  // What the section's WebPage nodes are about; blog posts are about their topic.
  pageAbout?: { "@id": string };
  bodyClass?: string;
  particlesClass?: string;
}

const portfolio: Section = {
  siteName: "Murugappan M",
  ogImage: `${SITE_ORIGIN}/og-image.png`,
  // Under 160 chars so Google doesn't truncate it; og/twitter/JSON-LD keep the full pitch.
  metaDescription:
    "I build B2B SaaS that ships in regulated industries. I took a product from 0 to $300k ARR and now automate pharmacy workflows with LLMs at MedMe Health.",
  socialDescription: description,
  // 80px clears the fixed header.
  htmlClass: "scroll-pt-20",
  pageAbout: { "@id": PERSON_ID }
};

const {
  title = "Murugappan M | Full Stack Engineer | TypeScript, Node.js, React & AWS",
  socialTitle = title,
  description: pageDescription,
  noindex = false,
  profilePage = false,
  section = portfolio,
  article,
  graph: pageGraph = []
} = Astro.props;
const pageMetaDescription = pageDescription ?? section.metaDescription;
const socialDescription = pageDescription ?? section.socialDescription;
const twitterHandle = new URL(socialMediaLinks.twitter).pathname.replace(/^\//, "");

// Canonical on the custom domain, so other hosts (workers.dev previews) consolidate to it.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

// knowsAbout is the hand-written list plus the resume skills, split on ";", "—"
// and commas outside parentheses (keeps "(AWS SQS, EventBridge)" intact),
// deduped case-insensitively.
const handWrittenKnowsAbout = [
  "TypeScript",
  "Node.js",
  "React",
  "AWS",
  "Distributed systems",
  "Event-driven architecture",
  "Observability",
  "SOC 2",
  "HIPAA"
];
const seenKnowsAbout = new Set(handWrittenKnowsAbout.map(s => s.toLowerCase()));
const extraKnowsAbout: string[] = [];
for (const { items } of skillsCategories) {
  for (const raw of items.split(/;|—|,(?![^()]*\))/)) {
    const term = raw.trim();
    if (!term) continue;
    const key = term.toLowerCase();
    if (seenKnowsAbout.has(key)) continue;
    seenKnowsAbout.add(key);
    extraKnowsAbout.push(term);
  }
}
const knowsAbout = [...handWrittenKnowsAbout, ...extraKnowsAbout];

const personNode = {
  "@type": "Person",
  "@id": PERSON_ID,
  name: "Murugappan M",
  givenName: "Murugappan",
  // helps entity resolvers connect the sameAs profiles
  alternateName: ["murugu-21", "murugu21"],
  email: `mailto:${socialMediaLinks.gmail}`,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Bangalore",
    addressCountry: "IN"
  },
  url: `${SITE_ORIGIN}/`,
  image: {
    "@type": "ImageObject",
    url: `${SITE_ORIGIN}/og-image.png`
  },
  jobTitle: "Full Stack Engineer",
  description,
  worksFor: {
    "@type": "Organization",
    name: "MedMe Health",
    url: "https://www.medmehealth.com"
  },
  alumniOf: [
    {
      "@type": "Organization",
      name: "HyperVerge",
      url: "https://hyperverge.co"
    },
    {
      "@type": "Organization",
      name: "Samsung R&D Institute India",
      url: "https://research.samsung.com/sri-b"
    },
    {
      "@type": "CollegeOrUniversity",
      name: "Kumaraguru College of Technology",
      url: "https://kct.ac.in"
    }
  ],
  knowsAbout,
  sameAs,
  mainEntityOfPage: { "@id": `${SITE_ORIGIN}/about/` }
};
const graph: object[] = [
  {
    "@type": "WebSite",
    "@id": WEBSITE_ID,
    url: `${SITE_ORIGIN}/`,
    name: "Murugappan M, Full Stack Engineer",
    description,
    publisher: { "@id": PERSON_ID },
    inLanguage: "en"
  },
  personNode
];
if (!noindex) {
  graph.push({
    "@type": profilePage ? "ProfilePage" : "WebPage",
    "@id": canonicalUrl,
    url: canonicalUrl,
    name: title,
    isPartOf: { "@id": WEBSITE_ID },
    about: section.pageAbout,
    ...(profilePage ? { mainEntity: { "@id": PERSON_ID } } : {}),
    inLanguage: "en"
  });
}
graph.push(...pageGraph);
const jsonLd = { "@context": "https://schema.org", "@graph": graph };
// set:html doesn't escape, so a "</script>" in a post title would end the block.
const jsonLdHtml = JSON.stringify(jsonLd).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang="en" class:list={["scroll-smooth", section.htmlClass]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={pageMetaDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    {/* the entity page, kept out of the human nav */}
    <link rel="author" href="/about/" />
    {/* IANA link relations for agent discovery */}
    <link
      rel="service-desc"
      type="application/json"
      href="/openapi.json"
      title="OpenAPI 3.1.0 description of the murugappan.dev API"
    />
    <link rel="service-doc" type="text/html" href="/developers/" />
    <link
      rel="api-catalog"
      type="application/linkset+json"
      href="/.well-known/api-catalog"
      title="murugappan.dev API catalogue (RFC 9727)"
    />
    <link rel="describedby" type="text/plain" href="/llms.txt" title="Site summary for LLMs" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE_TITLE} RSS Feed`}
      href="/blog/rss.xml"
    />

    <meta property="og:type" content={article ? "article" : "website"} />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content={section.siteName} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:image" content={section.ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={section.siteName} />
    {article && (
      <>
        <meta property="article:published_time" content={article.published.toISOString()} />
        {article.tags.map(tag => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}

    <meta name="twitter:card" content="summary_large_image" />
    {!noindex && <meta name="twitter:url" content={canonicalUrl} />}
    <meta name="twitter:creator" content={twitterHandle} />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={section.ogImage} />

    <meta name="msapplication-TileColor" content="#06038d" />
    <meta name="theme-color" content="#06038d" />
    <meta name="theme-color" content="#282c35" media="(prefers-color-scheme: dark)" />

    <Favicons />

    <Font cssVariable="--font-fira-code" preload />

    <script is:inline set:html={themeBootstrapScript} />
    <script type="application/ld+json" set:html={jsonLdHtml} />
    <SiteScripts />
  </head>
  <body class={section.bodyClass}>
    <Particles class={section.particlesClass} />
    <slot />
    <ChatWidget />
  </body>
</html>
