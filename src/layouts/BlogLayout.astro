---
import Layout, { type Props as LayoutProps, type Section } from "#src/layouts/Layout.astro";
import "#src/styles/blog/code.css";
import Icon from "#src/components/Icon.astro";
import ThemeToggle from "#src/components/ThemeToggle.astro";
import { BLOG_TITLE, BLOG_DESCRIPTION } from "@murugappan/content/site.ts";
import { BLOG_URL } from "#src/lib/site.ts";

// title is omitted for the blog index, which gets the homepage title.
type Props = Pick<LayoutProps, "title" | "description" | "noindex" | "article" | "graph">;

const { title, ...rest } = Astro.props;

const blog: Section = {
  kind: "blog",
  siteName: BLOG_TITLE,
  ogImage: `${BLOG_URL}/og-image.png`,
  metaDescription: BLOG_DESCRIPTION,
  socialDescription: BLOG_DESCRIPTION
};

// Literal: the /blog prefix comes from src/pages/blog/, not Astro's `base`.
const rootPath = "/blog/";
const isRootPath = Astro.url.pathname === rootPath;
---

<Layout
  section={blog}
  title={title ? `${title} | ${BLOG_TITLE}` : `${BLOG_TITLE} | ${BLOG_DESCRIPTION}`}
  socialTitle={title ?? BLOG_TITLE}
  {...rest}
>
  {/* Bio sits in the page slot, so its index-page margin is set from the
       wrapper; (0,3,0) beats Bio's own `mb-16`. */}
  <div
    class="mx-auto max-w-2xl px-5 py-10 data-root-path:**:data-bio:mb-5 max-md:pb-24"
    data-root-path={isRootPath || undefined}
  >
    <header class="mb-12 flex flex-row items-center justify-between">
      {isRootPath ? (
        <h1 class="m-0 text-4xl font-bold tracking-tight text-title dark:text-white">
          <a class="text-inherit no-underline" href={rootPath}>
            {BLOG_TITLE}
          </a>
        </h1>
      ) : (
        <a class="text-xl font-bold text-navy no-underline dark:text-blue-light" href={rootPath}>
          {BLOG_TITLE}
        </a>
      )}
      <div class="flex items-center gap-4">
        <a
          class="inline-flex items-center text-text hover:text-navy dark:text-text-dark dark:hover:text-blue-light print:hidden"
          href={`${rootPath}rss.xml`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Subscribe via RSS"
          title="Subscribe via RSS"
        >
          <Icon name="rss" size="18px" />
        </a>
        <ThemeToggle />
      </div>
    </header>
    <main>
      <slot />
    </main>
  </div>
</Layout>
