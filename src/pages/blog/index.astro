---
import BaseLayout from "../../blog/layouts/BaseLayout.astro";
import PostList from "../../blog/components/PostList.astro";
import Bio from "../../blog/components/Bio.astro";
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL, PERSON } from "../../blog/consts";
import { SITE_ORIGIN } from "../../lib/site";
import {
  getPublishedPosts,
  postPath,
  formatDate,
  timeToRead,
  excerpt,
  type SerializedPost
} from "../../blog/utils/posts";

const posts = (await getPublishedPosts()).reverse();

const serialized: SerializedPost[] = posts.map(post => ({
  href: postPath(post.id),
  title: post.data.title,
  dateFormatted: formatDate(post.data.date),
  minutes: timeToRead(post.body),
  tags: post.data.tags,
  keywords: post.data.keywords,
  description: post.data.description,
  excerpt: excerpt(post.body)
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": `${SITE_URL}/#blog`,
  name: SITE_TITLE,
  description: SITE_DESCRIPTION,
  url: `${SITE_URL}/`,
  isPartOf: { "@id": `${SITE_ORIGIN}/#website` },
  author: PERSON,
  publisher: PERSON
};
---

{/* No title prop: BaseHead supplies the homepage title. */}
<BaseLayout jsonLd={jsonLd}>
  <PostList posts={serialized} />
  <Bio />
</BaseLayout>
