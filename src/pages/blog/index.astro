---
import BaseLayout from "../../blog/layouts/BaseLayout.astro";
import PostList from "../../blog/components/PostList.astro";
import Bio from "../../blog/components/Bio.astro";
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL, PERSON } from "../../blog/consts";
import {
  getPublishedPosts,
  postPath,
  formatDate,
  timeToRead,
  excerpt,
  type SerializedPost
} from "../../blog/utils/posts";

// Newest first, like the old index page query (sort: date DESC).
const posts = (await getPublishedPosts()).reverse();

// Flattened shape for PostList (replaces the page GraphQL query). `description`
// is intentionally left undefined when missing so the search falls back to the
// excerpt, same as before.
const serialized: SerializedPost[] = posts.map(post => ({
  href: postPath(post.id),
  title: post.data.title,
  dateFormatted: formatDate(post.data.date),
  minutes: timeToRead(post.body),
  tags: post.data.tags,
  description: post.data.description,
  excerpt: excerpt(post.body)
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": `${SITE_URL}/#blog`,
  name: SITE_TITLE,
  description: SITE_DESCRIPTION,
  url: `${SITE_URL}/`,
  isPartOf: { "@id": "https://murugappan.dev/#website" },
  author: PERSON,
  publisher: PERSON
};
---

<!-- No title prop: the homepage gets the keyword-rich
     "SDE Journey — <description>" title from BaseHead. -->
<BaseLayout jsonLd={jsonLd}>
  <PostList posts={serialized} />
  <Bio />
</BaseLayout>
