---
import BlogLayout from "#src/layouts/BlogLayout.astro";
import PostList from "#src/components/blog/PostList.astro";
import Bio from "#src/components/blog/Bio.astro";
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL } from "#src/lib/blog/consts.ts";
import { PERSON_ID, WEBSITE_ID } from "#src/lib/site.ts";
import {
  getPublishedPosts,
  postPath,
  formatDate,
  timeToRead,
  excerpt,
  type SerializedPost
} from "#src/lib/blog/posts.ts";

const posts = (await getPublishedPosts()).reverse();

const serialized: SerializedPost[] = posts.map(post => ({
  href: postPath(post.id),
  title: post.data.title,
  dateFormatted: formatDate(post.data.date),
  minutes: timeToRead(post.body),
  tags: post.data.tags,
  keywords: post.data.keywords,
  description: post.data.description,
  excerpt: excerpt(post.body)
}));

const blogNode = {
  "@type": "Blog",
  "@id": `${SITE_URL}/#blog`,
  name: SITE_TITLE,
  description: SITE_DESCRIPTION,
  url: `${SITE_URL}/`,
  isPartOf: { "@id": WEBSITE_ID },
  author: { "@id": PERSON_ID },
  publisher: { "@id": PERSON_ID }
};
---

<BlogLayout graph={[blogNode]}>
  <PostList posts={serialized} />
  <Bio />
</BlogLayout>
