---
import { render } from "astro:content";
import BaseLayout from "#src/blog/layouts/BaseLayout.astro";
import Bio from "#src/blog/components/Bio.astro";
import { SITE_TITLE, SITE_URL, PERSON } from "#src/blog/consts.ts";
import {
  getPublishedPosts,
  postPath,
  postUrl,
  postDescription,
  postKeywords,
  tagPath,
  formatDate,
  timeToRead
} from "#src/blog/utils/posts.ts";
import { formatReadingTime } from "#src/blog/utils/helpers.ts";
import { ListenControls } from "#src/blog/components/ListenControls.tsx";
import TableOfContents from "#src/blog/components/TableOfContents.astro";

// prev/next follow date-ascending order.
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      previous: posts[index - 1] ?? null,
      next: posts[index + 1] ?? null
    }
  }));
}

const { post, previous, next } = Astro.props;
// rehypeHeadingIds runs in astro.config before the autolink plugin; Astro's own
// pass afterwards keeps those ids, so `headings` matches the anchors.
const { Content, headings } = await render(post);

const description = postDescription(post);

const url = postUrl(post.id);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description,
  url,
  mainEntityOfPage: { "@type": "WebPage", "@id": url },
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  keywords: postKeywords(post).join(", "),
  image: `${SITE_URL}/og-image.png`,
  author: PERSON,
  publisher: PERSON,
  isPartOf: {
    "@type": "Blog",
    "@id": `${SITE_URL}/#blog`,
    name: SITE_TITLE,
    url: `${SITE_URL}/`
  }
};
---

<BaseLayout
  title={post.data.title}
  description={description}
  ogType="article"
  publishedTime={post.data.date}
  tags={postKeywords(post)}
  jsonLd={jsonLd}
>
  <article class="blog-post" itemscope itemtype="http://schema.org/Article">
    <header>
      <h1 itemprop="headline">{post.data.title}</h1>
      <p>
        {formatDate(post.data.date)}
        {` • ${formatReadingTime(timeToRead(post.body))}`}
      </p>
      {/* Each tag links to /blog/?tag=…, the URL the index's own chips write.
           `no-underline` beats `.blog-post a`'s underline. */}
      <div class="mb-4 flex flex-row flex-wrap gap-[10px]">
        {post.data.tags.map(tag => (
          <a
            href={tagPath(tag)}
            aria-label={`All posts tagged ${tag}`}
            class="border border-chip-outline px-[.5em] py-[3px] text-[0.833rem] no-underline dark:border-chip-outline-dark"
          >
            {/* inline-block so the selection hugs the text; otherwise Chrome
                  paints it over the chip padding plus a line-end marker. */}
            <span class="inline-block">{tag}</span>
          </a>
        ))}
      </div>
    </header>
    {/* Read-aloud island; ships disabled at full size so hydration doesn't
         shift layout. `ui-island` scopes the shadcn tokens. Sticky only while
         `.listening` (set by the island), and a direct child of the article
         because sticky only travels inside its parent. `pt-3` is always there
         so the layout never shifts; post.css scroll-margin-top clears the
         12+58px pinned bar. */}
    <div class="listen-sentinel h-px -mb-px" aria-hidden="true"></div>
    <div class="listen-island ui-island mb-4 pt-3 [&.listening]:sticky [&.listening]:top-0 [&.listening]:z-30 [&.listening.pinned]:bg-nav-scrolled [&.listening.pinned]:backdrop-blur-[15px] dark:[&.listening.pinned]:bg-nav-scrolled-dark">
      {/* client:interaction, not client:idle: idle can fire before first paint
          and charge ~100 KB to FCP/LCP. Trade-off: a first-touch tap on Play
          lands on the disabled button. */}
      <ListenControls client:interaction slug={post.id} />
    </div>
    <section itemprop="articleBody">
      <Content />
    </section>
    <hr />
    <footer class="py-6">
      <Bio />
    </footer>
  </article>
  {/* After the article, not inside it: see the component header. */}
  <TableOfContents headings={headings} />
  <nav aria-label="Previous and next posts">
    <ul class="m-0 flex list-none flex-wrap justify-between p-0">
      <li class="mb-4 pl-0">
        {previous && (
          <a
            href={postPath(previous.id)}
            rel="prev"
            class="text-navy underline hover:no-underline focus:no-underline dark:text-blue-light"
          >
            ← {previous.data.title}
          </a>
        )}
      </li>
      <li class="mb-4 pl-0">
        {next && (
          <a
            href={postPath(next.id)}
            rel="next"
            class="text-navy underline hover:no-underline focus:no-underline dark:text-blue-light"
          >
            {next.data.title} →
          </a>
        )}
      </li>
    </ul>
  </nav>
</BaseLayout>

<script>
  // `.pinned` once the sentinel scrolls out: paints the frosted band behind a
  // docked bar's gap. Styling only.
  const sentinel = document.querySelector<HTMLElement>(".listen-sentinel");
  const island = document.querySelector<HTMLElement>(".listen-island");
  if (sentinel && island) {
    new IntersectionObserver(([entry]) => {
      island.classList.toggle("pinned", !entry.isIntersecting && entry.boundingClientRect.top < 0);
    }).observe(sentinel);
  }
</script>

<script>
  // Image zoom, loaded on hover/click. Scoped to the body <section> to skip the Bio avatar.
  const imgs = document.querySelectorAll<HTMLImageElement>("article.blog-post section img");
  if (imgs.length > 0) {
    let zoomPromise: Promise<ReturnType<typeof import("medium-zoom").default>> | null = null;
    const loadZoom = () =>
      (zoomPromise ??= import("medium-zoom").then(({ default: mediumZoom }) =>
        mediumZoom(imgs, { margin: 24, background: "rgba(0, 0, 0, 0.85)" })
      ));
    imgs.forEach(img => {
      img.addEventListener("pointerenter", () => void loadZoom(), {
        once: true
      });
      img.addEventListener(
        "click",
        async event => {
          // Linked images point at unemitted source files, so following them 404s.
          if (img.closest("a")) event.preventDefault();
          const zoom = await loadZoom();
          // After a hover preload the library's own click handler may have opened it.
          if (!document.querySelector(".medium-zoom-image--opened")) {
            zoom.open({ target: img });
          }
        },
        { once: true }
      );
    });
  }
</script>
