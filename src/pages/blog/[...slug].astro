---
import { render } from "astro:content";
import BaseLayout from "../../blog/layouts/BaseLayout.astro";
import Bio from "../../blog/components/Bio.astro";
import { SITE_TITLE, SITE_URL, PERSON } from "../../blog/consts";
import {
  getPublishedPosts,
  postPath,
  postKeywords,
  tagPath,
  formatDate,
  timeToRead,
  excerpt
} from "../../blog/utils/posts";
import { formatReadingTime } from "../../blog/utils/helpers";
import { ListenControls } from "../../blog/components/ListenControls";

// One page per post; prev/next wired in date-ASC order, exactly like the old
// gatsby-node.js createPages loop.
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      previous: index === 0 ? null : posts[index - 1],
      next: index === posts.length - 1 ? null : posts[index + 1]
    }
  }));
}

const { post, previous, next } = Astro.props;
const { Content } = await render(post);

const description = post.data.description || excerpt(post.body);

const postUrl = `${SITE_URL}/${post.id}/`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description,
  url: postUrl,
  mainEntityOfPage: { "@type": "WebPage", "@id": postUrl },
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  keywords: postKeywords(post).join(", "),
  image: `${SITE_URL}/og-image.png`,
  author: PERSON,
  publisher: PERSON,
  isPartOf: {
    "@type": "Blog",
    "@id": `${SITE_URL}/#blog`,
    name: SITE_TITLE,
    url: `${SITE_URL}/`
  }
};
---

<BaseLayout
  title={post.data.title}
  description={description}
  ogType="article"
  publishedTime={post.data.date}
  tags={postKeywords(post)}
  jsonLd={jsonLd}
>
  <article class="blog-post" itemscope itemtype="http://schema.org/Article">
    <header>
      <h1 itemprop="headline">{post.data.title}</h1>
      <p>
        {formatDate(post.data.date)}
        {` • ${formatReadingTime(timeToRead(post.body))}`}
      </p>
      {
        /* The post's tags, each linking into the index filtered by that tag
           (/blog/?tag=…, the same URL the index's own chips write — the index
           script checks the matching chip on load). Chips match the index's
           per-post chips (Post.astro) but read as links: `no-underline` beats
           `.blog-post a`'s restated UA underline, while the shared navy /
           blue-light `a` colours and the amber hover stay. */
      }
      <div class="mb-4 flex flex-row flex-wrap gap-[10px]">
        {
          post.data.tags.map(tag => (
            <a
              href={tagPath(tag)}
              aria-label={`All posts tagged ${tag}`}
              class="border border-chip-outline px-[.5em] py-[3px] text-[0.833rem] no-underline dark:border-chip-outline-dark"
            >
              {/* The label sits in its own span so the selection highlight (and
                  therefore a copy) hugs the text: painted straight on the chip,
                  the selection covers its padding and runs to the border. */}
              <span>{tag}</span>
            </a>
          ))
        }
      </div>
    </header>
    <!-- Read-aloud controls: a shadcn island (src/blog/components). Ships a
         full-size disabled control in the server HTML — hydration only enables
         it, so nothing shifts — and stays disabled where the page has neither
         speech synthesis nor audio. `mb-4` is the old `.listen-island {
         margin-bottom: var(--spacing-4) }`; both class names stay, `ui-island`
         being what scopes the shadcn tokens the controls read.
         Sticky only while a session is live: the island toggles `.listening`
         on this wrapper from the first press of Play through every pause, and
         drops it when the reading finishes, so an unused (or finished) player
         stays in the page flow instead of following the reader. A docked
         transport pins to the top edge — the page's own header scrolls away and
         the chat launcher owns the bottom-right corner. Sticky only travels
         inside its parent, which is why the wrapper is a direct child of the
         article, not a child of <header>. `pt-3` is the visible gap between
         viewport top and card while pinned — always present so the layout never
         shifts when the state flips. The script at the bottom of this file
         toggles `.pinned` once the 1px sentinel above has scrolled out; for a
         docked bar that paints the frosted band behind the gap (same surface as
         the portfolio nav's `.scrolled`). Headings and the read-aloud highlight
         carry scroll-margin-top in post.css so nothing lands under the 12+58px
         the pinned bar occupies. -->
    <div class="listen-sentinel h-px -mb-px" aria-hidden="true"></div>
    <div
      class="listen-island ui-island mb-4 pt-3 [&.listening]:sticky [&.listening]:top-0 [&.listening]:z-30 [&.listening.pinned]:bg-nav-scrolled [&.listening.pinned]:backdrop-blur-[15px] dark:[&.listening.pinned]:bg-nav-scrolled-dark"
    >
      {
        /* client:interaction (the chat island's directive, src/directives): the
          controls ship disabled until hydrated anyway, so React + Radix
          (~100 KB) load on the first pointer/touch/key/wheel input instead of
          during page load. client:idle was not enough: on a fast device idle
          fires before first paint, so Lighthouse still charged the bundle to
          FCP/LCP (post pages 96-97 vs the index's 100). Trade-off: a tap on
          Play as the very first touch lands on the disabled button and needs
          a second tap ~300 ms later. */
      }
      <ListenControls client:interaction slug={post.id} />
    </div>
    <section itemprop="articleBody">
      <Content />
    </section>
    <!-- The old global `hr { background: var(--color-accent); height: 1px;
         border: 0 }` lives on as `.blog-post hr` in post.css (it also restores
         the UA `margin: 0.5em auto`), so this element needs no utilities. -->
    <hr />
    <!-- The old global `footer { padding: 1.5rem 0 }`. -->
    <footer class="py-6">
      <Bio />
    </footer>
  </article>
  <nav class="blog-post-nav">
    <!-- `.blog-post-nav ul { margin: 0 }` plus what used to be this element's
         inline style attribute (flex row, wrapping, space-between, no markers,
         no padding). -->
    <ul class="m-0 flex list-none flex-wrap justify-between p-0">
      <!-- The old global `ul li, ol li { padding-left: 0; margin-bottom:
           calc(2rem / 2) }`, which preflight zeroes. -->
      <li class="mb-4 pl-0">
        {
          previous && (
            // The old global `a { color: var(--color-primary) }` + the UA
            // underline preflight drops; `a:hover, a:focus` removed it.
            <a
              href={postPath(previous.id)}
              rel="prev"
              class="text-navy underline hover:no-underline focus:no-underline dark:text-blue-light"
            >
              ← {previous.data.title}
            </a>
          )
        }
      </li>
      <li class="mb-4 pl-0">
        {
          next && (
            <a
              href={postPath(next.id)}
              rel="next"
              class="text-navy underline hover:no-underline focus:no-underline dark:text-blue-light"
            >
              {next.data.title} →
            </a>
          )
        }
      </li>
    </ul>
  </nav>
</BaseLayout>

<script>
  // Pin state for the read-aloud transport. A 1px sentinel sits just above the
  // bar; once it leaves the top of the viewport `.pinned` is set, and for a
  // docked bar (`.listening`, toggled by the island) that paints the frosted
  // band behind the gap — see the wrapper in this file and post.css. Styling
  // only: without it a docked bar still sticks, just with a transparent gap.
  const sentinel = document.querySelector<HTMLElement>(".listen-sentinel");
  const island = document.querySelector<HTMLElement>(".listen-island");
  if (sentinel && island) {
    new IntersectionObserver(([entry]) => {
      island.classList.toggle("pinned", !entry.isIntersecting && entry.boundingClientRect.top < 0);
    }).observe(sentinel);
  }
</script>

<script>
  // Notion-style image zoom, loaded lazily: zero zoom JS ships unless the
  // reader shows intent (hover or click on a post image).
  // Scoped to the articleBody <section>: the Bio avatar in the article footer
  // is not zoomable content.
  const imgs = document.querySelectorAll<HTMLImageElement>("article.blog-post section img");
  if (imgs.length > 0) {
    let zoomPromise: Promise<ReturnType<typeof import("medium-zoom").default>> | null = null;
    const loadZoom = () =>
      (zoomPromise ??= import("medium-zoom").then(({ default: mediumZoom }) =>
        mediumZoom(imgs, { margin: 24, background: "rgba(0, 0, 0, 0.85)" })
      ));
    imgs.forEach(img => {
      img.addEventListener("pointerenter", () => void loadZoom(), {
        once: true
      });
      img.addEventListener(
        "click",
        async event => {
          // An image wrapped in a markdown link ([![alt](x.jpg)](x.jpg)) would
          // navigate away before the zoom opens. Those hrefs point at the
          // source file next to index.md, which is never emitted as a public
          // asset, so following them 404s. Zoom is the click-to-view path.
          if (img.closest("a")) event.preventDefault();
          const zoom = await loadZoom();
          // If the library's own click handler already opened it (it attaches
          // on init after a hover preload), don't double-open.
          if (!document.querySelector(".medium-zoom-image--opened")) {
            zoom.open({ target: img });
          }
        },
        { once: true }
      );
    });
  }
</script>
