---
import { render } from "astro:content";
import BlogLayout from "#src/layouts/BlogLayout.astro";
import Bio from "#src/components/blog/Bio.astro";
import { blog, blogPosting } from "#src/lib/blog/schema.ts";
import {
  getPublishedPosts,
  postPath,
  postDescription,
  postKeywords,
  tagPath,
  formatDate,
  timeToRead,
  formatReadingTime
} from "#src/lib/blog/posts.ts";
import { ListenControls } from "#src/components/blog/ListenControls.tsx";
import TableOfContents from "#src/components/blog/TableOfContents.astro";
import Prose from "#src/components/Prose.astro";

// previous is the older post, next the newer one; the list is newest first.
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      previous: posts[index + 1] ?? null,
      next: posts[index - 1] ?? null
    }
  }));
}

const { post, previous, next } = Astro.props;
// rehypeHeadingIds runs in astro.config before the autolink plugin; Astro's own
// pass afterwards keeps those ids, so `headings` matches the anchors.
const { Content, headings } = await render(post);

const description = postDescription(post);
---

<BlogLayout
  graph={[blog, blogPosting(post)]}
  title={post.data.title}
  description={description}
  article={{ published: post.data.date, tags: postKeywords(post) }}
>
  {/* data-speaking marks the block being read aloud (listen-player.ts); the
       scroll margin clears the 12+58px pinned read-aloud bar. */}
  <Prose
    as="article"
    class="**:data-speaking:scroll-mt-20 **:data-speaking:rounded-sm **:data-speaking:bg-amber/14 **:data-speaking:ring-6 **:data-speaking:ring-amber/14 **:data-speaking:transition motion-reduce:**:data-speaking:transition-none dark:**:data-speaking:bg-box-dark/14 dark:**:data-speaking:ring-box-dark/14 prose-img:cursor-zoom-in"
  >
    <header>
      <h1 data-post-title>{post.data.title}</h1>
      <p>
        {formatDate(post.data.date)}
        {` • ${formatReadingTime(timeToRead(post.body))}`}
      </p>
      {/* Each tag links to /blog/?tag=…, the URL the index's own chips write. */}
      <div class="not-prose mb-4 flex flex-row flex-wrap gap-2.5">
        {post.data.tags.map(tag => (
          <a
            href={tagPath(tag)}
            aria-label={`All posts tagged ${tag}`}
            class="border border-chip-outline px-2 py-0.5 text-sm text-navy dark:border-chip-outline-dark dark:text-blue-light"
          >
            {/* inline-block so the selection hugs the text; otherwise Chrome
                  paints it over the chip padding plus a line-end marker. */}
            <span class="inline-block">{tag}</span>
          </a>
        ))}
      </div>
    </header>
    {/* Read-aloud island; ships disabled at full size so hydration doesn't
         shift layout. `ui-island` scopes the shadcn tokens. Sticky only while
         `data-listening` (set by the island), and a direct child of the article
         because sticky only travels inside its parent. `pt-3` is always there
         so the layout never shifts. */}
    <div class="-mb-px h-px" aria-hidden="true" data-listen-sentinel></div>
    <div
      class="not-prose mb-4 ui-island pt-3 data-listening:sticky data-listening:top-0 data-listening:z-30 data-listening:data-pinned:bg-nav-scrolled data-listening:data-pinned:backdrop-blur-lg dark:data-listening:data-pinned:bg-nav-scrolled-dark print:hidden"
      data-listen-island
    >
      {/* client:interaction, not client:idle: idle can fire before first paint
          and charge ~100 KB to FCP/LCP. Trade-off: a first-touch tap on Play
          lands on the disabled button. */}
      <ListenControls client:interaction slug={post.id} />
    </div>
    <section data-post-body>
      <Content />
    </section>
    <hr />
    <footer class="not-prose py-6">
      <Bio />
    </footer>
  </Prose>
  {/* After the article, not inside it: see the component header. */}
  <TableOfContents headings={headings} />
  <nav aria-label="Previous and next posts">
    <ul class="m-0 flex list-none flex-wrap justify-between p-0">
      <li class="mb-4 pl-0">
        {previous && (
          <a
            href={postPath(previous.id)}
            rel="prev"
            class="text-navy underline hover:no-underline focus:no-underline dark:text-blue-light"
          >
            ← {previous.data.title}
          </a>
        )}
      </li>
      <li class="mb-4 pl-0">
        {next && (
          <a
            href={postPath(next.id)}
            rel="next"
            class="text-navy underline hover:no-underline focus:no-underline dark:text-blue-light"
          >
            {next.data.title} →
          </a>
        )}
      </li>
    </ul>
  </nav>
</BlogLayout>

<script>
  // `data-pinned` once the sentinel scrolls out: paints the frosted band behind a
  // docked bar's gap. Styling only.
  const sentinel = document.querySelector<HTMLElement>("[data-listen-sentinel]");
  const island = document.querySelector<HTMLElement>("[data-listen-island]");
  if (sentinel && island) {
    new IntersectionObserver(([entry]) => {
      island.toggleAttribute(
        "data-pinned",
        !entry.isIntersecting && entry.boundingClientRect.top < 0
      );
    }).observe(sentinel);
  }
</script>

<script>
  // Image zoom, loaded on hover/click. Scoped to the body <section> to skip the Bio avatar.
  const imgs = document.querySelectorAll<HTMLImageElement>("[data-post-body] img");
  if (imgs.length > 0) {
    let zoomPromise: Promise<ReturnType<typeof import("medium-zoom").default>> | null = null;
    const loadZoom = () =>
      (zoomPromise ??= import("medium-zoom").then(({ default: mediumZoom }) =>
        mediumZoom(imgs, { margin: 24, background: "rgba(0, 0, 0, 0.85)" })
      ));
    imgs.forEach(img => {
      img.addEventListener("pointerenter", () => void loadZoom(), {
        once: true
      });
      img.addEventListener(
        "click",
        async event => {
          // Linked images point at unemitted source files, so following them 404s.
          if (img.closest("a")) event.preventDefault();
          const zoom = await loadZoom();
          // After a hover preload the library's own click handler may have opened it.
          if (!document.querySelector(".medium-zoom-image--opened")) {
            zoom.open({ target: img });
          }
        },
        { once: true }
      );
    });
  }
</script>
