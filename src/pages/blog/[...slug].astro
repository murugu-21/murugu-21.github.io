---
import { render } from "astro:content";
import BaseLayout from "../../blog/layouts/BaseLayout.astro";
import Bio from "../../blog/components/Bio.astro";
import { SITE_TITLE, SITE_URL, PERSON } from "../../blog/consts";
import {
  getPublishedPosts,
  postPath,
  formatDate,
  timeToRead,
  excerpt
} from "../../blog/utils/posts";
import { formatReadingTime } from "../../blog/utils/helpers";
import { ListenControls } from "../../blog/components/ListenControls";

// One page per post; prev/next wired in date-ASC order, exactly like the old
// gatsby-node.js createPages loop.
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      previous: index === 0 ? null : posts[index - 1],
      next: index === posts.length - 1 ? null : posts[index + 1]
    }
  }));
}

const { post, previous, next } = Astro.props;
const { Content } = await render(post);

const description = post.data.description || excerpt(post.body);

const postUrl = `${SITE_URL}/${post.id}/`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description,
  url: postUrl,
  mainEntityOfPage: { "@type": "WebPage", "@id": postUrl },
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  keywords: post.data.tags.join(", "),
  image: `${SITE_URL}/og-image.png`,
  author: PERSON,
  publisher: PERSON,
  isPartOf: {
    "@type": "Blog",
    "@id": `${SITE_URL}/#blog`,
    name: SITE_TITLE,
    url: `${SITE_URL}/`
  }
};
---

<BaseLayout
  title={post.data.title}
  description={description}
  ogType="article"
  publishedTime={post.data.date}
  tags={post.data.tags}
  jsonLd={jsonLd}
>
  <article class="blog-post" itemscope itemtype="http://schema.org/Article">
    <header>
      <h1 itemprop="headline">{post.data.title}</h1>
      <p>
        {formatDate(post.data.date)}
        {` • ${formatReadingTime(timeToRead(post.body))}`}
      </p>
      <!-- Read-aloud controls: a shadcn island (src/blog/components). Renders
           nothing until hydrated, and nothing at all without a speech or
           audio backend. `mb-4` is the old `.listen-island { margin-bottom:
           var(--spacing-4) }`; both class names stay, `ui-island` being what
           scopes the shadcn tokens the controls read. -->
      <div class="listen-island ui-island mb-4">
        <ListenControls client:load slug={post.id} />
      </div>
    </header>
    <section itemprop="articleBody">
      <Content />
    </section>
    <!-- The old global `hr { background: var(--color-accent); height: 1px;
         border: 0 }` lives on as `.blog-post hr` in post.css (it also restores
         the UA `margin: 0.5em auto`), so this element needs no utilities. -->
    <hr />
    <!-- The old global `footer { padding: 1.5rem 0 }`. -->
    <footer class="py-6">
      <Bio />
    </footer>
  </article>
  <nav class="blog-post-nav">
    <!-- `.blog-post-nav ul { margin: 0 }` plus what used to be this element's
         inline style attribute (flex row, wrapping, space-between, no markers,
         no padding). -->
    <ul class="m-0 flex list-none flex-wrap justify-between p-0">
      <!-- The old global `ul li, ol li { padding-left: 0; margin-bottom:
           calc(2rem / 2) }`, which preflight zeroes. -->
      <li class="mb-4 pl-0">
        {
          previous && (
            // The old global `a { color: var(--color-primary) }` + the UA
            // underline preflight drops; `a:hover, a:focus` removed it.
            <a
              href={postPath(previous.id)}
              rel="prev"
              class="text-navy underline hover:no-underline focus:no-underline dark:text-blue-light"
            >
              ← {previous.data.title}
            </a>
          )
        }
      </li>
      <li class="mb-4 pl-0">
        {
          next && (
            <a
              href={postPath(next.id)}
              rel="next"
              class="text-navy underline hover:no-underline focus:no-underline dark:text-blue-light"
            >
              {next.data.title} →
            </a>
          )
        }
      </li>
    </ul>
  </nav>
</BaseLayout>

<script>
  // Notion-style image zoom, loaded lazily: zero zoom JS ships unless the
  // reader shows intent (hover or click on a post image).
  // Scoped to the articleBody <section>: the Bio avatar in the article footer
  // is not zoomable content.
  const imgs = document.querySelectorAll<HTMLImageElement>("article.blog-post section img");
  if (imgs.length > 0) {
    let zoomPromise: Promise<ReturnType<typeof import("medium-zoom").default>> | null = null;
    const loadZoom = () =>
      (zoomPromise ??= import("medium-zoom").then(({ default: mediumZoom }) =>
        mediumZoom(imgs, { margin: 24, background: "rgba(0, 0, 0, 0.85)" })
      ));
    imgs.forEach(img => {
      img.addEventListener("pointerenter", () => void loadZoom(), {
        once: true
      });
      img.addEventListener(
        "click",
        async event => {
          // An image wrapped in a markdown link ([![alt](x.jpg)](x.jpg)) would
          // navigate away before the zoom opens. Those hrefs point at the
          // source file next to index.md, which is never emitted as a public
          // asset, so following them 404s. Zoom is the click-to-view path.
          if (img.closest("a")) event.preventDefault();
          const zoom = await loadZoom();
          // If the library's own click handler already opened it (it attaches
          // on init after a hover preload), don't double-open.
          if (!document.querySelector(".medium-zoom-image--opened")) {
            zoom.open({ target: img });
          }
        },
        { once: true }
      );
    });
  }
</script>
