---
// Canonical entity page (schema.org ProfilePage), sourced only from
// src/data/portfolio.ts + resume.ts.
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import ScrollTop from "../components/ScrollTop.astro";
import {
  greeting,
  workExperiences,
  skillsCategories,
  educationInfo,
  openSourceCard,
  socialMediaLinks
} from "../data/portfolio";
import { resumeContact } from "../data/resume";
import { groupByCompany } from "../lib/experience";
import { linkCls, linksUl, proseLi, proseP, proseUl } from "../lib/prose";

// Groups by *consecutive* company, so returning to an employer stays two entries.
const stints = groupByCompany(workExperiences);

const links = [
  { label: "GitHub", href: socialMediaLinks.github },
  { label: "LinkedIn", href: socialMediaLinks.linkedin },
  { label: "X / Twitter", href: socialMediaLinks.twitter },
  { label: "Blog", href: "/blog/" },
  { label: "Resume (PDF)", href: greeting.resumePath },
  {
    label: `Email: ${socialMediaLinks.gmail}`,
    href: `mailto:${socialMediaLinks.gmail}`
  }
];

const h2Cls = "mt-9 mb-3 text-[1.5rem] font-bold";
const h3Cls = "mt-5 mb-1 text-[1.1rem] font-bold";
const metaP = "my-[1em] leading-[1.6] text-subtitle dark:text-white/65";
---

<Layout
  title="About Murugappan M | Full Stack Engineer | TypeScript, Node.js, React & AWS"
  profilePage
>
  <Header />
  <main class="box-content mx-auto max-w-[760px] px-5 pt-28 pb-16">
    <h1 class="mt-[0.67em] mb-2 text-[clamp(1.7rem,6vw,2.2rem)] font-bold">
      About {resumeContact.name}
    </h1>
    <p class="my-[1em] text-[1.15rem] leading-[1.6]">{greeting.subTitle}</p>
    <p class={metaP}>
      {resumeContact.title} · {resumeContact.location} · currently at{" "}
      <a href="https://www.medmehealth.com" class={linkCls}>
        MedMe Health
      </a>
    </p>

    <ul class={linksUl}>
      {links.map(l => (
        <li class={proseLi}>
          <a href={l.href} class={linkCls}>
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <section>
      <h2 class={h2Cls}>Experience</h2>
      {stints.map(stint => (
        <article>
          <h3 class={h3Cls}>{stint.company}</h3>
          <p class={metaP}>
            {stint.span}
            {stint.location && ` \u00b7 ${stint.location}`}
          </p>
          {stint.roles.map(job => (
            <div class="pl-4">
              <h4 class="mt-4 mb-[0.15rem] text-[1rem] font-bold">
                {job.role}
                {job.partTime && " (Part-time)"}
              </h4>
              {/* a lone role's dates already sit under the company name */}
              {stint.roles.length > 1 && (
                <p class={metaP}>
                  {job.date}
                  {!stint.location && ` \u00b7 ${job.location}`}
                </p>
              )}
              <p class={proseP}>{job.desc}</p>
              {job.descBullets && (
                <ul class={proseUl}>
                  {job.descBullets.map(b => (
                    <li class={proseLi}>{b}</li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </article>
      ))}
    </section>

    <section>
      <h2 class={h2Cls}>Skills</h2>
      <ul class={proseUl}>
        {skillsCategories.map(c => (
          <li class={proseLi}>
            <strong class="font-bold">{c.category}:</strong> {c.items}
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class={h2Cls}>Education</h2>
      {educationInfo.map(school => (
        <article>
          <h3 class={h3Cls}>{school.schoolName}</h3>
          <p class={metaP}>
            {school.subHeader} · {school.duration}
          </p>
          <ul class={proseUl}>
            {school.descBullets.map(b => (
              <li class={proseLi}>{b}</li>
            ))}
          </ul>
        </article>
      ))}
    </section>

    <section>
      <h2 class={h2Cls}>Open source</h2>
      <p class={proseP}>{openSourceCard.subtitle}</p>
      <ul class={linksUl}>
        {openSourceCard.footerLink.map(l => (
          <li class={proseLi}>
            <a href={l.url} class={linkCls}>
              {l.name}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class={h2Cls}>For AI agents</h2>
      <p class={proseP}>
        This page is the canonical source of truth about Murugappan M. A machine-readable version
        lives at{" "}
        <a href="/llms.txt" class={linkCls}>
          /llms.txt
        </a>
        ; every page on this site also serves markdown via <code>Accept: text/markdown</code>, and
        full blog content is at{" "}
        <a href="/blog/llms-full.txt" class={linkCls}>
          /blog/llms-full.txt
        </a>
        .
      </p>
      <p class={proseP}>
        A public, unauthenticated API also serves everything on this page as JSON. Start with{" "}
        <a href="/api/v1/profile" class={linkCls}>
          <code>GET /api/v1/profile</code>
        </a>
        . The full contract is the{" "}
        <a href="/openapi.json" class={linkCls}>
          OpenAPI 3.1.0 spec
        </a>
        . The{" "}
        <a href="/developers/" class={linkCls}>
          developer portal
        </a>{" "}
        documents the endpoints, versioning policy and rate-limit headers. There is an{" "}
        <a href="/mcp" class={linkCls}>
          MCP server
        </a>{" "}
        with a{" "}
        <a href="/.well-known/mcp.json" class={linkCls}>
          manifest
        </a>
        , and{" "}
        <a href="/AGENTS.md" class={linkCls}>
          /AGENTS.md
        </a>{" "}
        says when to use this site and which call to make.
      </p>
    </section>
  </main>
  <ScrollTop />
</Layout>
