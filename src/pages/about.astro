---
// Canonical entity page: the one URL that is the source of truth about
// Murugappan for both humans and machines (LLMs, crawlers). Everything here
// is sourced from src/data/portfolio.ts + resume.ts — no copy of its own —
// and the Layout marks it up as a schema.org ProfilePage whose mainEntity
// is the site-wide Person node.
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import ScrollTop from "../components/ScrollTop.astro";
import {
  greeting,
  workExperiences,
  skillsCategories,
  educationInfo,
  openSourceCard,
  socialMediaLinks
} from "../data/portfolio";
import {resumeContact} from "../data/resume";
import {groupByCompany} from "../lib/experience";

// Roles are grouped into company stints so a promotion ladder reads as one
// employer rather than three. Grouping is by *consecutive* company, so a
// return to a former employer after a gap stays two entries.
const stints = groupByCompany(workExperiences);

const links = [
  {label: "GitHub", href: socialMediaLinks.github},
  {label: "LinkedIn", href: socialMediaLinks.linkedin},
  {label: "X / Twitter", href: socialMediaLinks.twitter},
  {label: "Blog", href: "/blog/"},
  {label: "Resume (PDF)", href: greeting.resumePath},
  {
    label: `Email: ${socialMediaLinks.gmail}`,
    href: `mailto:${socialMediaLinks.gmail}`
  }
];
---

<Layout
  title="About Murugappan M | Full Stack Engineer — TypeScript, Node.js, React & AWS"
  profilePage
>
  <Header />
  <main class="about-page">
    <h1>About {resumeContact.name}</h1>
    <p class="pitch">{greeting.subTitle}</p>
    <p class="facts">
      {resumeContact.title} · {resumeContact.location} · currently at{" "}
      <a href="https://www.medmehealth.com">MedMe Health</a>
    </p>

    <ul class="links">
      {
        links.map(l => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))
      }
    </ul>

    <section>
      <h2>Experience</h2>
      {
        stints.map(stint => (
          <article class="stint">
            <h3>{stint.company}</h3>
            <p class="meta">
              {stint.span}
              {stint.location && ` \u00b7 ${stint.location}`}
            </p>
            {stint.roles.map(job => (
              <div class="job">
                <h4>
                  {job.role}
                  {job.partTime && " (Part-time)"}
                </h4>
                {/* a lone role's dates already sit under the company name */}
                {stint.roles.length > 1 && (
                  <p class="meta">
                    {job.date}
                    {!stint.location && ` \u00b7 ${job.location}`}
                  </p>
                )}
                <p>{job.desc}</p>
                {job.descBullets && (
                  <ul>
                    {job.descBullets.map(b => (
                      <li>{b}</li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </article>
        ))
      }
    </section>

    <section>
      <h2>Skills</h2>
      <ul>
        {
          skillsCategories.map(c => (
            <li>
              <strong>{c.category}:</strong> {c.items}
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2>Education</h2>
      {
        educationInfo.map(school => (
          <article class="job">
            <h3>{school.schoolName}</h3>
            <p class="meta">
              {school.subHeader} · {school.duration}
            </p>
            <ul>
              {school.descBullets.map(b => (
                <li>{b}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </section>

    <section>
      <h2>Open source</h2>
      <p>{openSourceCard.subtitle}</p>
      <ul class="links">
        {
          openSourceCard.footerLink.map(l => (
            <li>
              <a href={l.url}>{l.name}</a>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2>For AI agents</h2>
      <p>
        This page is the canonical source of truth about Murugappan M. A
        machine-readable version lives at{" "}
        <a href="/llms.txt">/llms.txt</a>; every page on this site also serves
        markdown via <code>Accept: text/markdown</code>, and full blog content
        is at <a href="/blog/llms-full.txt">/blog/llms-full.txt</a>.
      </p>
      <p>
        Everything on this page is also served as JSON by a public,
        unauthenticated API — start with{" "}
        <a href="/api/v1/profile">
          <code>GET /api/v1/profile</code>
        </a>
        . The full contract is the{" "}
        <a href="/openapi.json">OpenAPI 3.1.0 spec</a>, the endpoints,
        versioning policy and rate-limit headers are documented in the{" "}
        <a href="/developers/">developer portal</a>, there is an{" "}
        <a href="/mcp">MCP server</a> with a{" "}
        <a href="/.well-known/mcp.json">manifest</a>, and{" "}
        <a href="/AGENTS.md">/AGENTS.md</a> says when to reach for this site and which
        call to make.
      </p>
    </section>
  </main>
  <ScrollTop />
</Layout>

<style lang="scss">
  @import "../styles/variables";

  .about-page {
    max-width: 760px;
    margin: 0 auto;
    /* the fixed navbar overlaps the top of the page (same as the homepage) */
    padding: 7rem 1.25rem 4rem;

    h1 {
      font-size: clamp(1.7rem, 6vw, 2.2rem);
      margin-bottom: 0.5rem;
    }

    h2 {
      font-size: 1.5rem;
      margin: 2.25rem 0 0.75rem;
    }

    h3 {
      font-size: 1.1rem;
      margin: 1.25rem 0 0.25rem;
    }

    h4 {
      font-size: 1rem;
      margin: 1rem 0 0.15rem;
    }

    /* roles read as subsections of their company stint */
    .stint .job {
      padding-left: 1rem;
    }

    p,
    li {
      line-height: 1.6;
    }

    a {
      color: $accentLight;
      text-decoration: none;

      &:hover {
        text-decoration: underline;
      }
    }

    .pitch {
      font-size: 1.15rem;
    }

    .facts,
    .meta {
      color: $subTitle;
    }

    .links {
      list-style: none;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem 1.25rem;
    }

    section ul:not(.links) {
      padding-left: 1.25rem;
    }
  }

  :global(html.dark-mode) .about-page a {
    color: $accentDark;
  }
</style>
