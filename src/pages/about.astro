---
// Canonical entity page: the one URL that is the source of truth about
// Murugappan for both humans and machines (LLMs, crawlers). Everything here
// is sourced from src/data/portfolio.ts + resume.ts — no copy of its own —
// and the Layout marks it up as a schema.org ProfilePage whose mainEntity
// is the site-wide Person node.
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import ScrollTop from "../components/ScrollTop.astro";
import {
  greeting,
  workExperiences,
  skillsCategories,
  educationInfo,
  openSourceCard,
  socialMediaLinks
} from "../data/portfolio";
import { resumeContact } from "../data/resume";
import { groupByCompany } from "../lib/experience";

// Roles are grouped into company stints so a promotion ladder reads as one
// employer rather than three. Grouping is by *consecutive* company, so a
// return to a former employer after a gap stays two entries.
const stints = groupByCompany(workExperiences);

const links = [
  { label: "GitHub", href: socialMediaLinks.github },
  { label: "LinkedIn", href: socialMediaLinks.linkedin },
  { label: "X / Twitter", href: socialMediaLinks.twitter },
  { label: "Blog", href: "/blog/" },
  { label: "Resume (PDF)", href: greeting.resumePath },
  {
    label: `Email: ${socialMediaLinks.gmail}`,
    href: `mailto:${socialMediaLinks.gmail}`
  }
];

// One <a> look for the whole page (was the `.about-page a` rule plus its
// html.dark-mode override): navy, undecorated until hover, blue on dark.
const linkCls = "text-navy no-underline hover:underline dark:text-blue";
// Browser defaults Tailwind's preflight strips and this long-form page lived
// on: paragraph/list block margins and disc bullets. The old SCSS set the
// list indent of every list inside a <section> to 1.25rem (UA default: 40px).
const proseP = "my-[1em] leading-[1.6]";
const proseUl = "my-[1em] list-disc pl-5";
const proseLi = "leading-[1.6]";
// Repeated shapes on this page: section headings, company/school headings, the
// grey date-and-place line under each of them, and the inline link rows.
const h2Cls = "mt-9 mb-3 text-[1.5rem] font-bold";
const h3Cls = "mt-5 mb-1 text-[1.1rem] font-bold";
const metaP = "meta my-[1em] leading-[1.6] text-subtitle";
const linksUl = "links my-[1em] flex list-none flex-wrap gap-x-5 gap-y-[0.4rem] p-0";
---

<Layout
  title="About Murugappan M | Full Stack Engineer — TypeScript, Node.js, React & AWS"
  profilePage
>
  <Header />
  <main class="about-page box-content mx-auto max-w-[760px] px-5 pt-28 pb-16">
    <h1 class="mt-[0.67em] mb-2 text-[clamp(1.7rem,6vw,2.2rem)] font-bold">
      About {resumeContact.name}
    </h1>
    <p class="pitch my-[1em] text-[1.15rem] leading-[1.6]">{greeting.subTitle}</p>
    <p class="facts my-[1em] leading-[1.6] text-subtitle">
      {resumeContact.title} · {resumeContact.location} · currently at{" "}
      <a href="https://www.medmehealth.com" class={linkCls}>MedMe Health</a>
    </p>

    <ul class={linksUl}>
      {
        links.map(l => (
          <li class={proseLi}>
            <a href={l.href} class={linkCls}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <section>
      <h2 class={h2Cls}>Experience</h2>
      {
        stints.map(stint => (
          <article class="stint">
            <h3 class={h3Cls}>{stint.company}</h3>
            <p class={metaP}>
              {stint.span}
              {stint.location && ` \u00b7 ${stint.location}`}
            </p>
            {stint.roles.map(job => (
              <div class="job pl-4">
                <h4 class="mt-4 mb-[0.15rem] text-[1rem] font-bold">
                  {job.role}
                  {job.partTime && " (Part-time)"}
                </h4>
                {/* a lone role's dates already sit under the company name */}
                {stint.roles.length > 1 && (
                  <p class={metaP}>
                    {job.date}
                    {!stint.location && ` \u00b7 ${job.location}`}
                  </p>
                )}
                <p class={proseP}>{job.desc}</p>
                {job.descBullets && (
                  <ul class={proseUl}>
                    {job.descBullets.map(b => (
                      <li class={proseLi}>{b}</li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </article>
        ))
      }
    </section>

    <section>
      <h2 class={h2Cls}>Skills</h2>
      <ul class={proseUl}>
        {
          skillsCategories.map(c => (
            <li class={proseLi}>
              <strong class="font-bold">{c.category}:</strong> {c.items}
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2 class={h2Cls}>Education</h2>
      {
        educationInfo.map(school => (
          <article class="job">
            <h3 class={h3Cls}>{school.schoolName}</h3>
            <p class={metaP}>
              {school.subHeader} · {school.duration}
            </p>
            <ul class={proseUl}>
              {school.descBullets.map(b => (
                <li class={proseLi}>{b}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </section>

    <section>
      <h2 class={h2Cls}>Open source</h2>
      <p class={proseP}>{openSourceCard.subtitle}</p>
      <ul class={linksUl}>
        {
          openSourceCard.footerLink.map(l => (
            <li class={proseLi}>
              <a href={l.url} class={linkCls}>
                {l.name}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2 class={h2Cls}>For AI agents</h2>
      <p class={proseP}>
        This page is the canonical source of truth about Murugappan M. A machine-readable version
        lives at{" "}
        <a href="/llms.txt" class={linkCls}>/llms.txt</a>; every page on this site also serves
        markdown via <code>Accept: text/markdown</code>, and full blog content is at <a
          href="/blog/llms-full.txt"
          class={linkCls}>/blog/llms-full.txt</a
        >.
      </p>
      <p class={proseP}>
        Everything on this page is also served as JSON by a public, unauthenticated API — start with{
          " "
        }
        <a href="/api/v1/profile" class={linkCls}>
          <code>GET /api/v1/profile</code>
        </a>
        . The full contract is the{" "}
        <a href="/openapi.json" class={linkCls}>OpenAPI 3.1.0 spec</a>, the endpoints, versioning
        policy and rate-limit headers are documented in the{" "}
        <a href="/developers/" class={linkCls}>developer portal</a>, there is an{" "}
        <a href="/mcp" class={linkCls}>MCP server</a> with a{" "}
        <a href="/.well-known/mcp.json" class={linkCls}>manifest</a>, and{" "}
        <a href="/AGENTS.md" class={linkCls}>/AGENTS.md</a> says when to reach for this site and which
        call to make.
      </p>
    </section>
  </main>
  <ScrollTop />
</Layout>
