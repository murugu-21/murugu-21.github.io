---
// The HTML 404. Non-browser clients never see this page: a request without
// `Sec-Fetch-Mode: navigate` reaches the Worker, which answers the same 404
// with a short markdown body instead (worker/not-found.ts). The recovery links
// below are the human half of that same idea.
import Layout from "../layouts/Layout.astro";

const recovery = [
  { href: "/", label: "Portfolio" },
  { href: "/about/", label: "About" },
  { href: "/blog/", label: "Blog" },
  { href: "/resume/", label: "Resume" },
  { href: "/developers/", label: "Developer portal" },
  { href: "/sitemap.xml", label: "Sitemap" },
  { href: "/llms.txt", label: "llms.txt" }
];
---

<Layout
  title="404 — Page not found | Murugappan M"
  description="That page does not exist on murugappan.dev. Jump to the portfolio, blog, resume, developer portal or sitemap instead."
  noindex
>
  <main class="notfound-main flex min-h-[60vh] flex-col items-center justify-center text-center">
    <h1 aria-label="Page not found" class="m-0 text-[72px] font-bold text-navy">404</h1>
    <p class="my-[1em] dark:text-white">
      This page doesn't exist. Try the <a href="/" class="text-navy underline">portfolio</a> or the
      <a href="/blog/" class="text-navy underline">blog</a>.
    </p>
    <nav aria-label="Where to go instead">
      <ul
        class="recovery mt-6 flex list-none flex-wrap justify-center gap-x-5 gap-y-[0.4rem] p-0 text-[0.95rem]"
      >
        {
          recovery.map(link => (
            <li>
              <a href={link.href} class="text-navy underline">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </main>
</Layout>
