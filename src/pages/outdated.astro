---
// Where redirectIfOutdated (src/lib/browser-support.ts) sends old browsers. Plain HTML without
// Layout, so it renders in them and the check can't redirect to itself.
import { MIN_VERSIONS, continueLinkScript } from "#src/lib/browser-support.ts";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Your browser is out of date | Murugappan M</title>
    {/* eslint-disable no-restricted-syntax, better-tailwindcss/no-unknown-classes -- Plain CSS, not
        Tailwind: browsers below the floor can't run Tailwind 4's output, and this page skips global.css. */}
    <style is:inline>
      :root {
        color: #1c1633;
        background: #f8f7ff;
        font:
          17px/1.6 ui-monospace,
          Menlo,
          Consolas,
          monospace;
      }
      main {
        max-width: 36rem;
        margin: 12vh auto;
        padding: 0 1.25rem;
      }
      h1 {
        font-size: 1.5rem;
        line-height: 1.3;
      }
      a {
        color: #06038d;
      }
      .continue {
        display: inline-block;
        margin-top: 1rem;
      }
      /* Last, so it overrides the light colours above. */
      @media (prefers-color-scheme: dark) {
        :root {
          color: #e8e6f0;
          background: #282c35;
        }
        a {
          color: #7da2ff;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Your browser is out of date</h1>
      <p>
        This site uses features your browser doesn't support yet, so pages may show without their
        colours or the menu. It works in:
      </p>
      <ul>
        <li>
          Chrome {MIN_VERSIONS.chrome} or later:{" "}
          <a href="https://www.google.com/chrome/">get Chrome</a>
        </li>
        <li>
          Edge {MIN_VERSIONS.edge} or later: <a href="https://www.microsoft.com/edge">get Edge</a>
        </li>
        <li>
          Firefox {MIN_VERSIONS.firefox} or later:{" "}
          <a href="https://www.mozilla.org/firefox/new/">get Firefox</a>
        </li>
        <li>
          Safari {MIN_VERSIONS.safari} or later, which comes with iOS {MIN_VERSIONS.ios} on iPhone
          and iPad, and with the latest macOS or Safari update on a Mac
        </li>
      </ul>
      <a id="continue" class="continue" href="/">
        Continue to the site anyway
      </a>
    </main>
    <script is:inline set:html={continueLinkScript} />
  </body>
</html>
