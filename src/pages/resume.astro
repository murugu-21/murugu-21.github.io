---
// Print source for dist/resume.pdf (scripts/generate-resume.ts): no Layout.astro,
// no chat or theme toggle, always light.
import { greeting, workExperiences, skillsCategories, educationInfo } from "#src/data/portfolio.ts";
import { resumeContact } from "#src/data/resume.ts";
import { groupByCompany } from "#src/lib/experience.ts";
import { fetchPinnedRepos } from "#src/lib/github.ts";
// A webfont, so the CF build image's Chromium prints the same glyphs as local Chrome.
import { FIRA_CODE_FACE, FIRA_CODE_URL } from "#src/lib/fonts.ts";

const repos = (await fetchPinnedRepos()).filter(r => r.description);
// Groups by *consecutive* company, so returning to an employer stays two blocks.
const stints = groupByCompany(workExperiences);
const displayUrl = (url: string) => url.replace(/^https?:\/\//, "").replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Duplicates homepage content and nothing links here. */}
    <meta name="robots" content="noindex" />
    <title>Murugappan M | Resume</title>
    <meta name="description" content={`${resumeContact.title} resume. ${greeting.subTitle}`} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={FIRA_CODE_URL} />
    <style is:inline set:html={FIRA_CODE_FACE}></style>
  </head>
  <body>
    <main class="sheet">
      <div class="top-bar"></div>
      <header class="header">
        <h1 class="name">{resumeContact.name}</h1>
        <p class="title">{resumeContact.title}</p>
        <p class="contact-line">
          {resumeContact.location}
          {" | "}
          {resumeContact.phone && (
            <>
              {resumeContact.phone}
              {" | "}
            </>
          )}
          <a href={`mailto:${resumeContact.email}`}>{resumeContact.email}</a>
          {" | "}
          <a href={resumeContact.linkedin} target="_blank" rel="noopener noreferrer">
            {displayUrl(resumeContact.linkedin)}
          </a>
          {" | "}
          <a href={resumeContact.github} target="_blank" rel="noopener noreferrer">
            {displayUrl(resumeContact.github)}
          </a>
          {" | "}
          <a href={resumeContact.site} target="_blank" rel="noopener noreferrer">
            {displayUrl(resumeContact.site)}
          </a>
        </p>
      </header>

      <section class="resume-section">
        <h2>Professional Summary</h2>
        <p>{greeting.subTitle}</p>
      </section>

      <section class="resume-section">
        <h2>Skills</h2>
        <ul class="skills-list">
          {skillsCategories.map(({ category, items }) => (
            <li>
              <span class="skills-category">{category}:</span> {items}.
            </li>
          ))}
        </ul>
      </section>

      <section class="resume-section">
        <h2>Experience</h2>
        {stints.map(stint => (
          <div class="stint-block">
            <p class="stint-heading">
              <span>
                {stint.company}
                {stint.location && `, ${stint.location}`}
              </span>
              <span class="stint-span">{stint.span}</span>
            </p>
            {stint.roles.map(exp => (
              <div class="role-block">
                {/* a lone role's dates already sit on the company line */}
                <p class="role-heading">
                  <span class="role-title">
                    {exp.role}
                    {exp.partTime && " (Part-time)"}
                    {!stint.location && `, ${exp.location}`}
                  </span>
                  {stint.roles.length > 1 && <span class="role-span">{exp.date}</span>}
                </p>
                <p class="role-desc">{exp.desc}</p>
                {exp.descBullets && exp.descBullets.length > 0 && (
                  <ul>
                    {exp.descBullets.map(bullet => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
        ))}
      </section>

      {repos.length > 0 && (
        <section class="resume-section">
          <h2>Projects</h2>
          {repos.map(repo => (
            <div class="role-block">
              <p class="role-heading">
                {repo.name}
                {repo.homepageUrl && (
                  <>
                    {" | "}
                    <a href={repo.homepageUrl} target="_blank" rel="noopener noreferrer">
                      {displayUrl(repo.homepageUrl)}
                    </a>
                  </>
                )}
              </p>
              <p class="role-desc">{repo.description}</p>
            </div>
          ))}
        </section>
      )}

      <section class="resume-section">
        <h2>Education</h2>
        {educationInfo.map(edu => (
          <div class="role-block">
            <p class="role-heading">
              {edu.schoolName}, {edu.desc.replace(/\.$/, "")} |{" "}
              <span class="role-title">{edu.subHeader}</span>
            </p>
            <p class="role-date">
              {edu.duration}
              {edu.grade && <> · {edu.grade}</>}
            </p>
          </div>
        ))}
      </section>
    </main>

    <style>
      @page {
        size: Letter;
        margin: 0.45in 0.55in;
      }

      :root {
        --accent: #06038d;
        --bar: #4c7dff;
        --text: #1a1a1a;
        --gray: #595959;
        /* the site accent, not the browser default link blue */
        --link: #06038d;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background: #f2f2f2;
        color: var(--text);
      }

      body {
        font-family: "Fira Code", ui-monospace, Menlo, monospace;
        font-size: 9.5pt;
        line-height: 1.36;
        /* Fira Code's programming ligatures (-> => ==) are wrong in prose. */
        font-feature-settings: "calt" 0;
      }

      a {
        color: var(--link);
        text-decoration: underline;
      }

      /* Screen preview; print uses @page margins instead (see @media print). */
      .sheet {
        max-width: 8.5in;
        margin: 2rem auto;
        padding: 0.45in 0.55in;
        background: #fff;
        box-shadow: 0 0.1in 0.3in rgba(0, 0, 0, 0.15);
      }

      .top-bar {
        height: 8px;
        background: var(--bar);
        margin: -0.45in -0.55in 1em;
      }

      .header {
        margin-bottom: 0.6em;
      }

      .name {
        font-size: 22pt;
        font-weight: 700;
        margin: 0 0 0.15em;
        letter-spacing: -0.5px;
      }

      .title {
        color: var(--accent);
        font-size: 11pt;
        font-weight: 700;
        margin: 0 0 0.3em;
      }

      .contact-line {
        font-size: 8pt;
        margin: 0;
      }

      .resume-section {
        margin-top: 0.75em;
      }

      .resume-section h2 {
        color: var(--accent);
        font-size: 10pt;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        margin: 0 0 0.4em;
      }

      .resume-section p {
        margin: 0 0 0.3em;
      }

      .skills-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .skills-list li {
        margin: 0 0 0.35em;
      }

      .skills-category {
        font-weight: 700;
      }

      .stint-block {
        margin-bottom: 0.6em;
      }

      /* company on the left, the stint's full span flush right */
      .stint-heading {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1em;
        font-weight: 700;
        margin: 0 0 0.25em;
        /* never strand a company name at the foot of a page */
        break-after: avoid;
        page-break-after: avoid;
      }

      .stint-span,
      .role-span {
        font-size: 8pt;
        font-weight: 400;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        white-space: nowrap;
        color: var(--gray);
      }

      /* roles read as subsections of the company block */
      .stint-block .role-block {
        padding-left: 0.9em;
        margin-bottom: 0.4em;
        /* long roles flow across pages instead of leaving a blank tail */
        break-inside: auto;
        page-break-inside: auto;
      }

      /* ...but never strand a role title or its intro line at the foot */
      .stint-block .role-heading,
      .stint-block .role-desc {
        break-after: avoid;
        page-break-after: avoid;
      }

      .stint-block .role-heading {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1em;
        font-weight: 400;
      }

      .role-block {
        margin-bottom: 0.55em;
        break-inside: avoid;
        page-break-inside: avoid;
      }

      .role-heading {
        font-weight: 700;
        margin: 0;
      }

      .role-title {
        font-weight: 400;
        font-style: italic;
      }

      .role-date {
        font-size: 8pt;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--gray);
        margin: 0.1em 0 0.3em;
      }

      .role-desc {
        margin: 0.2em 0;
      }

      ul {
        margin: 0.2em 0 0;
        padding-left: 1.2em;
      }

      li {
        margin: 0 0 0.2em;
        break-inside: avoid;
        page-break-inside: avoid;
      }

      @media print {
        html,
        body {
          background: #fff;
        }

        .sheet {
          max-width: none;
          margin: 0;
          padding: 0;
          box-shadow: none;
        }

        .top-bar {
          margin: 0 0 1.1em;
        }
      }
    </style>
  </body>
</html>
