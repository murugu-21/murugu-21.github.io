---
// Print source for dist/resume.pdf (scripts/site/generate-resume.ts): no Layout.astro,
// no chat or theme toggle, always light.
import { greeting, workExperiences, skillsCategories, educationInfo } from "#src/data/portfolio.ts";
import { resumeContact } from "#src/data/resume.ts";
import { groupByCompany } from "#src/lib/experience.ts";
import { fetchPinnedRepos } from "#src/lib/github.ts";
// A webfont, so the CF build image's Chromium prints the same glyphs as local Chrome.
import { Font } from "astro:assets";
import "#src/styles/resume.css";
import ResumeSection from "#src/components/resume/ResumeSection.astro";

const repos = (await fetchPinnedRepos()).filter(r => r.description);
// Groups by *consecutive* company, so returning to an employer stays two blocks.
const stints = groupByCompany(workExperiences);
const displayUrl = (url: string) => url.replace(/^https?:\/\//, "").replace(/\/$/, "");
---

<!doctype html>
<html lang="en" class="m-0 box-border bg-backdrop p-0 text-ink **:box-border print:bg-white">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Duplicates homepage content and nothing links here. */}
    <meta name="robots" content="noindex" />
    <title>Murugappan M | Resume</title>
    <meta name="description" content={`${resumeContact.title} resume. ${greeting.subTitle}`} />
    <Font cssVariable="--font-fira-code" preload />
  </head>
  {/* Fira Code's programming ligatures (-> => ==) are wrong in prose. */}
  <body class="m-0 bg-backdrop p-0 font-(family-name:--font-fira-code) font-features-['calt'_0] text-[9.5pt] leading-[1.36] text-ink print:bg-white">
    {/* A screen preview of the sheet; print drops the frame (@page in resume.css sets the page size and margins). */}
    <main class="mx-auto my-8 max-w-204 bg-white px-[0.55in] py-[0.45in] shadow-[0_0.1in_0.3in_rgba(0,0,0,0.15)] print:m-0 print:max-w-none print:p-0 print:shadow-none">
      <div class="mx-[-0.55in] mt-[-0.45in] mb-[1em] h-2 bg-blue print:mx-0 print:mt-0 print:mb-[1.1em]"></div>
      <header class="mb-[0.6em]">
        <h1 class="mt-0 mb-[0.15em] text-[22pt] font-bold tracking-[-0.5px]">
          {resumeContact.name}
        </h1>
        <p class="mt-0 mb-[0.3em] text-[11pt] font-bold text-navy">{resumeContact.title}</p>
        <p class="m-0 text-[8pt]">
          {/* A no-break space before each pipe, and nowrap links and phone (below), so a wrapped line never starts with a pipe. */}
          {resumeContact.location}
          {"\u00A0| "}
          {resumeContact.phone && (
            <>
              <span class="whitespace-nowrap">{resumeContact.phone}</span>
              {"\u00A0| "}
            </>
          )}
          <a href={`mailto:${resumeContact.email}`} class="whitespace-nowrap text-navy underline">
            {resumeContact.email}
          </a>
          {[resumeContact.linkedin, resumeContact.github, resumeContact.site].map(url => (
            <>
              {"\u00A0| "}
              <a
                href={url}
                class="whitespace-nowrap text-navy underline"
                target="_blank"
                rel="noopener noreferrer"
              >
                {displayUrl(url)}
              </a>
            </>
          ))}
        </p>
      </header>

      <ResumeSection title="Professional Summary">
        <p class="mt-0 mb-[0.3em]">{greeting.subTitle}</p>
      </ResumeSection>

      <ResumeSection title="Skills">
        <ul class="m-0 list-none p-0">
          {skillsCategories.map(({ category, items }) => (
            <li class="mx-0 mt-0 mb-[0.35em] break-inside-avoid">
              <span class="font-bold">{category}:</span> {items}.
            </li>
          ))}
        </ul>
      </ResumeSection>

      <ResumeSection title="Experience">
        {" "}
        {stints.map(stint => (
          <div class="mb-[0.6em]">
            {/* company on the left, the stint's full span flush right; never stranded at the foot of a page */}
            <p class="mt-0 mb-[0.3em] flex break-after-avoid items-baseline justify-between gap-[1em] font-bold">
              <span>
                {stint.company}
                {stint.location && `, ${stint.location}`}
              </span>
              <span class="text-[8pt] font-normal tracking-[0.5px] whitespace-nowrap text-ink-muted uppercase">
                {stint.span}
              </span>
            </p>
            {stint.roles.map(exp => (
              /* long roles flow across pages instead of leaving a blank tail */
              <div class="mb-[0.4em] break-inside-auto pl-[0.9em]">
                {/* a lone role's dates already sit on the company line */}
                <p class="mt-0 mb-[0.3em] flex break-after-avoid items-baseline justify-between gap-[1em] font-normal">
                  <span class="font-normal italic">
                    {exp.role}
                    {exp.partTime && " (Part-time)"}
                    {!stint.location && `, ${exp.location}`}
                  </span>
                  {stint.roles.length > 1 && (
                    <span class="text-[8pt] font-normal tracking-[0.5px] whitespace-nowrap text-ink-muted uppercase">
                      {exp.date}
                    </span>
                  )}
                </p>
                <p class="mt-0 mb-[0.3em] break-after-avoid">{exp.desc}</p>
                {exp.descBullets && exp.descBullets.length > 0 && (
                  <ul class="mx-0 mt-[0.2em] mb-0 pl-[1.2em]">
                    {exp.descBullets.map(bullet => (
                      <li class="mx-0 mt-0 mb-[0.2em] break-inside-avoid">{bullet}</li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
        ))}
      </ResumeSection>

      {repos.length > 0 && (
        <ResumeSection title="Projects">
          {" "}
          {repos.map(repo => (
            <div class="mb-[0.55em] break-inside-avoid">
              <p class="mt-0 mb-[0.3em] font-bold">
                {repo.name}
                {repo.homepageUrl && (
                  <>
                    {" | "}
                    <a
                      href={repo.homepageUrl}
                      class="text-navy underline"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {displayUrl(repo.homepageUrl)}
                    </a>
                  </>
                )}
              </p>
              <p class="mt-0 mb-[0.3em]">{repo.description}</p>
            </div>
          ))}
        </ResumeSection>
      )}

      <ResumeSection title="Education">
        {" "}
        {educationInfo.map(edu => (
          <div class="mb-[0.55em] break-inside-avoid">
            <p class="mt-0 mb-[0.3em] font-bold">
              {edu.schoolName}, {edu.desc.replace(/\.$/, "")} |{" "}
              <span class="font-normal italic">{edu.subHeader}</span>
            </p>
            <p class="mt-0 mb-[0.3em] text-[8pt] tracking-[0.5px] text-ink-muted uppercase">
              {edu.duration}
              {edu.grade && <> · {edu.grade}</>}
            </p>
          </div>
        ))}
      </ResumeSection>
    </main>
  </body>
</html>
