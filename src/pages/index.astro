---
import Layout from "#src/layouts/Layout.astro";
import Header from "#src/components/Header.astro";
import Greeting from "#src/components/Greeting.astro";
import Skills from "#src/components/Skills.astro";
import Proficiency from "#src/components/Proficiency.astro";
import Education from "#src/components/Education.astro";
import WorkExperience from "#src/components/WorkExperience.astro";
import Projects from "#src/components/Projects.astro";
import OpenSource from "#src/components/OpenSource.astro";
import Blogs from "#src/components/Blogs.astro";
import GithubCard from "#src/components/GithubCard.astro";
import AgentFooter from "#src/components/AgentFooter.astro";
import ScrollTop from "#src/components/ScrollTop.astro";
---

<Layout>
  <Header />
  <main>
    <Greeting />
    <Skills />
    <WorkExperience />
    <Blogs />
    <Projects />
    <OpenSource />
    <Proficiency />
    <Education />
    <GithubCard />
  </main>
  <AgentFooter />
  <ScrollTop />
</Layout>

<style>
  /* clears the ~70px fixed navbar */
  main {
    padding-top: 80px;
    padding-bottom: 20px;
  }
</style>
