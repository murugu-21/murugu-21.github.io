---
import Layout from "#src/layouts/Layout.astro";
import Header from "#src/components/Header.astro";
import Greeting from "#src/components/home/Greeting.astro";
import Skills from "#src/components/home/Skills.astro";
import Proficiency from "#src/components/home/Proficiency.astro";
import Education from "#src/components/home/Education.astro";
import WorkExperience from "#src/components/home/WorkExperience.astro";
import Projects from "#src/components/home/Projects.astro";
import OpenSource from "#src/components/home/OpenSource.astro";
import Blogs from "#src/components/home/Blogs.astro";
import GithubCard from "#src/components/home/GithubCard.astro";
import AgentFooter from "#src/components/home/AgentFooter.astro";
import ScrollTop from "#src/components/ScrollTop.astro";
---

<Layout>
  <Header />
  {/* pt-20 clears the fixed navbar, which is about 70px tall. */}
  <main class="pt-20 pb-5">
    <Greeting />
    <Skills />
    <WorkExperience />
    <Blogs />
    <Projects />
    <OpenSource />
    <Proficiency />
    <Education />
    <GithubCard />
  </main>
  <AgentFooter />
  <ScrollTop />
</Layout>
