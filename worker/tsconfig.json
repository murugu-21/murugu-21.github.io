{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["@cloudflare/vitest-plugin/types", "vite/client"]
  },
  "include": [
    "./**/*.ts",
    "../utils/**/*.ts",
    "../contracts/**/*.ts",
    "../content/**/*.ts",
    "../worker-configuration.d.ts"
  ]
}
