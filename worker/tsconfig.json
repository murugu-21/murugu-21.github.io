{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "./**/*.ts",
    "../utils/**/*.ts",
    "../contracts/**/*.ts",
    "../.cloudflare/types/index.d.ts"
  ]
}
