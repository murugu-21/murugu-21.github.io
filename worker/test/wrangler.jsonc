{
  "name": "murugappan-dev-test",
  "main": "../server.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // keep DO bindings + migrations in sync with ../../wrangler.jsonc
  "durable_objects": {
    "bindings": [
      { "name": "ChatRoom", "class_name": "ChatRoom" },
      { "name": "RateLimiter", "class_name": "RateLimiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatRoom", "RateLimiter"] }
  ]
}
