{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "none",
  "arrowParens": "avoid",
  "printWidth": 100,
  "sortPackageJson": false,
  "sortTailwindcss": { "stylesheet": "./src/styles/global.css", "functions": ["cn", "cva"] },
  "overrides": [
    {
      "files": ["content/**/*.md"],
      "options": {
        "semi": false,
        "trailingComma": "all"
      }
    }
  ]
}
