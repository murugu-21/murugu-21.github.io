{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  // Biome lints .astro templates and lints and formats stylesheets, which oxc can't parse.
  // oxlint still lints .astro frontmatter and scripts, so Biome's JavaScript rules stay off.
  "files": { "includes": ["apps/site/src/**/*.astro", "apps/site/src/**/*.css"] },
  "formatter": { "indentStyle": "space", "lineWidth": 100 },
  "css": { "parser": { "tailwindDirectives": true } },
  // Biome's formatter breaks lines where Astro then drops spaces, so oxfmt formats .astro instead.
  "html": { "experimentalFullSupportEnabled": true, "formatter": { "enabled": false } },
  "assist": { "enabled": false },
  "plugins": ["./tooling/biome/cn-variants.grit"],
  "linter": { "rules": { "preset": "none" } },
  "overrides": [
    {
      "includes": ["**", "!apps/site/src/pages/outdated.astro"],
      "plugins": ["./tooling/biome/tailwind-only-css.grit"]
    },
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "preset": "recommended",
          "suspicious": {
            "noDuplicateSelectors": "error",
            // Baseline 2024 is nearest the browser floor (README.md › Browser support). The allowed
            // newer features degrade gracefully to the default scrollbar and selection colours.
            "useBaseline": {
              "level": "error",
              "options": {
                "available": 2024,
                "allowProperties": ["scrollbar-color"],
                "allowSelectors": ["selection"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "a11y": { "preset": "all" },
          "security": { "noScriptUrl": "error", "useIframeSandbox": "error" },
          "style": { "noInlineStyles": "error" },
          "nursery": {
            "noNonScalableViewport": "error",
            "noObsoleteTags": "error",
            "noMisplacedListElements": "error",
            "useControlLabel": "error",
            "noAstroConflictingSetDirectives": "error",
            "noAstroSetHtmlDirective": "error",
            "useAstroClientOnlyDirectiveValue": "error",
            "noTailwindArbitraryValue": "error",
            "noTailwindRawColors": "error",
            "useTailwindShorthandClasses": "error"
          }
        }
      }
    }
  ]
}
