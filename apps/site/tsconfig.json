{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "scripts/**/*",
    "astro.config.ts",
    // Types `virtual:content/posts`, which the content package's Vite plugin serves.
    "../../packages/content/posts-module.d.ts"
  ],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "contentMappers": [{ "package": "@astrojs/ts-content-mapper", "extensions": [".astro"] }]
}
