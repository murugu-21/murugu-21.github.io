---
import { techStack } from "@murugappan/content/portfolio.ts";
import Icon from "#src/components/Icon.astro";
import Section from "./Section.astro";
import SectionTitle from "./SectionTitle.astro";
---

<Section id="proficiency" class="mt-8 flex">
  <div class="flex-1">
    <SectionTitle title="Proficiency" />
    <dl class="m-0 flex flex-col gap-4">
      {techStack.experience.map(exp => (
        <div class="grid grid-cols-1 gap-1.5 md:grid-cols-[12rem_1fr] md:items-center md:gap-x-6 md:gap-y-2">
          <dt class="m-0 text-base font-semibold text-text md:text-lg dark:text-white">
            {exp.stack}
          </dt>
          <dd class="m-0">
            <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
              {exp.tools.map(tool => (
                <li class="inline-flex items-center gap-2 rounded-full border border-chip-outline px-3.5 py-1.5 text-sm whitespace-nowrap text-text shadow-glow transition duration-300 hover:border-navy hover:shadow-glow-hover motion-reduce:transition-none dark:border-chip-outline-dark dark:text-white dark:shadow-glow-dark dark:hover:border-blue dark:hover:shadow-glow-dark-hover">
                  <Icon name={tool.icon} size="1.1rem" class="shrink-0 text-navy dark:text-blue" />
                  <span>{tool.name}</span>
                </li>
              ))}
            </ul>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</Section>
