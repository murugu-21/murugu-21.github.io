---
import { accentTitle } from "#src/lib/accent.ts";
import { cn } from "#src/lib/utils.ts";

interface Props {
  title: string;
  class?: string;
}
const { title, class: className } = Astro.props;
const { before, accent, after } = accentTitle(title);
---

<h2
  class={cn(
    "my-8 text-center text-3xl font-normal md:text-start md:text-4xl xl:text-6xl dark:text-white",
    className
  )}
>
  {before}
  {accent && <span class="accent">{accent}</span>}
  {after}
</h2>
