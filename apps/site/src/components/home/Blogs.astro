---
import { blogSection } from "@murugappan/content/portfolio.ts";
import { postDescription, postPath } from "@murugappan/content/posts.ts";
import { getPostSources } from "#src/lib/blog/posts.ts";
import Section from "./Section.astro";
import SectionTitle from "./SectionTitle.astro";

const featured = (await getPostSources()).filter(post => post.data.featured);
const cards = [
  ...featured.map(post => ({
    url: postPath(post.slug),
    title: post.data.shortTitle ?? post.data.title,
    description: postDescription(post)
  })),
  blogSection.blogIndexCard
];
---

<Section id="blogs" class="mt-16">
  <div>
    <SectionTitle title={blogSection.title} />
    <p class="my-5 text-subtitle uppercase max-md:text-center max-md:text-base dark:text-white">
      {blogSection.subtitle}
    </p>
  </div>
  <div class="flex">
    {/* biome-ignore lint/nursery/noTailwindArbitraryValue: Tailwind has no auto-fill track default */}
    <div class="mb-8 grid flex-1 grid-cols-[repeat(auto-fill,minmax(300px,1fr))] gap-8 sm:grid-cols-[repeat(auto-fill,minmax(400px,1fr))]">
      {cards.map(card => (
        <div class="box-content h-50 glow-card cursor-pointer text-blog-container dark:text-white">
          {/* 142% of circle()'s reference radius reaches the far corner of any
                card (√2 ≈ 1.414). */}
          {/* biome-ignore-start lint/nursery/noTailwindArbitraryValue: Tailwind has no clip-path utility */}
          <a
            class="group relative z-0 block h-full overflow-hidden rounded-sm no-underline before:absolute before:inset-0 before:-z-10 before:bg-dusk-violet before:transition-[clip-path] before:duration-500 before:ease-out before:[clip-path:circle(16px_at_100%_0)] hover:before:[clip-path:circle(142%_at_100%_0)] dark:before:bg-blue-light print:before:hidden"
            href={card.url}
            data-ph-event="blog_card_click"
            data-ph-prop="post"
            data-ph-value={card.title}
          >
            {/* biome-ignore-end lint/nursery/noTailwindArbitraryValue: see above */}
            {/* `!` so dark mode beats group-hover:text-white */}
            <h3 class="mx-5 mt-8 mb-3.5 line-clamp-2 text-lg font-bold text-blog-title group-hover:text-white group-hover:transition-all group-hover:duration-300 group-hover:ease-out sm:text-xl dark:text-white! dark:group-hover:text-navy!">
              {card.title}
            </h3>
            <p class="line-clamp-4 px-5 text-base font-normal text-card-subtitle group-hover:text-blog-hover-small group-hover:transition-all group-hover:duration-300 group-hover:ease-out dark:text-white! dark:group-hover:text-navy!">
              {card.description}
            </p>
            <div
              class="absolute top-0 right-0 flex size-8 items-center justify-center overflow-hidden rounded-tr-sm rounded-bl-4xl bg-dusk-violet dark:bg-blue-light print:hidden"
              aria-hidden="true"
            >
              <div class="-mt-1 -mr-1 text-white dark:text-navy">→</div>
            </div>
          </a>
        </div>
      ))}
    </div>
  </div>
</Section>
