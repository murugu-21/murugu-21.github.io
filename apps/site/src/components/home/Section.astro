---
import { cn } from "#src/lib/utils.ts";

interface Props {
  id: string;
  class?: string;
}
const { id, class: className } = Astro.props;
---

<div
  id={id}
  class={cn(
    "mx-auto box-content w-9/10 animate-rise-fade px-2.5 py-5 motion-reduce:animate-none",
    className
  )}
>
  <slot />
</div>
