---
import { openSourceSection, openSourceCard } from "@murugappan/content/portfolio.ts";
import Section from "./Section.astro";
import SectionTitle from "./SectionTitle.astro";
---

<Section id="achievements" class="mt-16">
  <div>
    <SectionTitle title={openSourceSection.title} class="m-0" />
    <p class="m-0 mb-12 text-subtitle uppercase max-md:text-center max-md:text-base dark:text-white">
      {openSourceSection.subtitle}
    </p>
  </div>
  {/* biome-ignore lint/nursery/noTailwindArbitraryValue: Tailwind has no auto-fit track default */}
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(300px,100%),1fr))] gap-4">
    <div class="glow-card p-6">
      <div class="relative flex h-64 items-center justify-center overflow-hidden">
        <img
          src={openSourceCard.image}
          alt={openSourceCard.imageAlt}
          class="h-auto w-64 max-w-full"
          width="250"
          height="250"
          loading="lazy"
        />
      </div>
      <div class="text-center">
        <h3 class="m-0 mt-4 text-xl font-bold text-title dark:text-white">
          {openSourceCard.title}
        </h3>
        <p class="my-4 text-base text-card-subtitle dark:text-white">{openSourceCard.subtitle}</p>
      </div>
      <div class="flex flex-wrap items-center justify-center">
        {openSourceCard.footerLink.map(f => (
          <a
            class="mr-2 mb-2 inline-flex h-6 items-center justify-center rounded-sm bg-navy px-2 align-middle text-xs/normal whitespace-nowrap text-surface-alt no-underline transition-colors duration-200 ease-in hover:bg-dusk-violet dark:hover:bg-blue-light dark:hover:text-navy print:border print:border-navy print:bg-transparent print:text-navy"
            href={f.url}
            target="_blank"
            rel="noopener noreferrer"
            data-ph-event="oss_link_click"
            data-ph-prop="oss"
            data-ph-value={f.name}
          >
            {f.name}
          </a>
        ))}
      </div>
    </div>
  </div>
</Section>
