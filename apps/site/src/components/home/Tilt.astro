---
// 3D pointer tilt. Mouse-only (pointer: fine), off under prefers-reduced-motion.
---

<div class="transition-transform duration-150 ease-out transform-3d" data-tilt>
  <slot />
</div>

<script>
  const fine = window.matchMedia("(pointer: fine)").matches;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (fine && !reduced) {
    const MAX_DEG = 10;
    document.querySelectorAll<HTMLElement>("[data-tilt]").forEach(el => {
      el.addEventListener("mousemove", e => {
        const rect = el.getBoundingClientRect();
        const rx = ((e.clientY - rect.top) / rect.height - 0.5) * -2 * MAX_DEG;
        const ry = ((e.clientX - rect.left) / rect.width - 0.5) * 2 * MAX_DEG;
        el.style.transform = `perspective(900px) rotateX(${rx}deg) rotateY(${ry}deg)`;
      });
      el.addEventListener("mouseleave", () => {
        el.style.transform = "";
      });
    });
  }
</script>
