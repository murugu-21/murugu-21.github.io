---
import { greeting, typewriterRoles } from "@murugappan/content/portfolio.ts";
import SocialMedia from "./SocialMedia.astro";
import Button from "./Button.astro";
import Typewriter from "./Typewriter.astro";
import { Image } from "astro:assets";
import portrait from "#src/assets/images/portrait.webp";
import Section from "./Section.astro";

const TICKS = Array.from({ length: 72 }, (_, i) => ({ angle: i * 5, major: i % 6 === 0 }));
const CARDINALS = [0, 90, 180, 270];
---

<Section id="greeting" class="mt-8">
  <div class="flex max-md:block">
    <div class="mb-8 flex-1">
      <div>
        <h1 class="my-8 text-center text-3xl font-bold text-text md:text-start md:text-5xl xl:text-7xl dark:text-white">
          <span class="mb-3 block text-base md:text-2xl xl:text-4xl">
            Hi There!{" "}
            <span class="inline-block origin-bottom-right animate-wave motion-reduce:animate-none">
              👋
            </span>
          </span>
          <span class="block">
            I'm <span class="accent">{greeting.nickname}</span>
          </span>
        </h1>
        <p class="mt-3 mb-5 min-h-lh text-center text-xl md:text-start md:text-2xl xl:text-4xl">
          <Typewriter roles={typewriterRoles} />
        </p>
        <p class="mt-5 mb-10 text-center text-base text-subtitle md:text-start md:text-xl xl:text-3xl/10 dark:text-white">
          {greeting.subTitle}
        </p>
        <SocialMedia />
        <div class="mt-10 flex max-md:flex-wrap max-md:justify-around max-md:gap-3">
          <Button text="Contact me" href="#contact" event="contact_click" />
          <Button
            text="Download my resume"
            href={greeting.resumePath}
            download={greeting.resumeFileName}
            event="resume_download"
          />
        </div>
      </div>
    </div>
    <div class="mb-8 flex flex-1 items-center justify-center">
      <div class="relative aspect-square w-full max-w-xl max-md:max-w-79">
        {/* The portrait fills the middle 80%, so 100 viewBox units are its outer radius and the ticks fit inside this box. */}
        <svg
          class="pointer-events-none absolute inset-0 size-full text-navy motion-safe:animate-ring-settle dark:text-blue-light print:hidden"
          viewBox="-125 -125 250 250"
          stroke="currentColor"
          aria-hidden="true"
        >
          {TICKS.map(({ angle, major }) => (
            <line
              y1="-106"
              y2={major ? -114 : -109}
              transform={`rotate(${angle})`}
              stroke-width={major ? 1 : 0.5}
              stroke-opacity={major ? 0.8 : 0.45}
            />
          ))}
          {CARDINALS.map(angle => (
            <line y1="-117" y2="-124" transform={`rotate(${angle})`} stroke-width="1.5" />
          ))}
        </svg>
        <Image
          class="alt-fallback absolute inset-1/10 box-border size-4/5 rounded-full border-6 border-navy object-cover shadow-glow dark:border-blue dark:shadow-glow-dark"
          src={portrait}
          widths={[240, 480, 880]}
          sizes="(max-width: 767px) 240px, 448px"
          alt="Murugappan M smiling on a hilltop with arms outstretched"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</Section>
