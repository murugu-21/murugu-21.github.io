---
interface Props {
  src: string;
  label: string;
}
const { src, label } = Astro.props;
---

{/* aspect-ratio reserves the 1600x1200 animation box to avoid CLS. */}
<div class="aspect-4/3 w-full max-w-full" data-lottie-src={src} role="img" aria-label={label}></div>

<script>
  import { onFirstInteraction } from "#src/lib/first-interaction.ts";

  // Astro deduplicates this script: it runs once and initializes every holder.
  const REDUCED = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const holders = document.querySelectorAll<HTMLElement>("[data-lottie-src]");

  async function initHolder(el: HTMLElement) {
    if (el.dataset.loaded) return;
    el.dataset.loaded = "true";
    try {
      const lottie = (await import("lottie-web/build/player/lottie_light")).default;
      const src = el.dataset.lottieSrc;
      if (!src) throw new Error("lottie holder has no data-lottie-src");
      const res = await fetch(src);
      if (!res.ok) throw new Error(`lottie fetch ${res.status}`);
      const data: unknown = await res.json();
      lottie.loadAnimation({
        container: el,
        renderer: "svg",
        loop: !REDUCED,
        autoplay: !REDUCED,
        animationData: data
      });
      // with reduced motion this leaves the first frame as a static illustration
    } catch {
      // failed to load: stop announcing an image that isn't there
      el.removeAttribute("role");
      el.removeAttribute("aria-label");
      el.setAttribute("aria-hidden", "true");
    }
  }

  const io = new IntersectionObserver(
    entries => {
      entries.forEach(e => {
        if (!e.isIntersecting || !(e.target instanceof HTMLElement)) return;
        io.unobserve(e.target);
        initHolder(e.target);
      });
    },
    { rootMargin: "120px" }
  );
  // Wait for first input: the player + 430 KB JSON cost a ~450 ms main-thread
  // task that otherwise lands in Lighthouse's blocking time on desktop.
  onFirstInteraction(() => {
    holders.forEach(h => io.observe(h));
  });
</script>
