---
import { Image } from "astro:assets";
import { workExperiences } from "@murugappan/content/portfolio.ts";
import { LOGOS } from "#src/data/logos.ts";
import Section from "./Section.astro";
import SectionTitle from "./SectionTitle.astro";
import {
  countCompanies,
  currentMonth,
  formatDuration,
  groupByCompany,
  monthsBetween,
  periodBounds,
  totalExperienceMonths
} from "@murugappan/content/experience.ts";

// Ongoing durations are recomputed in the browser (script below) to stay current.
const now = currentMonth();
const ym = (v: { year: number; month: number }) => `${v.year}-${String(v.month).padStart(2, "0")}`;
const duration = (period: string) => {
  const b = periodBounds(period);
  if (!b) return null;
  return {
    label: formatDuration(monthsBetween({ start: b.start, end: b.end ?? now })),
    start: ym(b.start),
    end: b.end ? ym(b.end) : "present"
  };
};

const stints = groupByCompany(workExperiences).map(stint => ({
  ...stint,
  logo: LOGOS[stint.roles[0].companyLogo],
  duration: duration(stint.span),
  partTime: stint.roles.every(r => r.partTime),
  roles: stint.roles.map(role => ({ ...role, duration: duration(role.date) }))
}));
// Part-time roles are shown but excluded from the total and the company count.
const allPeriods = workExperiences.filter(w => !w.partTime).map(w => w.date);
const total = formatDuration(totalExperienceMonths(allPeriods, now));
const companyCount = countCompanies(stints.filter(s => !s.partTime));
---

<Section id="experience" class="mt-8 flex">
  <div class="flex-1">
    <div class="mb-6 flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2 max-md:flex-col max-md:items-center">
      <SectionTitle title="Experiences" class="mb-0" />
      <p class="text-right text-lg text-subtitle-muted max-md:text-center">
        <span
          class="font-semibold text-navy dark:text-blue-light"
          data-experience-total
          data-periods={JSON.stringify(allPeriods)}
        >
          {total}
        </span>{" "}
        of experience across {companyCount} {companyCount === 1 ? "company" : "companies"}
      </p>
    </div>
    <ol class="flex flex-col gap-5">
      {stints.map(stint => (
        <li class="glow-card px-7 py-6 text-text hover:transform-none max-md:px-4 max-md:py-5 dark:text-white">
          <header class="mb-5 flex items-center gap-5">
            {/* Rendered at 4.5rem (3rem on phones), so 72px + 2x instead of the 256px source. */}
            <Image
              class="alt-fallback size-12 flex-none rounded-full object-cover shadow-lg shadow-shadow-darker md:size-18"
              src={stint.logo}
              width={72}
              height={72}
              densities={[1, 2]}
              alt={stint.company + " logo"}
              loading="lazy"
            />
            <div>
              <h3 class="text-xl font-bold md:text-2xl">{stint.company}</h3>
              <p class="mt-1 mb-0 text-base text-subtitle-muted">
                {stint.span}
                {stint.duration && (
                  <span
                    data-duration
                    data-start={stint.duration.start}
                    data-end={stint.duration.end}
                  >
                    {" "}
                    · {stint.duration.label}
                  </span>
                )}
                {stint.partTime && <span> · Part-time</span>}
                {stint.location && <span> · {stint.location}</span>}
              </p>
            </div>
          </header>

          <ol class="ml-5 flex flex-col gap-5 pl-6 md:ml-8">
            {stint.roles.map(role => (
              <li class="relative before:absolute before:top-2.5 before:-left-6 before:size-2.5 before:rounded-full before:bg-navy before:ring-3 before:ring-navy/20 before:content-[''] after:absolute after:top-5 after:-bottom-5 after:-left-5 after:w-0.5 after:bg-navy/25 after:content-[''] last:after:hidden dark:before:bg-blue dark:before:ring-blue/20 dark:after:bg-blue/30">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h4 class="text-lg font-bold md:text-xl">{role.role}</h4>
                  {/* a lone role's date already sits in the card header */}
                  {stint.roles.length > 1 && (
                    <p class="text-sm whitespace-nowrap text-subtitle-muted max-md:whitespace-normal">
                      {role.date}
                      {role.duration && (
                        <span
                          data-duration
                          data-start={role.duration.start}
                          data-end={role.duration.end}
                        >
                          {" "}
                          · {role.duration.label}
                        </span>
                      )}
                      {role.partTime && !stint.partTime && <span> · Part-time</span>}
                      {!stint.location && <span> · {role.location}</span>}
                    </p>
                  )}
                </div>
                <p class="mt-1.5 mb-0 text-base/normal">{role.desc}</p>
                {role.descBullets?.length ? (
                  /* `group` drives the chevron's group-open:rotate-45 */
                  <details class="group mt-2">
                    <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 text-sm font-semibold text-navy select-none hover:text-amber-ink focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-ink dark:text-blue-light dark:hover:text-white dark:focus-visible:outline-blue [&::-webkit-details-marker]:hidden">
                      <span
                        class="mb-0.5 box-content inline-block size-2 -rotate-45 border-r-2 border-b-2 border-current transition-transform duration-200 group-open:-mt-0.5 group-open:mb-0 group-open:rotate-45 motion-reduce:transition-none"
                        aria-hidden="true"
                      />
                      {role.descBullets.length}{" "}
                      {role.descBullets.length === 1 ? "highlight" : "highlights"}
                    </summary>
                    <ul class="mt-2.5 mb-0 list-disc pl-5 text-base">
                      {role.descBullets.map(item => (
                        <li class="mt-1.5 first:mt-0">{item}</li>
                      ))}
                    </ul>
                  </details>
                ) : null}
              </li>
            ))}
          </ol>
        </li>
      ))}
    </ol>
  </div>
</Section>

<script>
  // The build stamped "Present" durations for its own month; recompute for today.
  import {
    currentMonth,
    formatDuration,
    monthsBetween,
    totalExperienceMonths
  } from "@murugappan/content/experience.ts";
  import { parseStringArray } from "#src/lib/data-attributes.ts";

  const now = currentMonth();
  const parse = (v: string) => {
    const [y, m] = v.split("-").map(Number);
    return { year: y, month: m };
  };
  document.querySelectorAll<HTMLElement>('[data-duration][data-end="present"]').forEach(el => {
    const start = el.dataset.start;
    if (!start) return;
    el.textContent = ` · ${formatDuration(monthsBetween({ start: parse(start), end: now }))}`;
  });
  const total = document.querySelector<HTMLElement>("[data-experience-total]");
  const periods = total?.dataset.periods;
  if (total && periods) {
    total.textContent = formatDuration(totalExperienceMonths(parseStringArray(periods), now));
  }

  // Paper can't expand a <details>, and the highlights are the resume's substance.
  const openedForPrint: HTMLDetailsElement[] = [];
  window.addEventListener("beforeprint", () => {
    document.querySelectorAll<HTMLDetailsElement>("#experience details:not([open])").forEach(d => {
      d.open = true;
      openedForPrint.push(d);
    });
  });
  window.addEventListener("afterprint", () => {
    for (const d of openedForPrint.splice(0)) d.open = false;
  });
</script>
