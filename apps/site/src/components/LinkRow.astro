---
// A row of links under a heading, no bullets. `not-prose` keeps the typography
// plugin's list and link styles off it, so each link sets Prose's link colour itself.
interface Props {
  links: { href: string; label: string }[];
}
const { links } = Astro.props;
---

<ul class="not-prose my-5 flex flex-wrap gap-x-5 gap-y-1.5">
  {links.map(l => (
    <li>
      <a class="text-(--tw-prose-links) hover:underline" href={l.href}>
        {l.label}
      </a>
    </li>
  ))}
</ul>
