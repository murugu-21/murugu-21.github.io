---
import type { HTMLAttributes } from "astro/types";
import { cva } from "class-variance-authority";
import { cn } from "#src/lib/utils.ts";

type Tag = "main" | "article" | "div";
type Props = HTMLAttributes<"div"> & { as?: Tag };
const { as: Element = "div", class: className, ...rest } = Astro.props;

const prose = cva(
  "prose wrap-break-word prose-site prose-headings:scroll-mt-20 max-sm:prose-h1:text-3xl prose-pre:border prose-pre:border-border-soft dark:prose-pre:border-fence-edge-dark prose-table:table-scroll-hint",
  {
    variants: {
      as: {
        main: "mx-auto box-content px-5 pt-28 pb-16 md:prose-lg",
        article: "",
        div: ""
      } satisfies Record<Tag, string>
    }
  }
);
---

<Element class={cn(prose({ as: Element }), className)} {...rest}>
  <slot />
</Element>
