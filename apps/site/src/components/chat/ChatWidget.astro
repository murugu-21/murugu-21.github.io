---
import { PUBLIC_CHAT_HOST, PUBLIC_TURNSTILE_SITE_KEY } from "astro:env/client";

import { ChatWidget } from "./ChatWidget";
import { ALWAYS_PASSING_TEST_SITE_KEY } from "./turnstile";

const turnstileSiteKey =
  PUBLIC_TURNSTILE_SITE_KEY ?? (import.meta.env.DEV ? ALWAYS_PASSING_TEST_SITE_KEY : undefined);
---

<div id="chat-widget-root" class="ui-island print:hidden">
  <ChatWidget client:interaction host={PUBLIC_CHAT_HOST} turnstileSiteKey={turnstileSiteKey} />
</div>
