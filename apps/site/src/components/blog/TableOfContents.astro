---
// Notion-style rail of bars on the right edge, one per h2/h3, expanding into
// the heading list on hover or keyboard focus (the toc-shown and toc-collapsed
// variants in global.css). Mounted after `</article>` so the prose styles
// don't apply, the article's links come first in tab order, and the
// medium-zoom overlay still paints over it.
import type { MarkdownHeading } from "astro";
import { cva } from "class-variance-authority";
import { tocEntries, type TocEntry } from "#src/lib/blog/toc.ts";

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const entries = tocEntries(headings);

// h3s indent under their h2, as in Notion's open list, and get the shorter bar.
type PerDepth = Record<TocEntry["depth"], string>;
// Collapsed links are clipped, not display:none, so they keep their name and tab stop.
const tocLink = cva(
  "peer block py-1 leading-snug wrap-anywhere text-text-light no-underline hover:text-title focus-visible:rounded-sm focus-visible:text-title focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current aria-[current]:font-bold aria-[current]:text-title dark:text-text-dark dark:hover:text-heading-dark dark:focus-visible:text-heading-dark dark:aria-[current]:text-heading-dark toc-collapsed:sr-only",
  {
    variants: {
      depth: { 2: "text-sm", 3: "pl-4 text-xs" } satisfies PerDepth
    }
  }
);
// Hover or focus opens the panel before a mouse click lands, so the bars are only decoration.
const tocBar = cva(
  "hidden h-0.5 rounded-xs bg-toc-bar peer-aria-[current]:bg-title dark:bg-accent-grey-dark dark:peer-aria-[current]:bg-heading-dark toc-collapsed:block",
  {
    variants: {
      depth: { 2: "toc-collapsed:w-4", 3: "toc-collapsed:w-2.5" } satisfies PerDepth
    }
  }
);
---

{entries.length > 0 && (
  <nav
    class="hidden toc-shown:fixed toc-shown:top-1/2 toc-shown:right-0 toc-shown:block toc-shown:-translate-y-1/2 toc-shown:py-4 toc-shown:pr-3 toc-shown:pl-6"
    aria-label="On this page"
    data-toc
  >
    {/* The nav's padding is the hover target around the 2px bars and keeps the
        growing panel under the pointer. It anchors with `right`, not `100vw`,
        because a fixed element's containing block stops short of a classic
        scrollbar. */}
    <ol class="m-0 max-h-[calc(100vh-12rem)] max-w-80 list-none overflow-y-auto rounded-xl bg-nav-scrolled px-4 py-3 shadow-glow backdrop-blur-lg transition duration-150 motion-reduce:transition-none dark:bg-nav-scrolled-dark dark:shadow-glow-dark toc-collapsed:overflow-visible toc-collapsed:bg-transparent toc-collapsed:p-0 toc-collapsed:shadow-none toc-collapsed:backdrop-filter-none">
      {entries.map(entry => (
        <li class="toc-collapsed:flex toc-collapsed:justify-end toc-collapsed:py-1.5">
          <a href={`#${entry.slug}`} class={tocLink({ depth: entry.depth })}>
            {entry.text}
          </a>
          {/* Only shown collapsed; after the link so `peer` can read its aria-current. */}
          <span class={tocBar({ depth: entry.depth })} aria-hidden="true" />
        </li>
      ))}
    </ol>
  </nav>
)}

<script>
  // Scroll spy: re-measure headings once per frame on scroll and resize. Not
  // an IntersectionObserver: it fires on a heading's bottom edge, so after a
  // hash jump parked a heading on the line nothing fired. Listeners live as
  // long as the page.
  import { TOC_LINE_SLACK, activeIndex } from "#src/lib/blog/toc.ts";

  const nav = document.querySelector<HTMLElement>("nav[data-toc]");
  if (nav) {
    const pairs = [...nav.querySelectorAll<HTMLAnchorElement>("a[href^='#']")].flatMap(link => {
      const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
      return heading ? [{ link, heading }] : [];
    });

    // Read the scroll margin from the live heading; Prose.astro owns the value.
    const scrollMargin = pairs.length
      ? parseFloat(getComputedStyle(pairs[0].heading).scrollMarginTop) || 0
      : 0;
    const line = scrollMargin + TOC_LINE_SLACK;

    // A heading with no box (inside a closed <details>, say) reports a top of
    // 0, which would read as reached; give it Infinity instead.
    const topOf = (heading: HTMLElement) => {
      const rects = heading.getClientRects();
      return rects.length ? rects[0].top : Infinity;
    };

    const update = () => {
      const tops = pairs.map(p => topOf(p.heading));
      const root = document.documentElement;
      const atEnd = Math.ceil(window.scrollY + window.innerHeight) >= root.scrollHeight - 1;
      const active = activeIndex(tops, line, atEnd);
      pairs.forEach((p, i) => {
        if (i === active) p.link.setAttribute("aria-current", "location");
        else p.link.removeAttribute("aria-current");
      });
    };

    // Escape collapses a keyboard-opened panel.
    nav.addEventListener("keydown", event => {
      const focused = document.activeElement;
      if (event.key === "Escape" && focused instanceof HTMLElement && nav.contains(focused)) {
        focused.blur();
      }
    });

    let frame = 0;
    const schedule = () => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        update();
      });
    };
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule, { passive: true });
    update();
  }
</script>
