---
import { Font } from "astro:assets";
import { cva } from "class-variance-authority";
import type { Thing } from "schema-dts";
import { jsonLdHtml } from "#src/lib/schema.ts";
import { BLOG_TITLE, SITE_ORIGIN } from "@murugappan/content/site.ts";
import { PERSON_ID, SITE_DESCRIPTION } from "#src/lib/site.ts";
import { outdatedRedirectScript } from "#src/lib/browser-support.ts";
import { themeBootstrapScript } from "#src/lib/theme.ts";
import "#src/styles/global.css";
import ChatWidget from "#src/components/chat/ChatWidget.astro";
import Favicons from "#src/components/Favicons.astro";
import Particles from "#src/components/Particles.astro";
import SiteScripts from "#src/components/SiteScripts.astro";
import { socialMediaLinks } from "@murugappan/content/portfolio.ts";

export interface Props {
  title?: string;
  // og:title and twitter:title, when they drop the <title>'s suffix.
  socialTitle?: string;
  // Defaults to the section's pitch; pages not about the person need their own.
  description?: string;
  noindex?: boolean;
  // the canonical entity page (/about)
  profilePage?: boolean;
  section?: Section;
  article?: { published: Date; tags: string[] };
  // The page's own schema.org nodes, merged into the site-wide @graph.
  graph?: Thing[];
}

export interface Section {
  kind: "portfolio" | "blog";
  siteName: string;
  ogImage: string;
  metaDescription: string;
  socialDescription: string;
  // What the section's WebPage nodes are about; blog posts are about their topic.
  pageAbout?: { "@id": string };
}

const portfolio: Section = {
  kind: "portfolio",
  siteName: "Murugappan M",
  ogImage: `${SITE_ORIGIN}/og-image.png`,
  // Under 160 chars so Google doesn't truncate it; og/twitter/JSON-LD keep the full pitch.
  metaDescription:
    "I build B2B SaaS that ships in regulated industries. I took a product from 0 to $300k ARR and now automate pharmacy workflows with LLMs at MedMe Health.",
  socialDescription: SITE_DESCRIPTION,
  pageAbout: { "@id": PERSON_ID }
};

const {
  title = "Murugappan M | Full Stack Engineer | TypeScript, Node.js, React & AWS",
  socialTitle = title,
  description: pageDescription,
  noindex = false,
  profilePage = false,
  section = portfolio,
  article,
  graph: pageGraph = []
} = Astro.props;
const pageMetaDescription = pageDescription ?? section.metaDescription;
const socialDescription = pageDescription ?? section.socialDescription;
// X reads twitter:creator as "@username".
const twitterHandle = new URL(socialMediaLinks.twitter).pathname.replace(/^\//, "@");

// Canonical on the custom domain, so other hosts (workers.dev previews) consolidate to it.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

// Page chrome per section. The portfolio's 80px scroll padding clears its fixed
// header; the blog has none, and its headings carry their own scroll-margin. The
// blog overrides the base layer's 19px/23px body type and dims the stars, which look
// like stray bullets between words.
type PerKind = Record<Section["kind"], string>;
const chrome = {
  html: cva("scroll-smooth motion-reduce:scroll-auto", {
    variants: {
      kind: { portfolio: "scroll-pt-20", blog: "" } satisfies PerKind
    }
  }),
  body: cva("", {
    variants: {
      kind: {
        portfolio: "",
        blog: "text-base/normal text-text dark:text-text-dark"
      } satisfies PerKind
    }
  }),
  stars: cva("", {
    variants: { kind: { portfolio: "", blog: "opacity-50 dark:opacity-70" } satisfies PerKind }
  })
};
const { kind } = section;

const jsonLdScript = jsonLdHtml({
  page: noindex ? null : { url: canonicalUrl, name: title, about: section.pageAbout, profilePage },
  nodes: pageGraph
});
---

<!doctype html>
<html lang="en" class={chrome.html({ kind })}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* First, so a browser below the floor leaves before anything renders. */}
    <script is:inline set:html={outdatedRedirectScript} />
    <title>{title}</title>
    <meta name="description" content={pageMetaDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    {/* the entity page, kept out of the human nav */}
    <link rel="author" href="/about/" />
    <link
      rel="service-desc"
      type="application/json"
      href="/openapi.json"
      title="OpenAPI 3.1.0 description of the murugappan.dev API"
    />
    <link rel="service-doc" type="text/html" href="/developers/" />
    <link
      rel="api-catalog"
      type="application/linkset+json"
      href="/.well-known/api-catalog"
      title="murugappan.dev API catalogue (RFC 9727)"
    />
    <link rel="describedby" type="text/plain" href="/llms.txt" title="Site summary for LLMs" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${BLOG_TITLE} RSS Feed`}
      href="/blog/rss.xml"
    />

    <meta property="og:type" content={article ? "article" : "website"} />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content={section.siteName} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:image" content={section.ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={section.siteName} />
    {article && (
      <>
        <meta property="article:published_time" content={article.published.toISOString()} />
        {article.tags.map(tag => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}

    <meta name="twitter:card" content="summary_large_image" />
    {!noindex && <meta name="twitter:url" content={canonicalUrl} />}
    <meta name="twitter:creator" content={twitterHandle} />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={section.ogImage} />

    <meta name="msapplication-TileColor" content="#06038d" />
    <meta name="theme-color" content="#06038d" />
    <meta name="theme-color" content="#282c35" media="(prefers-color-scheme: dark)" />

    <Favicons />

    <Font cssVariable="--font-fira-code" preload />

    <script is:inline set:html={themeBootstrapScript} />
    <script type="application/ld+json" set:html={jsonLdScript} />
    <SiteScripts />
  </head>
  <body class={chrome.body({ kind })}>
    <Particles class={chrome.stars({ kind })} />
    <slot />
    <ChatWidget />
  </body>
</html>
