{
  "name": "@murugappan/api",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "scripts": {
    "dev": "vp dev",
    "preview": "wrangler dev --local-upstream localhost:8787",
    "deploy": "bun run db:migrate && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply jarvis-chats --remote",
    "db:migrate:local": "wrangler d1 migrations apply jarvis-chats --local",
    "types": "wrangler types --strict-vars=false"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "3.0.66",
    "@cloudflare/ai-chat": "0.12.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@murugappan/content": "workspace:*",
    "@murugappan/contracts": "workspace:*",
    "@murugappan/utils": "workspace:*",
    "@posthog/mcp": "0.22.3",
    "agents": "0.28.1",
    "ai": "7.0.142",
    "effect": "^4.0.5",
    "hono": "5.0.0-rc.1",
    "posthog-node": "5.56.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.28",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "^1.4.3",
    "@modelcontextprotocol/client": "2.3.1",
    "fast-check": "^4.10.2",
    "linkedom": "^0.18.13",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5",
    "wrangler": "^4.151.0"
  }
}
