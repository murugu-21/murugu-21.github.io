{
  "compilerOptions": {
    "target": "ES2023",
    // esnext for the `with { type: "cf-worker" }` import attribute in cloudflare.config.ts.
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["@cloudflare/vitest-plugin/types", "vite/client"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "floatingEffect": "error",
          "missingStarInYieldEffectGen": "error",
          "missingEffectContext": "error",
          "missingEffectError": "error",
          "missingLayerContext": "error",
          "leakingRequirements": "error",
          "runEffectInsideEffect": "error",
          "multipleEffectProvide": "error"
        }
      }
    ]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "../../packages/utils/**/*.ts",
    "../../packages/contracts/**/*.ts",
    "../../packages/content/**/*.ts",
    ".cloudflare/types",
    "cloudflare.config.ts"
  ],
  "exclude": [
    "../../packages/content/vite/**",
    "**/lint-fixture-*/**",
    "../../packages/**/lint-fixture-*/**"
  ]
}
