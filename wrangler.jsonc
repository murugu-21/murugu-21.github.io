{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "murugappan-dev",
  // Source config: `astro build` writes the deployable one to
  // dist/server/wrangler.json, so deploy after a build, never before.
  "main": "worker/server.ts",
  "routes": [{ "pattern": "murugappan.dev", "custom_domain": true }],
  // no *.workers.dev duplicate for crawlers (preview URLs unaffected)
  "workers_dev": false,
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // Misses go to the Worker so worker/not-found.ts can content-negotiate the
    // 404; "404-page" would answer every miss with 404.html.
    "not_found_handling": "none",
    // Routes the Worker must answer even where an asset would win (JSON errors
    // for /api/*, host-aware generated docs). Keep in sync with worker/server.ts.
    "run_worker_first": [
      "/api/*",
      "/openapi.json",
      "/mcp",
      "/mcp/*",
      "/mcp.json",
      "/.well-known/*",
      "/parties/*",
      "/blog/audio/*"
    ]
  },
  // keep DO bindings + migrations in sync with worker/test/wrangler.jsonc
  "durable_objects": {
    "bindings": [
      { "name": "ChatRoom", "class_name": "ChatRoom" },
      { "name": "RateLimiter", "class_name": "RateLimiter" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom", "RateLimiter"] }],
  // A plain var, not a secret, so `astro build` can fail on a malformed inbox before
  // anything deploys (contactInbox in astro.config.ts). destination_address locks the
  // EMAIL binding to this one address.
  "vars": { "OPPORTUNITY_INBOX": "murugu2001@gmail.com" },
  "send_email": [{ "name": "EMAIL", "destination_address": "murugu2001@gmail.com" }],
  // Deploy fails while it is unset; `wrangler types` reads this list, not .dev.vars.
  "secrets": { "required": ["DEEPSEEK_API_KEY"] },
  // Fire-and-forget analytics mirror of chat rooms (messages, country, IP) so
  // chats are browsable in the dash; DO SQLite is the source of truth.
  // The Worker issues no DDL: run `bun run db:migrate`, or every mirror write
  // fails with only a "d1 mirror failed" log line.
  "d1_databases": [
    {
      "binding": "CHAT_DB",
      "database_name": "jarvis-chats",
      "database_id": "a1111792-fb35-470f-85c9-13c3aab0662c"
    }
  ],
  // Blog audio, written locally by `bun run audio`; served by worker/audio.ts.
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "murugappan-dev-audio" }],
  "observability": { "enabled": true }
}
