{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "murugappan-dev",
  "main": "worker/server.ts",
  "routes": [{"pattern": "murugappan.dev", "custom_domain": true}],
  // the custom domain is the only public host — no *.workers.dev duplicate
  // for crawlers to index (version preview URLs are unaffected)
  "workers_dev": false,
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The Worker runs ahead of asset serving for everything except the
    // immutable hashed-asset directories. Three reasons, all of which need the
    // Worker to see the request before the assets layer answers it:
    //
    //   * /api/*, /openapi.json, /mcp, /mcp.json and /.well-known/* are the
    //     Worker's own routes — /api/* so every failure is the JSON error
    //     envelope rather than the HTML 404 page, and the rest so the generated
    //     documents name the host that actually answered.
    //   * A 404 has to be content-negotiated (worker/not-found.ts): markdown for
    //     a machine client, the styled page for a browser. Left to the assets
    //     layer, `not_found_handling` answers every miss itself and the Worker
    //     is never invoked — including for browser navigation requests, which
    //     `assets_navigation_prefers_asset_serving` routes to asset serving
    //     unless the Worker runs first.
    //   * /parties/* is the chat Durable Object.
    //
    // `ASSETS.fetch()` still applies _headers, _redirects, html_handling and
    // not_found_handling, so nothing about asset serving changes — it just
    // happens one hop later. The exclusions keep the hashed, immutable bundles
    // (which are most of the request volume) on the zero-invocation path.
    "run_worker_first": ["/*", "!/static/*"]
  },
  // keep DO bindings + migrations in sync with worker/test/wrangler.jsonc
  "durable_objects": {
    "bindings": [
      {"name": "ChatRoom", "class_name": "ChatRoom"},
      {"name": "RateLimiter", "class_name": "RateLimiter"}
    ]
  },
  "migrations": [
    {"tag": "v1", "new_sqlite_classes": ["ChatRoom", "RateLimiter"]}
  ],
  "send_email": [{"name": "EMAIL"}],
  // Read-only analytics mirror of every room's messages — DO SQLite stays the
  // serving source of truth; D1 exists so chats are browsable in the dash
  // (Storage & Databases → D1 → jarvis-chats). Writes are fire-and-forget.
  //
  // Schema lives in ./migrations (the default `migrations_dir`); apply it with
  // `npm run db:migrate`. Unlike the DO, which creates its tables in onStart(),
  // nothing in the Worker issues DDL against D1 — until the migration is
  // applied every mirror write fails, and because the writes are
  // fire-and-forget that shows up only as a "d1 mirror failed" line in the logs.
  "d1_databases": [
    {
      "binding": "CHAT_DB",
      "database_name": "jarvis-chats",
      "database_id": "a1111792-fb35-470f-85c9-13c3aab0662c"
    }
  ],
  "observability": {"enabled": true}
}
