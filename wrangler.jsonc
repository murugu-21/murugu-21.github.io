{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "murugappan-dev",
  "main": "worker/server.ts",
  "routes": [{"pattern": "murugappan.dev", "custom_domain": true}],
  // the custom domain is the only public host — no *.workers.dev duplicate
  // for crawlers to index (version preview URLs are unaffected)
  "workers_dev": false,
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Paths the Worker must answer itself instead of letting the assets
    // layer serve (or 404) them — keep in sync with worker/server.ts.
    // /api/* so every failure is the JSON error envelope rather than the HTML
    // 404 page; /openapi.json so the spec's `servers` names the real host;
    // /mcp for the Model Context Protocol endpoint.
    "run_worker_first": [
      "/parties/*",
      "/api/*",
      "/openapi.json",
      "/mcp",
      "/mcp/*"
    ]
  },
  // keep DO bindings + migrations in sync with worker/test/wrangler.jsonc
  "durable_objects": {
    "bindings": [
      {"name": "ChatRoom", "class_name": "ChatRoom"},
      {"name": "RateLimiter", "class_name": "RateLimiter"}
    ]
  },
  "migrations": [
    {"tag": "v1", "new_sqlite_classes": ["ChatRoom", "RateLimiter"]}
  ],
  "ai": {"binding": "AI"},
  "send_email": [{"name": "EMAIL"}],
  // Read-only analytics mirror of every room's messages — DO SQLite stays the
  // serving source of truth; D1 exists so chats are browsable in the dash
  // (Storage & Databases → D1 → jarvis-chats). Writes are fire-and-forget.
  "d1_databases": [
    {
      "binding": "CHAT_DB",
      "database_name": "jarvis-chats",
      "database_id": "a1111792-fb35-470f-85c9-13c3aab0662c"
    }
  ],
  "observability": {"enabled": true}
}
