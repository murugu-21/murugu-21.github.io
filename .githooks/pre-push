#!/bin/sh
set -e

command -v uv >/dev/null || { echo "uv is not installed: brew install uv"; exit 1; }
command -v typos >/dev/null || { echo "typos is not installed: brew install typos-cli"; exit 1; }

echo "pre-push 1/5: spelling"
typos

echo "pre-push 2/5: types, format, lint, unused code and typechecks"
bun run --silent check:static

echo "pre-push 3/5: unit tests"
bun run --silent test

# After the cheap gates, so a failing one leaves the dist/ that `bun run preview` serves untouched.
echo "pre-push 4/5: site and Worker build"
bun run --silent build

echo "pre-push 5/5: end-to-end tests over the build"
bun run --silent test:e2e

echo "pre-push: all gates green"
