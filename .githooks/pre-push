#!/bin/sh
# Mirrors the CI "checks" job (everything except the full site build) so a
# failing gate never reaches CI. Runs once per push instead of per commit;
# commits themselves only pay for lint-staged (see pre-commit).
# Emergency bypass: git push --no-verify
set -e

echo "pre-push 1/6: format (root)"
npm run --silent check-format

echo "pre-push 2/6: format (blog)"
npm --prefix blog run --silent check-format

echo "pre-push 3/6: astro check (root)"
npx astro check

echo "pre-push 4/6: worker typecheck"
npm run --silent check:worker

echo "pre-push 5/6: unit tests"
npm test --silent

echo "pre-push 6/6: astro check (blog)"
npm --prefix blog run --silent test

echo "pre-push: all gates green"
