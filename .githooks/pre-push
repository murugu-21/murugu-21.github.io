#!/bin/sh
set -e

command -v uv >/dev/null || { echo "uv is not installed: brew install uv"; exit 1; }
command -v typos >/dev/null || { echo "typos is not installed: brew install typos-cli"; exit 1; }

echo "pre-push 1/4: spelling"
typos

echo "pre-push 2/4: types, format, lint, unused code and typechecks"
bun run --silent check:static

echo "pre-push 3/4: unit tests"
bun run --silent test

# Last, because it rewrites apps/site/dist/ and apps/api/dist-worker/, which `bun run preview`
# serves.
echo "pre-push 4/4: site and Worker build"
bun run --silent build

echo "pre-push: all gates green"
