#!/bin/sh
# Mirrors the CI "checks" job (everything except the site build).
set -e

echo "pre-push 1/8: format"
bun run --silent check-format

echo "pre-push 2/8: spelling"
command -v typos >/dev/null || { echo "typos is not installed: brew install typos-cli"; exit 1; }
typos

echo "pre-push 3/8: lint"
bun run --silent lint

echo "pre-push 4/8: unused files, exports and dependencies"
bun run --silent knip

echo "pre-push 5/8: astro check"
bun run --silent check:astro

echo "pre-push 6/8: src typecheck"
bun run --silent check:src

echo "pre-push 7/8: worker typecheck"
bun run --silent check:worker

echo "pre-push 8/8: unit tests"
bun run --silent test

echo "pre-push: all gates green"
