{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "schedule:weekly"],
  "packageRules": [
    {
      "matchPackageNames": ["typescript", "@astrojs/ts-content-mapper"],
      "groupName": "typescript content mapper"
    },
    {
      "description": "Insiders build for tailwindlabs/prettier-plugin-tailwindcss#473 (prettier-plugin-astro 1). Allow only a stable release above 0.8.1, which lacks it.",
      "matchPackageNames": ["prettier-plugin-tailwindcss"],
      "allowedVersions": ">0.8.1"
    },
    {
      "matchPackageNames": ["astro", "@astrojs/compiler-rs"],
      "groupName": "astro compiler"
    },
    {
      "matchPackageNames": ["ai", "@ai-sdk/*"],
      "groupName": "ai sdk"
    },
    {
      "matchPackageNames": ["vite-plus", "@voidzero-dev/vite-plus-core", "vitest", "@vitest/*"],
      "groupName": "vite-plus"
    }
  ]
}
