# Agent discovery (RFC 8288 Link relations): point machine clients at the
# site's machine-readable descriptions from the page response itself.
# /about is the canonical entity page (rel=author from the homepage);
# service-desc is the OpenAPI document, service-doc the developer portal, and
# api-catalog the RFC 9727 linkset naming every API this site publishes.
/
  Link: </llms.txt>; rel="describedby"; type="text/plain", </index.md>; rel="alternate"; type="text/markdown", </about/>; rel="author", </blog/rss.xml>; rel="alternate"; type="application/rss+xml", </openapi.json>; rel="service-desc"; type="application/json", </developers/>; rel="service-doc"; type="text/html", </.well-known/api-catalog>; rel="api-catalog"; type="application/linkset+json"

/about/
  Link: </llms.txt>; rel="describedby"; type="text/plain", </about/index.md>; rel="alternate"; type="text/markdown", </openapi.json>; rel="service-desc"; type="application/json", </developers/>; rel="service-doc"; type="text/html", </.well-known/api-catalog>; rel="api-catalog"; type="application/linkset+json"

/developers/
  Link: </openapi.json>; rel="service-desc"; type="application/json", </AGENTS.md>; rel="describedby"; type="text/markdown", </llms.txt>; rel="describedby"; type="text/plain", </.well-known/api-catalog>; rel="api-catalog"; type="application/linkset+json", </api/versions>; rel="version-history"; type="application/json"

# Agent instructions. Served as markdown (the assets layer would otherwise
# guess from the extension) and short-cached so a wording change lands fast.
/AGENTS.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600
  Link: </openapi.json>; rel="service-desc"; type="application/json", </developers/>; rel="service-doc"; type="text/html", </.well-known/api-catalog>; rel="api-catalog"; type="application/linkset+json"

/llms.txt
  Cache-Control: public, max-age=3600
  Link: </openapi.json>; rel="service-desc"; type="application/json", </developers/>; rel="service-doc"; type="text/html", </.well-known/api-catalog>; rel="api-catalog"; type="application/linkset+json"

# Markdown renditions (scripts/generate-markdown.mjs). A zone Transform Rule
# rewrites Accept: text/markdown page requests to these files, so their body
# is served under the page URL — Vary tells caches that URL depends on Accept.
/index.md
  Vary: Accept
/blog/index.md
  Vary: Accept
/blog/:slug/index.md
  Vary: Accept

