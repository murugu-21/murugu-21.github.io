/static/*
  Cache-Control: public, max-age=31536000, immutable

/blog/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Agent discovery (RFC 8288 Link relations): point machine clients at the
# site's machine-readable descriptions from the page response itself.
# /about is the canonical entity page (rel=author from the homepage).
/
  Link: </llms.txt>; rel="describedby"; type="text/plain", </index.md>; rel="alternate"; type="text/markdown", </about/>; rel="author", </blog/rss.xml>; rel="alternate"; type="application/rss+xml"

/about/
  Link: </llms.txt>; rel="describedby"; type="text/plain", </about/index.md>; rel="alternate"; type="text/markdown"

# Markdown renditions (scripts/generate-markdown.mjs). A zone Transform Rule
# rewrites Accept: text/markdown page requests to these files, so their body
# is served under the page URL — Vary tells caches that URL depends on Accept.
/index.md
  Vary: Accept
/blog/index.md
  Vary: Accept
/blog/:slug/index.md
  Vary: Accept

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
