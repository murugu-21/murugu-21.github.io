{
  "name": "murugappan-dev",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "scripts": {
    "dev": "astro dev",
    "dev:all": "concurrently -n site,worker -c blue,yellow \"astro dev\" \"wrangler dev --port 8787\"",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write \"src/**/*.{astro,ts,scss}\" \"worker/**/*.ts\" \"*.{ts,jsonc}\"",
    "check-format": "prettier --check \"src/**/*.{astro,ts,scss}\" \"worker/**/*.ts\" \"*.{ts,jsonc}\"",
    "build:blog": "npm --prefix blog run build",
    "build:site": "npm run build && npm run build:blog && rm -rf dist/blog && cp -R blog/dist/. dist/blog/ && node scripts/merge-sitemap.mjs && node scripts/merge-llms.mjs && node scripts/generate-resume.mjs",
    "test": "vitest run",
    "check:worker": "tsc -p worker"
  },
  "dependencies": {
    "astro": "^5.0.0",
    "lottie-web": "^5.12.2",
    "nanoid": "^6.0.1",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/vitest-pool-workers": "^0.21.1",
    "@cloudflare/workers-types": "^5.20260812.1",
    "@types/node": "^25.9.2",
    "concurrently": "^10.0.1",
    "fontaine": "^0.8.0",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.0.0",
    "prettier-plugin-astro": "^0.14.0",
    "puppeteer": "^25.6.0",
    "sass": "^1.69.0",
    "sharp": "^0.33.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.121.0"
  }
}
