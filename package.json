{
  "name": "murugappan-dev",
  "private": true,
  "license": "MIT",
  "type": "module",
  "version": "2.0.0",
  "packageManager": "bun@1.4.2",
  "imports": {
    "#src/*": "./src/*",
    "#worker/*": "./worker/*",
    "#utils/*": "./utils/*",
    "#contracts/*": "./contracts/*",
    "#scripts/*": "./scripts/*"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev --local-upstream localhost:8787",
    "format": "oxfmt src worker contracts scripts utils content vitest.config.ts wrangler.jsonc astro.config.ts commitlint.config.ts oxlint.config.ts eslint.config.ts && prettier --write \"src/**/*.astro\"",
    "check-format": "oxfmt src worker contracts scripts utils content vitest.config.ts wrangler.jsonc astro.config.ts commitlint.config.ts oxlint.config.ts eslint.config.ts --check && prettier --check \"src/**/*.astro\"",
    "lint": "astro sync && oxlint src worker contracts scripts utils vitest.config.ts astro.config.ts commitlint.config.ts oxlint.config.ts eslint.config.ts && bun run lint:eslint src",
    "lint:eslint": "node --require ./scripts/site/ts-alias.cjs node_modules/.bin/eslint",
    "lint:fix": "astro sync && oxlint src worker contracts scripts utils vitest.config.ts astro.config.ts commitlint.config.ts oxlint.config.ts eslint.config.ts --fix && bun run lint:eslint src --fix",
    "knip": "knip",
    "db:migrate": "wrangler d1 migrations apply jarvis-chats --remote",
    "db:migrate:local": "wrangler d1 migrations apply jarvis-chats --local",
    "deploy": "bun run db:migrate && wrangler deploy",
    "test": "vitest run",
    "test:live": "vitest run --project workers --tags-filter=live",
    "check:src": "astro sync && node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit --runExternalCode",
    "check:worker": "node node_modules/typescript/bin/tsc -p worker",
    "prepare": "git config core.hooksPath .githooks",
    "diagrams": "bun scripts/site/render-mermaid.ts",
    "audio": "bun scripts/site/generate-audio.ts",
    "audio:align": "bun scripts/site/align-audio.ts",
    "types": "wrangler types --strict-vars=false"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "3.0.59",
    "@ai-sdk/react": "4.0.131",
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/react": "^7.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@cloudflare/ai-chat": "0.12.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-slider": "^1.5.0",
    "@radix-ui/react-slot": "^1.4.0",
    "agents": "0.26.0",
    "ai": "7.0.128",
    "astro": "^7.3.8",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "hono": "^4.13.13",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.53.0",
    "markdown-it": "^15.0.2",
    "mdast-util-from-markdown": "^2.1.0",
    "medium-zoom": "^1.1.0",
    "nanoid": "^6.0.2",
    "posthog-js": "^1.438.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "sanitize-html": "^2.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/ts-content-mapper": "0.2.0",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@eslint/css": "^2.0.0",
    "@mermaid-js/mermaid-cli": "^12.0.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@posthog/rollup-plugin": "^1.6.1",
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@typescript-eslint/parser": "^8.71.1",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-istanbul": "5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-better-tailwindcss": "^4.9.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "fast-check": "^4.10.2",
    "firacode": "6.2.0",
    "jiti": "^2.7.0",
    "knip": "^6.40.0",
    "linkedom": "^0.18.13",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tailwindcss": "^1.14.0",
    "oxlint-tsgolint": "^7.0.2003",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "puppeteer": "^25.13.0",
    "schema-dts": "^2.1.0",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "subset-font": "^2.9.0",
    "tailwind-csstree": "^0.4.1",
    "tailwindcss": "^4.3.3",
    "typescript": "7.1.0-dev.20261007.1",
    "vfile": "^6.0.3",
    "vitest": "^5.0.3",
    "vitest-browser-react": "^2.3.0",
    "webmcp-types": "^0.1.10",
    "wrangler": "^4.149.0"
  },
  "lint-staged": {
    "*.{js,mjs,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,jsonc,md}": "oxfmt",
    "*.css": [
      "bun run lint:eslint --fix",
      "oxfmt"
    ],
    "*.astro": [
      "bun run lint:eslint --fix",
      "prettier --write"
    ]
  }
}
