{
  "name": "murugappan-dev",
  "private": true,
  "license": "MIT",
  "type": "module",
  "version": "2.0.0",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "astro dev",
    "build": "bun --bun astro build",
    "preview": "astro preview",
    "format": "oxfmt src worker scripts vitest.config.ts wrangler.jsonc astro.config.ts && prettier --write \"src/**/*.astro\" \"content/**/*.md\"",
    "check-format": "oxfmt src worker scripts vitest.config.ts wrangler.jsonc astro.config.ts --check && prettier --check \"src/**/*.astro\" \"content/**/*.md\"",
    "lint": "oxlint src worker scripts vitest.config.ts astro.config.ts",
    "lint:fix": "oxlint src worker scripts vitest.config.ts astro.config.ts --fix",
    "db:migrate": "wrangler d1 migrations apply jarvis-chats --remote",
    "db:migrate:local": "wrangler d1 migrations apply jarvis-chats --local",
    "deploy": "bun run db:migrate && wrangler deploy",
    "test": "bun --bun vitest run",
    "test:capture": "bun scripts/live-test-capture.ts",
    "check:astro": "bun --preload ./scripts/ts-alias.cjs node_modules/.bin/astro check",
    "check:src": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "check:worker": "node node_modules/typescript/bin/tsc -p worker",
    "prepare": "git config core.hooksPath .githooks",
    "diagrams": "bun scripts/render-mermaid.ts",
    "audio": "bun scripts/generate-audio.ts",
    "audio:align": "bun scripts/align-audio.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "https://pkg.pr.new/@astrojs/cloudflare@3448767",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/react": "^7.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "astro": "^7.3.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "hono": "^4.13.12",
    "hono-party": "^2.1.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.49.0",
    "markdown-it": "^15.0.2",
    "mdast-util-from-markdown": "^2.0.3",
    "medium-zoom": "^1.1.0",
    "nanoid": "^6.0.1",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "posthog-js": "^1.435.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "sanitize-html": "^2.18.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/vitest-plugin": "^1.3.5",
    "@cloudflare/workers-types": "^5.20261002.1",
    "@posthog/rollup-plugin": "^1.6.1",
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@typescript/typescript6": "^6.0.2",
    "linkedom": "^0.18.13",
    "lint-staged": "^17.6.0",
    "mermaid": "^12.0.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "puppeteer": "^25.12.0",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vfile": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.146.0"
  },
  "overrides": {
    "@cloudflare/workers-types": "^5.20260812.1",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,mjs,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,jsonc,css}": "oxfmt",
    "*.{astro,md}": "prettier --write --ignore-unknown"
  }
}
