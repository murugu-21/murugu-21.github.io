{
  "name": "murugappan-dev",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "scripts": {
    "dev": "astro dev",
    "dev:all": "concurrently -n site,worker -c blue,yellow \"astro dev\" \"wrangler dev --port 8787\"",
    "build": "astro build",
    "preview": "astro preview",
    "format": "oxfmt src worker scripts vitest.config.ts wrangler.jsonc astro.config.mjs && prettier --write \"src/**/*.astro\" \"content/**/*.md\"",
    "check-format": "oxfmt src worker scripts vitest.config.ts wrangler.jsonc astro.config.mjs --check && prettier --check \"src/**/*.astro\" \"content/**/*.md\"",
    "lint": "oxlint src worker scripts vitest.config.ts astro.config.mjs",
    "lint:fix": "oxlint src worker scripts vitest.config.ts astro.config.mjs --fix",
    "build:site": "npm run build && node scripts/generate-markdown.mjs && node scripts/generate-resume.mjs",
    "db:migrate": "wrangler d1 migrations apply jarvis-chats --remote",
    "db:migrate:local": "wrangler d1 migrations apply jarvis-chats --local",
    "deploy": "npm run db:migrate && wrangler deploy",
    "test": "vitest run",
    "check:worker": "tsc -p worker",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/react": "^6.0.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/merriweather": "^5.1.0",
    "@fontsource/montserrat": "^5.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slot": "^1.3.3",
    "astro": "^7.2.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.3",
    "hono-party": "^2.1.0",
    "lottie-web": "^5.12.2",
    "lucide-react": "^1.31.0",
    "markdown-it": "^14.1.0",
    "medium-zoom": "^1.1.0",
    "mermaid": "^11.15.0",
    "nanoid": "^6.0.1",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "prismjs": "^1.28.0",
    "prop-types": "^15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-toggle": "^4.1.2",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "sanitize-html": "^2.13.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@cloudflare/workers-types": "^5.20260812.1",
    "@sparticuz/chromium": "^149.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "concurrently": "^10.0.1",
    "fontaine": "^0.8.0",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.3.0",
    "prettier-plugin-astro": "^0.14.1",
    "puppeteer": "^25.6.0",
    "sass": "^1.69.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.121.0"
  },
  "overrides": {
    "hono-party": {
      "@cloudflare/workers-types": "$@cloudflare/workers-types"
    }
  },
  "lint-staged": {
    "*.{js,mjs,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,jsonc,css,scss}": "oxfmt",
    "*.{astro,md}": "prettier --write --ignore-unknown"
  }
}
