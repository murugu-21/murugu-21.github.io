{
  "name": "murugappan-dev",
  "private": true,
  "license": "MIT",
  "type": "module",
  "version": "2.0.0",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "imports": {
    "#worker/*": "./worker/*"
  },
  "scripts": {
    "dev": "vp run @murugappan/site#dev",
    "build": "vp run @murugappan/site#build && vp build",
    "preview": "wrangler dev --local-upstream localhost:8787",
    "format": "vp fmt apps packages scripts worker vitest.config.ts vite.config.ts wrangler.jsonc commitlint.config.ts lint.config.ts eslint.config.ts && prettier --write \"apps/site/src/**/*.astro\" && bun run --silent py ruff format apps/site/scripts/tts",
    "check-format": "vp fmt apps packages scripts worker vitest.config.ts vite.config.ts wrangler.jsonc commitlint.config.ts lint.config.ts eslint.config.ts --check && prettier --check \"apps/site/src/**/*.astro\" && bun run --silent py ruff format --check apps/site/scripts/tts",
    "lint": "astro sync --root apps/site && vp lint apps packages scripts worker vitest.config.ts vite.config.ts commitlint.config.ts lint.config.ts eslint.config.ts && bun run lint:eslint apps/site/src && bun run lint:py",
    "lint:py": "bun run --silent py ruff check apps/site/scripts/tts",
    "lint:eslint": "node --require ./scripts/lint/ts-alias.cjs node_modules/.bin/eslint",
    "lint:fix": "astro sync --root apps/site && vp lint apps packages scripts worker vitest.config.ts vite.config.ts commitlint.config.ts lint.config.ts eslint.config.ts --fix && bun run lint:eslint apps/site/src --fix && bun run lint:py --fix",
    "knip": "knip",
    "db:migrate": "wrangler d1 migrations apply jarvis-chats --remote",
    "db:migrate:local": "wrangler d1 migrations apply jarvis-chats --local",
    "deploy": "bun run db:migrate && wrangler deploy",
    "test": "vp test",
    "test:live": "vp test --project workers --tags-filter=live",
    "check:src": "astro sync --root apps/site && node node_modules/typescript/bin/tsc -p apps/site --noEmit --runExternalCode && node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "check:worker": "node node_modules/typescript/bin/tsc -p worker",
    "check:py": "bun run --silent py basedpyright -p apps/site/scripts/tts",
    "prepare": "git config core.hooksPath .githooks",
    "diagrams": "vp run @murugappan/site#diagrams",
    "audio": "vp run @murugappan/site#audio",
    "audio:align": "vp run @murugappan/site#audio:align",
    "types": "wrangler types --strict-vars=false",
    "py": "uv run --locked --project apps/site/scripts/tts"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "3.0.59",
    "@ai-sdk/react": "4.0.131",
    "@astrojs/markdown-remark": "^7.3.2",
    "@cloudflare/ai-chat": "0.12.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@murugappan/content": "workspace:*",
    "@murugappan/contracts": "workspace:*",
    "@murugappan/utils": "workspace:*",
    "agents": "0.26.0",
    "ai": "7.0.128",
    "astro": "^7.3.8",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@eslint/css": "^2.0.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@typescript-eslint/parser": "^8.71.1",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-istanbul": "5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-better-tailwindcss": "^4.9.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "fast-check": "^4.10.2",
    "jiti": "^2.7.0",
    "knip": "^6.40.0",
    "oxlint-tailwindcss": "^1.14.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "tailwind-csstree": "^0.4.1",
    "tailwindcss": "^4.3.3",
    "typescript": "7.1.0-dev.20261007.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "vitest": "5.0.3",
    "wrangler": "^4.149.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vitest": "5.0.3"
  }
}
