{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // The husky plugin parses any hook script; ours live in .githooks (core.hooksPath).
      "husky": { "config": [".githooks/*"] }
    },
    "apps/site": {
      // Files loaded by path, which no plugin parses: the client directive and the resume
      // script in astro.config.ts, and the banner renderer run by hand.
      "entry": [
        "src/directives/interaction.ts",
        "scripts/generate-resume.ts",
        "brand/render-x-cover.ts"
      ],
      // Served by URL.
      "ignore": ["public/**"]
    },
    "packages/*": {}
  },
  "ignoreDependencies": [
    // Required by name inside tooling/ts-alias.cjs.
    "@typescript/typescript6",
    // The workerd `cloudflare:workers` and `cloudflare:test` modules, not the npm package.
    "cloudflare"
  ],
  // System tools: apps/tts/cli.ts spawns ffmpeg, and the py script runs uv
  // (installed with brew, README.md › Checks).
  "ignoreBinaries": ["ffmpeg", "uv"]
}
