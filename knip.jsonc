{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // The husky plugin parses any hook script; ours live in .githooks (core.hooksPath).
      "husky": { "config": [".githooks/*"] }
    },
    "apps/site": {
      // Files loaded by path, which no plugin parses: the client directive and the resume
      // script in astro.config.ts.
      "entry": ["src/directives/interaction.ts", "scripts/generate-resume.ts"],
      // Served by URL.
      "ignore": ["public/**"]
    },
    "apps/api": {
      // The tsconfig plugin name that @effect/tsgo (a root dependency) reads, not a package.
      "ignoreDependencies": ["@effect/language-service"]
    },
    "apps/brand": {
      // x-cover.html loads its font from node_modules by path.
      "ignoreDependencies": ["firacode"]
    },
    "packages/*": {},
    "tooling": {
      // Oxlint loads the vendored plugins by path from lint.config.ts.
      "entry": ["oxlint/anti-slop/index.ts", "oxlint/anti-slop/effect.ts"]
    }
  },
  "ignoreDependencies": [
    // The workerd `cloudflare:workers` and `cloudflare:test` modules, not the npm package.
    "cloudflare"
  ],
  // System tools: apps/tts/cli.ts spawns ffmpeg, and the py script runs uv
  // (installed with brew, README.md › Tests and checks).
  "ignoreBinaries": ["ffmpeg", "uv"]
}
