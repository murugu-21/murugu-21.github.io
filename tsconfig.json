{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "scripts/**/*",
    "utils/**/*",
    "contracts/**/*",
    "astro.config.ts",
    "commitlint.config.ts",
    "oxlint.config.ts",
    "eslint.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
